-/// Surface.keyCallback: the surface holding the keyboard gets the key first.
-/// Keys its focused element has no use for go to the program as usual.
-/// The press decides, and its release goes where the press went, so a
-/// program that asked for event types never hears a release without its
-/// press, nor a press without its release.
+/// Surface.keyCallback: the surface holding the keyboard gets the key first,
+/// named from the bytes the program would read for it (SPEC §10.4): Ghostty's
+/// own encoding, in the modes the program set, so a key is what a TUI would
+/// see, whatever the keyboard layout or remapping made of it. Keys its
+/// focused element has no use for go to the program as usual. The press
+/// decides, and its release goes where the press went, so a program that
+/// asked for event types never hears a release without its press, nor a
+/// press without its release.
 pub fn surfaceKey(s: *Surface, event: input.KeyEvent) bool {
     if (s.readonly) return false;
     const hs = &s.io.terminal_stream.handler.hotty;
+    // Encoding takes the renderer lock itself.
+    var buf: [1024]u8 = undefined;
+    const bytes = if (event.action == .release or !holdsKeyboard(s)) "" else encodeKey(s, event, &buf);
     var drew = false;
     const consumed = consumed: {
         s.renderer_state.mutex.lockUncancelable(global.io());
@@ -1471,7 +1481,7 @@ pub fn surfaceKey(s: *Surface, event: input.KeyEvent) bool {
             hs.held_keys.remove(event.key);
             break :consumed held;
         }
-        const used = surfaceKeyPress(hs, &s.io.terminal, event);
+        const used = hs.keyBytes(&s.io.terminal, bytes);
         hs.held_keys.setPresent(event.key, used);
         drew = hs.drew;
         hs.drew = false;
@@ -1481,33 +1491,39 @@ pub fn surfaceKey(s: *Surface, event: input.KeyEvent) bool {
     return consumed;
 }
 
-/// A press or a repeat, for the surface holding the keyboard if any. True
-/// if it used it.
-fn surfaceKeyPress(hs: *Hotty, t: *terminal.Terminal, event: input.KeyEvent) bool {
-    if (!hs.hasKeyboard()) return false;
-    const code: u32 = switch (event.key) {
-        .enter, .numpad_enter => 1,
-        .tab => 2,
-        .backspace => 3,
-        .delete => 4,
-        .escape => 5,
-        .arrow_left => 6,
-        .arrow_right => 7,
-        .arrow_up => 8,
-        .arrow_down => 9,
-        .home => 10,
-        .end => 11,
-        .page_up => 12,
-        .page_down => 13,
-        .space => 14,
-        else => 0,
+/// Surface.performBindingAction: what a binding writes to the pty (`text:`,
+/// `csi:`, `esc:`, `cursor_key`) goes to the surface holding the keyboard
+/// first, as the keys the program would read in it (SPEC §10.4). Ghostty's
+/// macOS Cmd+Left writes 0x01, which a field's keymap reads as Control+a.
+/// True if the surface used any of it: the binding then writes nothing, and
+/// the keys it did not use reach the program as replies.
+pub fn surfaceBindingBytes(s: *Surface, bytes: []const u8) bool {
+    if (s.readonly) return false;
+    var drew = false;
+    const used = used: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const hs = &s.io.terminal_stream.handler.hotty;
+        const used = hs.keyBytes(&s.io.terminal, bytes);
+        drew = hs.drew;
+        hs.drew = false;
+        break :used used;
     };
-    var text_buf: [64]u8 = undefined;
-    const text: ?[*:0]const u8 = if (code == 0 and event.utf8.len > 0 and event.utf8.len < text_buf.len)
-        (std.fmt.bufPrintZ(&text_buf, "{s}", .{event.utf8}) catch return false).ptr
-    else if (code == 0)
-        return false
-    else
-        null;
-    return hs.key(t, code, text, hostMods(event.mods));
+    deliver(s, used or drew);
+    return used;
+}
+
+fn holdsKeyboard(s: *Surface) bool {
+    s.renderer_state.mutex.lockUncancelable(global.io());
+    defer s.renderer_state.mutex.unlock(global.io());
+    return s.io.terminal_stream.handler.hotty.hasKeyboard();
+}
+
+/// What Ghostty writes to the pty for `event`, in `buf`: empty for nothing,
+/// or for more than `buf` holds (an input method's long commit, which then
+/// goes to the program).
+fn encodeKey(s: *Surface, event: input.KeyEvent, buf: []u8) []const u8 {
+    var w: std.Io.Writer = .fixed(buf);
+    input.key_encode.encode(&w, event, s.encodeKeyOpts()) catch return "";
+    return w.buffered();
 }
