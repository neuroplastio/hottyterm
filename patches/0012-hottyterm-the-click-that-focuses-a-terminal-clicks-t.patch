     hotty_link_click: configpkg.Config.HottyLinkClick,
+    hotty_focus_click: configpkg.Config.HottyFocusClick,
     link_previews: configpkg.LinkPreviews,
     scroll_to_bottom: configpkg.Config.ScrollToBottom,
     notify_on_command_finish: configpkg.Config.NotifyOnCommandFinish,
@@ -427,6 +428,7 @@ const DerivedConfig = struct {
             .links = links,
             .link_osc8 = config.@"link-osc8",
             .hotty_link_click = config.@"hotty-link-click",
+            .hotty_focus_click = config.@"hotty-focus-click",
             .link_previews = config.@"link-previews",
             .scroll_to_bottom = config.@"scroll-to-bottom",
             .notify_on_command_finish = config.@"notify-on-command-finish",
diff --git a/src/apprt/gtk/class/surface.zig b/src/apprt/gtk/class/surface.zig
index 6a2403556..8b0faeb47 100644
--- a/src/apprt/gtk/class/surface.zig
+++ b/src/apprt/gtk/class/surface.zig
@@ -2862,7 +2862,7 @@ pub const Surface = extern struct {
 
         // If this click is only transitioning split focus, suppress it so
         // it doesn't get forwarded to the terminal as a mouse event.
-        if (!had_focus and button == .left) {
+        if (!had_focus and button == .left and core_surface.config.hotty_focus_click == .focus) {
             priv.suppress_left_mouse_release = true;
             return;
         }
diff --git a/src/config/Config.zig b/src/config/Config.zig
index c23a5f28c..d8e86d43c 100644
--- a/src/config/Config.zig
+++ b/src/config/Config.zig
@@ -3959,6 +3959,16 @@ term: []const u8 = "xterm-ghostty",
 ///   * `modifier` - only a click with Ctrl (Cmd on macOS) held opens it.
 @"hotty-link-click": HottyLinkClick = .plain,
 
+// hottyterm: what the click that focuses a terminal does.
+/// What a click does when it gives a terminal focus: the first click on a
+/// window in the background, or on a split that does not have focus.
+///
+///   * `pass` - it focuses and clicks, as in a browser: the click also
+///     reaches what is under it, a HOTTY surface, a link, or the program as
+///     a mouse event.
+///   * `focus` - it only focuses; the program hears nothing of it.
+@"hotty-focus-click": HottyFocusClick = .pass,
+
 /// Configures the low-level API to use for async IO, eventing, etc.
 ///
 /// Most users should leave this set to `auto`. This will automatically detect
@@ -5576,6 +5586,7 @@ pub const WindowSubtitle = enum {
 
 // hottyterm: `hotty-link-click`.
 pub const HottyLinkClick = enum { plain, modifier };
+pub const HottyFocusClick = enum { pass, focus };
 
 pub const LinkPreviews = enum {
     false,
