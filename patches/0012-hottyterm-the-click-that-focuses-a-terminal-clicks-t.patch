From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HOTTY Agent <hotty@neuroplast.io>
Date: Thu, 8 Oct 2026 17:34:32 +0200
Subject: [PATCH 12/25] hottyterm: the click that focuses a terminal clicks too
 (hotty-focus-click)

Ghostty drops the click that gives a terminal focus: on macOS the view
declines first mouse and eats the click that moves split focus (issue
2595), and GTK suppresses the left press and release of a terminal
without focus. `hotty-focus-click = pass`, the default, lets it through,
as a browser does: it reaches a HOTTY surface, a link, or the program as
a mouse event. `focus` is Ghostty's behaviour.

Upstream lines: Config.zig 11 (the option and its enum), Surface.zig 2
(the config field and its init), GTK surface.zig 1 (the condition), and
on macOS Ghostty.Config.swift 10 (the setting) and
SurfaceView_AppKit.swift 10 (acceptsFirstMouse, the derived config, the
split-focus condition).
---
 macos/Sources/Ghostty/Ghostty.Config.swift            | 10 ++++++++++
 .../Ghostty/Surface View/SurfaceView_AppKit.swift     | 11 ++++++++++-
 src/Surface.zig                                       |  2 ++
 src/apprt/gtk/class/surface.zig                       |  2 +-
 src/config/Config.zig                                 | 11 +++++++++++
 5 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/macos/Sources/Ghostty/Ghostty.Config.swift b/macos/Sources/Ghostty/Ghostty.Config.swift
index 78cc9024d..bd244fdf0 100644
--- a/macos/Sources/Ghostty/Ghostty.Config.swift
+++ b/macos/Sources/Ghostty/Ghostty.Config.swift
@@ -351,6 +351,16 @@ extension Ghostty {
             return MacOSWindowButtons(rawValue: str) ?? defaultValue
         }
 
+        // hottyterm: `hotty-focus-click = pass`, the default.
+        var hottyFocusClickPasses: Bool {
+            guard let config = self.config else { return true }
+            var v: UnsafePointer<Int8>?
+            let key = "hotty-focus-click"
+            guard ghostty_config_get(config, &v, key, UInt(key.lengthOfBytes(using: .utf8))) else { return true }
+            guard let ptr = v else { return true }
+            return String(cString: ptr) != "focus"
+        }
+
         var macosTitlebarStyle: MacOSTitlebarStyle {
             let defaultValue = MacOSTitlebarStyle.transparent
             guard let config = self.config else { return defaultValue }
diff --git a/macos/Sources/Ghostty/Surface View/SurfaceView_AppKit.swift b/macos/Sources/Ghostty/Surface View/SurfaceView_AppKit.swift
index f77985f7e..36ad8f100 100644
--- a/macos/Sources/Ghostty/Surface View/SurfaceView_AppKit.swift	
+++ b/macos/Sources/Ghostty/Surface View/SurfaceView_AppKit.swift	
@@ -692,7 +692,7 @@ extension Ghostty {
             // If our window/app is already focused, then this click is only
             // being used to transfer split focus. Consume it so it does not
             // get forwarded to the terminal as a mouse click.
-            if NSApp.isActive && window.isKeyWindow {
+            if NSApp.isActive && window.isKeyWindow && !derivedConfig.hottyFocusClickPasses {
                 window.makeFirstResponder(self)
                 suppressNextLeftMouseUp = true
                 return nil
@@ -900,6 +900,12 @@ extension Ghostty {
             setSurfaceSize(width: UInt32(scaledSize.width), height: UInt32(scaledSize.height))
         }
 
+        // hottyterm: with `hotty-focus-click = pass` the click that brings the
+        // window forward reaches the terminal too.
+        override func acceptsFirstMouse(for event: NSEvent?) -> Bool {
+            derivedConfig.hottyFocusClickPasses
+        }
+
         override func mouseDown(with event: NSEvent) {
             guard let surface = self.surface else { return }
             let mods = Ghostty.ghosttyMods(event.modifierFlags)
@@ -1835,6 +1841,7 @@ extension Ghostty {
             let windowTitleFontFamily: String?
             let windowAppearance: NSAppearance?
             let scrollbar: Ghostty.Config.Scrollbar
+            let hottyFocusClickPasses: Bool
 
             init() {
                 self.backgroundColor = Color(NSColor.windowBackgroundColor)
@@ -1844,6 +1851,7 @@ extension Ghostty {
                 self.windowTitleFontFamily = nil
                 self.windowAppearance = nil
                 self.scrollbar = .system
+                self.hottyFocusClickPasses = true
             }
 
             init(_ config: Ghostty.Config) {
@@ -1854,6 +1862,7 @@ extension Ghostty {
                 self.windowTitleFontFamily = config.windowTitleFontFamily
                 self.windowAppearance = .init(ghosttyConfig: config)
                 self.scrollbar = config.scrollbar
+                self.hottyFocusClickPasses = config.hottyFocusClickPasses
             }
         }
 
diff --git a/src/Surface.zig b/src/Surface.zig
index 2745ad3ac..74e0c1865 100644
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -345,6 +345,7 @@ const DerivedConfig = struct {
     links: []DerivedConfig.Link,
