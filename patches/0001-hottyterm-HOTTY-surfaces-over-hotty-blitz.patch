diff --git a/src/termio/hotty.zig b/src/termio/hotty.zig
new file mode 100644
index 000000000..483a51530
--- /dev/null
+++ b/src/termio/hotty.zig
@@ -0,0 +1,1180 @@
+//! hottyterm: HOTTY surfaces (HTML over the TTY), rendered by the terminal.
+//!
+//! A program sends HOTTY commands on OSC 7279 (SPEC.md in neuroplastio/hotty).
+//! Ghostty hands the stream handler every OSC it does not implement, as an
+//! `osc_unknown` action, once `osc_unknown_max_bytes` is set; this file takes
+//! the 7279 ones. The documents live in hotty-blitz, a Rust library behind a C
+//! ABI (crates/hotty-blitz/include/hotty_blitz.h in neuroplastio/hotty-blitz).
+//!
+//! Each surface is a kitty image in its screen's image storage, placed at the
+//! cursor, so it scrolls, clears and dies with its screen exactly like any
+//! kitty image. Changes arrive as kitty frame edits (`a=f`, `r=1`) of only the
+//! damaged rectangles, the way the polyfill sends them to a terminal. When the
+//! cell size changes, every surface re-renders at the new size without the
+//! program's help.
+//!
+//! All of hottyterm's logic is here. Upstream files only call in: Termio
+//! (settings, the stream option, flush, resize), the stream handler (the OSC
+//! and full reset) and Surface (keys and the pointer). This file reaches into
+//! Ghostty's internals where it has to, so an upstream change shows up as a
+//! compile error here instead of a rebase conflict.
+//!
+//! Everything runs on the IO thread with the terminal lock held, like the rest
+//! of the stream handler, except the Surface entry points, which take the lock.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const global = @import("../global.zig");
+const terminal = @import("../terminal/main.zig");
+const configpkg = @import("../config.zig");
+const input = @import("../input.zig");
+const apprt = @import("../apprt.zig");
+const rendererpkg = @import("../renderer.zig");
+const termio = @import("../termio.zig");
+const Surface = @import("../Surface.zig");
+const internal_os = @import("../os/main.zig");
+const font = @import("../font/main.zig");
+const kitty = terminal.kitty;
+
+const log = std.log.scoped(.hotty);
+
+// --- hotty-blitz C ABI -----------------------------------------------------
+
+pub const Host = opaque {};
+
+pub const Config = extern struct {
+    cell_w: u32,
+    cell_h: u32,
+    scale: f32,
+    fg: u32,
+    bg: u32,
+    palette: [16]u32,
+    dark: bool,
+    font_family: ?[*:0]const u8,
+    /// The root font size in CSS px; 0 lets hotty-blitz derive it.
+    font_size: f32,
+};
+
+pub const Effects = extern struct {
+    ctx: ?*anyopaque,
+    reply: ?*const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void,
+    /// (surface, cols, rows, window x, y, w, h, z, created, move_cursor)
+    place: ?*const fn (?*anyopaque, [*:0]const u8, u16, u16, u16, u16, u16, u16, i32, u32, bool) callconv(.c) void,
+    remove: ?*const fn (?*anyopaque, [*:0]const u8) callconv(.c) void,
+    hide: ?*const fn (?*anyopaque, [*:0]const u8) callconv(.c) void,
+};
+
+pub const Rect = extern struct { x: u32, y: u32, w: u32, h: u32 };
+
+/// (ctx, surface, w, h, premultiplied rgba of the whole frame, stride, damaged
+/// rects, count, full): only the rects changed; copy just those.
+const FrameFn = *const fn (?*anyopaque, [*:0]const u8, u32, u32, [*]const u8, usize, [*]const Rect, usize, bool) callconv(.c) void;
+
+extern fn hotty_host_new(cfg: *const Config) ?*Host;
+extern fn hotty_host_free(h: *Host) void;
+extern fn hotty_host_configure(h: *Host, cfg: *const Config) void;
+extern fn hotty_host_osc(h: *Host, body: [*]const u8, len: usize, fx: *const Effects) void;
+extern fn hotty_host_has_dirty(h: *const Host) bool;
+extern fn hotty_host_redeliver(h: *Host, surface: [*:0]const u8) void;
+extern fn hotty_host_render(h: *Host, ctx: ?*anyopaque, cb: FrameFn) void;
+extern fn hotty_host_reset(h: *Host, fx: ?*const Effects) void;
+extern fn hotty_host_pointer(h: *Host, surface: [*:0]const u8, kind: u32, x: f32, y: f32, mods: u32, fx: *const Effects) void;
+extern fn hotty_host_key(h: *Host, key: u32, text: ?[*:0]const u8, mods: u32, fx: *const Effects) bool;
+extern fn hotty_host_blur(h: *Host, surface: [*:0]const u8, fx: *const Effects) void;
+extern fn hotty_host_focused(h: *Host) ?[*:0]const u8;
+extern fn hotty_host_cursor(h: *Host, surface: [*:0]const u8) ?[*:0]const u8;
+extern fn hotty_host_hyperlink(h: *Host, surface: [*:0]const u8) ?[*:0]const u8;
+
+// --- wiring ------------------------------------------------------------------
+
+/// The longest OSC the stream keeps for us: one HOTTY chunk (4096 payload
+/// bytes, SPEC §3.4) and a generous control. Longer ones are dropped.
+pub const max_osc_bytes = 8192;
+
+const osc_prefix = "7279;";
+
+/// Surfaces get kitty image ids from here up ("HOT\x00"), clear of the ids
+/// programs pick and of Ghostty's implicit ones in the upper half.
+const id_base: u32 = 0x484F_5400;
+
+/// What hottyterm takes from the terminal's configuration. Lives in
+/// Termio's DerivedConfig, so it is allocated in that config's arena.
+pub const Settings = struct {
+    font_family: [:0]const u8 = "",
+
+    pub fn init(alloc: Allocator, config: *const configpkg.Config) Allocator.Error!Settings {
+        const families = config.@"font-family".list.items;
+        return .{
+            .font_family = try alloc.dupeZ(u8, if (families.len > 0) families[0] else ""),
+        };
+    }
+};
+
+/// A CSS px, as a browser defines it: one logical pixel. `scale` (device px
+/// per CSS px, SPEC §2) is the display's content scale, a browser's
+/// devicePixelRatio: 2 on a Retina Mac, 1 on a 1x Linux display, 1.25 on
+/// one scaled to 125%. It is the one Ghostty sizes the font with: the DPI
+/// it loads the font at over the platform's base (`font.face.default_dpi`:
+/// 72 on macOS, where a point is a logical pixel, 96 elsewhere).
+/// `font_size` is the terminal's font in CSS px, the root font size of the
+/// host stylesheet (SPEC §8). `override` (HOTTY_SCALE) replaces the scale;
+/// the font stays the size it is on screen.
+const CssPx = struct { scale: f32, font_size: f32 };
+
+fn cssPx(size: font.face.DesiredSize, base_dpi: f32, override: ?f32) CssPx {
+    const dpi: f32 = @floatFromInt(@max(size.ydpi, 1));
+    const scale = @max(override orelse dpi / base_dpi, 0.5);
+    return .{ .scale = scale, .font_size = size.pixels() / scale };
+}
+
+test cssPx {
+    const t = std.testing;
+    // A Retina Mac, font-size = 14: 144 dpi on macOS's 72, so 2 device px
+    // per CSS px, and the root font is 14px. (The old guess from the cell
+    // height, 34 / (14 * 4/3 * 1.25), made it 1.46.)
+    const mac = cssPx(.{ .points = 14, .xdpi = 144, .ydpi = 144 }, 72, null);
+    try t.expectEqual(@as(f32, 2), mac.scale);
+    try t.expectApproxEqAbs(@as(f32, 14), mac.font_size, 0.001);
+    // A 1x Linux display: 96 dpi, a CSS px is a device px, and 14pt is
+    // 18.67px, as before.
+    const linux = cssPx(.{ .points = 14, .xdpi = 96, .ydpi = 96 }, 96, null);
+    try t.expectEqual(@as(f32, 1), linux.scale);
+    try t.expectApproxEqAbs(@as(f32, 18.667), linux.font_size, 0.001);
+    // Scaled to 125%: 120 dpi, the font as large in CSS px as at 1x.
+    const scaled = cssPx(.{ .points = 14, .xdpi = 120, .ydpi = 120 }, 96, null);
+    try t.expectEqual(@as(f32, 1.25), scaled.scale);
+    try t.expectApproxEqAbs(@as(f32, 18.667), scaled.font_size, 0.001);
+    // HOTTY_SCALE wins, and the font keeps its device size.
+    const forced = cssPx(.{ .points = 14, .xdpi = 144, .ydpi = 144 }, 72, 1);
+    try t.expectEqual(@as(f32, 1), forced.scale);
+    try t.expectApproxEqAbs(@as(f32, 28), forced.font_size, 0.001);
+    // Nothing below half a device px per CSS px.
+    try t.expectEqual(@as(f32, 0.5), cssPx(.{ .points = 14 }, 96, 0.1).scale);
+}
+
+pub const PointerKind = enum(u32) { move = 0, down = 1, up = 2, leave = 3 };
+
+/// A kitty display command (`a=p`): the graphics module does not export it.
+const KittyDisplay = @FieldType(kitty.graphics.Command.Control, "display");
+
+/// The part of a surface a placement shows, in cells (SPEC §5.2).
+const Window = struct { x: u16, y: u16, w: u16, h: u16 };
+
+/// One placed surface, as the terminal sees it: its image, the whole
+/// surface, the window of it on screen, and its place in the stack.
+const Placed = struct {
+    image_id: u32,
+    cols: u16,
+    rows: u16,
+    win: Window,
+    z: i32,
+    created: u32,
+    /// Hidden (SPEC §5.4): no placement, and the image kept to show again.
+    hidden: bool = false,
+    /// The screen whose image storage holds it.
+    screen: terminal.ScreenSet.Key,
+};
+
+pub const Hotty = struct {
+    alloc: Allocator,
+    settings: Settings = .{},
+    host: ?*Host = null,
+    /// Surface name (owned) → its image.
+    placed: std.StringHashMapUnmanaged(Placed) = .empty,
+    next_id: u32 = id_base,
+    cell_w: u32 = 0,
+    cell_h: u32 = 0,
+    /// The size Ghostty loads the terminal's font at: points, and the DPI
+    /// that holds the display's content scale (Surface.font_size). The
+    /// Surface sets it (`surfaceFont`); a resize follows every change.
+    font_size: font.face.DesiredSize = .{ .points = 12 },
+
+    // Collected while one call into the host runs.
+    replies: std.ArrayListUnmanaged(u8) = .empty,
+    places: std.ArrayListUnmanaged(Place) = .empty,
+    removes: std.ArrayListUnmanaged([]u8) = .empty,
+    hides: std.ArrayListUnmanaged([]u8) = .empty,
+
+    /// The surface under the pointer, so leaving it clears its hover state.
+    hover: [72]u8 = undefined,
+    hover_len: usize = 0,
+    /// The pointer's shape the document under it asks for (CSS `cursor`),
+    /// null off the surfaces; and the one last shown, null for the
+    /// terminal's own.
+    shape: ?terminal.MouseShape = null,
+    shown_shape: ?terminal.MouseShape = null,
+    /// The surface a press landed on: until the release the pointer is its,
+    /// as in a browser, so a drag out of it keeps selecting and the release
+    /// reaches it.
+    capture: [72]u8 = undefined,
+    capture_len: usize = 0,
+    /// A press on the cells holds the pointer for the program until its
+    /// last button is released (`programHolds`): every event of the
+    /// gesture is the program's, even over a surface, so a drag that starts
+    /// on cells (a divider between two surfaces, say) reaches it whole.
+    /// Only the Surface entry points touch it, on the apprt thread.
+    program_hold: bool = false,
+    /// A pointer event or a key drew a frame: the renderer must show it,
+    /// whether or not a surface took the event (a leave repaints too).
+    drew: bool = false,
+    /// The hyperlink under the pointer (SPEC §9: a link with
+    /// target="_blank"), owned: it is the terminal's, as an OSC 8 one is.
+    link: ?[:0]u8 = null,
+    /// The address in the link preview, owned; null for none.
+    shown_url: ?[:0]u8 = null,
+    /// A press on a hyperlink with the OSC 8 gesture: it and its release
+    /// are the terminal's, never the surface's.
+    link_press: bool = false,
+
+    const Place = struct {
+        surface: [:0]u8,
+        cols: u16,
+        rows: u16,
+        win: Window,
+        /// The stack (SPEC §5.2): z, then the order the surfaces were
+        /// created in.
+        z: i32,
+        created: u32,
+        move_cursor: bool,
+        /// Shown at once from the image the terminal has: no frame needed.
+        shown: bool = false,
+    };
+
+    pub fn deinit(self: *Hotty) void {
+        if (self.host) |h| hotty_host_free(h);
+        self.host = null;
+        self.setLink(null);
+        if (self.shown_url) |o| self.alloc.free(o);
+        self.shown_url = null;
+        var it = self.placed.keyIterator();
+        while (it.next()) |k| self.alloc.free(k.*);
+        self.placed.deinit(self.alloc);
+        self.replies.deinit(self.alloc);
+        self.clearPlaces();
+        self.places.deinit(self.alloc);
+        self.clearRemoves();
+        self.removes.deinit(self.alloc);
+        self.clearHides();
+        self.hides.deinit(self.alloc);
+    }
+
+    fn clearPlaces(self: *Hotty) void {
+        for (self.places.items) |p| self.alloc.free(p.surface);
+        self.places.clearRetainingCapacity();
+    }
+
+    fn clearRemoves(self: *Hotty) void {
+        for (self.removes.items) |r| self.alloc.free(r);
+        self.removes.clearRetainingCapacity();
+    }
+
+    fn clearHides(self: *Hotty) void {
+        for (self.hides.items) |r| self.alloc.free(r);
+        self.hides.clearRetainingCapacity();
+    }
+
+    fn effects(self: *Hotty) Effects {
+        return .{ .ctx = self, .reply = onReply, .place = onPlace, .remove = onRemove, .hide = onHide };
+    }
+
+    fn onReply(ctx: ?*anyopaque, data: [*]const u8, len: usize) callconv(.c) void {
+        const self: *Hotty = @ptrCast(@alignCast(ctx.?));
+        self.replies.appendSlice(self.alloc, data[0..len]) catch
+            log.warn("hotty: reply dropped, out of memory", .{});
+    }
+
+    fn onPlace(ctx: ?*anyopaque, surface: [*:0]const u8, cols: u16, rows: u16, x: u16, y: u16, w: u16, h: u16, z: i32, created: u32, move_cursor: bool) callconv(.c) void {
+        const self: *Hotty = @ptrCast(@alignCast(ctx.?));
+        const name = self.alloc.dupeZ(u8, std.mem.span(surface)) catch return;
+        self.places.append(self.alloc, .{
+            .surface = name,
+            .cols = cols,
+            .rows = rows,
+            .win = .{ .x = x, .y = y, .w = w, .h = h },
+            .z = z,
+            .created = created,
+            .move_cursor = move_cursor,
+        }) catch self.alloc.free(name);
+    }
+
+    fn onHide(ctx: ?*anyopaque, surface: [*:0]const u8) callconv(.c) void {
+        const self: *Hotty = @ptrCast(@alignCast(ctx.?));
+        const name = self.alloc.dupe(u8, std.mem.span(surface)) catch return;
+        self.hides.append(self.alloc, name) catch self.alloc.free(name);
+    }
+
+    fn onRemove(ctx: ?*anyopaque, surface: [*:0]const u8) callconv(.c) void {
+        const self: *Hotty = @ptrCast(@alignCast(ctx.?));
+        const name = self.alloc.dupe(u8, std.mem.span(surface)) catch return;
+        self.removes.append(self.alloc, name) catch self.alloc.free(name);
+    }
+
+    fn rgb(c: ?terminal.color.RGB, fallback: u32) u32 {
+        const v = c orelse return fallback;
+        return (@as(u32, v.r) << 16) | (@as(u32, v.g) << 8) | v.b;
+    }
+
+    fn config(self: *Hotty, t: *terminal.Terminal) Config {
+        const cell_w: u32 = if (t.cols > 0) t.width_px / t.cols else 10;
+        const cell_h: u32 = if (t.rows > 0) t.height_px / t.rows else 21;
+        self.cell_w = cell_w;
+        self.cell_h = cell_h;
+        const fg = rgb(t.colors.foreground.get(), 0xffffff);
+        const bg = rgb(t.colors.background.get(), 0x000000);
+        var palette: [16]u32 = undefined;
+        for (&palette, 0..) |*p, i| p.* = rgb(t.colors.palette.current[i], 0);
+        const r: f32 = @floatFromInt((bg >> 16) & 0xff);
+        const g: f32 = @floatFromInt((bg >> 8) & 0xff);
+        const b: f32 = @floatFromInt(bg & 0xff);
+        const override: ?f32 = if (std.posix.system.getenv("HOTTY_SCALE")) |s|
+            std.fmt.parseFloat(f32, std.mem.span(s)) catch null
+        else
+            null;
+        const css = cssPx(self.font_size, font.face.default_dpi, override);
+        return .{
+            .cell_w = cell_w,
+            .cell_h = cell_h,
+            .scale = css.scale,
+            .fg = fg,
+            .bg = bg,
+            .palette = palette,
+            .dark = 0.2126 * r + 0.7152 * g + 0.0722 * b < 128,
+            .font_family = if (self.settings.font_family.len > 0) self.settings.font_family.ptr else null,
+            .font_size = css.font_size,
+        };
+    }
+
+    fn ensureHost(self: *Hotty, t: *terminal.Terminal) ?*Host {
+        if (self.host) |h| return h;
+        const cfg = self.config(t);
+        self.host = hotty_host_new(&cfg);
+        if (self.host == null) log.warn("hotty-blitz failed to start", .{});
+        return self.host;
+    }
+
+    // --- from the stream handler ---------------------------------------------
+
+    /// The stream handler's `osc_unknown` action: OSC 7279 is ours, and the
+    /// rest stays ignored as upstream ignores it. `handler` is the
+    /// StreamHandler (anytype, because it imports this file).
+    pub fn osc(self: *Hotty, handler: anytype, value: terminal.osc.Command.Unknown) !void {
+        if (!std.mem.startsWith(u8, value.content, osc_prefix)) return;
+        if (value.truncated) {
+            log.warn("HOTTY command over {} bytes dropped", .{max_osc_bytes});
+            return;
+        }
+        const t: *terminal.Terminal = handler.terminal;
+        const h = self.ensureHost(t) orelse return;
+        const body = value.content[osc_prefix.len..];
+        const fx = self.effects();
+        hotty_host_osc(h, body.ptr, body.len, &fx);
+        self.apply(t);
+        if (self.replies.items.len > 0) {
+            defer self.replies.clearRetainingCapacity();
+            // What the handler's (private) messageWriter does.
+            handler.termio_mailbox.send(try termio.Message.writeReq(self.alloc, self.replies.items), handler.renderer_state.mutex);
+            handler.termio_messaged = true;
+        }
+        try handler.queueRender();
+    }
+
+    /// Full reset (RIS): every surface goes (SPEC §5.4). The terminal has
+    /// already cleared the image storage.
+    pub fn reset(self: *Hotty) void {
+        const h = self.host orelse return;
+        hotty_host_reset(h, null);
+        var it = self.placed.keyIterator();
+        while (it.next()) |k| self.alloc.free(k.*);
+        self.placed.clearRetainingCapacity();
+        self.hover_len = 0;
+        self.capture_len = 0;
+        self.setLink(null);
+    }
+
+    /// Carries out what the host asked for: deletions, then placements (which
+    /// need their first frame now, at the cursor where the command arrived).
+    fn apply(self: *Hotty, t: *terminal.Terminal) void {
+        for (self.removes.items) |name| {
+            if (self.placed.fetchRemove(name)) |kv| {
+                self.deleteImage(t, kv.value);
+                self.alloc.free(kv.key);
+            }
+        }
+        self.clearRemoves();
+        // Hidden: the placement goes, the image stays for the next place.
+        for (self.hides.items) |name| {
+            if (self.placed.getPtr(name)) |p| {
+                self.deletePlacement(t, p.*);
+                p.hidden = true;
+            }
+        }
+        self.clearHides();
+        // A surface placed again at its size shows the image the terminal
+        // has, with the new window: a move or a scroll sends no pixels. Any
+        // other waits for its frame, which the host is asked for.
+        var pending = false;
+        for (self.places.items) |*p| {
+            p.shown = self.show(t, p.*);
+            if (p.shown) continue;
+            pending = true;
+            if (self.host) |h| hotty_host_redeliver(h, p.surface.ptr);
+        }
+        if (pending) _ = self.render(t);
+        self.clearPlaces();
+    }
+
+    fn deleteImage(self: *Hotty, t: *terminal.Terminal, p: Placed) void {
+        const screen = t.screens.get(p.screen) orelse return;
+        screen.kitty_images.delete(global.io(), self.alloc, t, .{ .id = .{ .image_id = p.image_id, .delete = true } });
+    }
+
+    fn deletePlacement(self: *Hotty, t: *terminal.Terminal, p: Placed) void {
+        const screen = t.screens.get(p.screen) orelse return;
+        screen.kitty_images.delete(global.io(), self.alloc, t, .{ .id = .{ .image_id = p.image_id, .delete = false } });
+    }
+
+    /// Shows a placed or hidden surface again from its image, if the
+    /// terminal still has it at the surface's size. False if it needs pixels.
+    fn show(self: *Hotty, t: *terminal.Terminal, p: Place) bool {
+        const e = self.placed.getPtr(p.surface) orelse return false;
+        if (e.cols != p.cols or e.rows != p.rows or e.screen != t.screens.active_key) return false;
+        const screen = t.screens.get(e.screen) orelse return false;
+        if (!screen.kitty_images.images.contains(e.image_id)) return false;
+        var cmd: kitty.graphics.Command = .{
+            .control = .{ .display = self.display(e.image_id, p) },
+            .quiet = .ok,
+        };
+        if (!self.exec(t, &cmd)) return false;
+        e.win = p.win;
+        e.z = p.z;
+        e.created = p.created;
+        e.hidden = false;
+        if (p.move_cursor) moveCursor(t, p.win.h);
+        return true;
+    }
+
+    /// The kitty display of `p`'s window of image `id`, at the cursor: the
+    /// window is the image's source rectangle, over the window's cells,
+    /// stacked by the placement's z and the surface's creation.
+    fn display(self: *Hotty, id: u32, p: Place) KittyDisplay {
+        return .{
+            .image_id = id,
+            .placement_id = 1,
+            .x = @as(u32, p.win.x) * self.cell_w,
+            .y = @as(u32, p.win.y) * self.cell_h,
+            .width = @as(u32, p.win.w) * self.cell_w,
+            .height = @as(u32, p.win.h) * self.cell_h,
+            .columns = p.win.w,
+            .rows = p.win.h,
+            .z = stackZ(p.z, p.created),
+            .cursor_movement = .none,
+        };
+    }
+
+    /// The kitty z of a placement (SPEC §5.2): its z, from -1000 to 1000,
+    /// then the order its surface was created in, all above the text (a
+    /// kitty z of 0 or more). Creation wraps after a million surfaces.
+    fn stackZ(z: i32, created: u32) i32 {
+        const band: i32 = std.math.clamp(z, -1000, 1000) + 1000;
+        return (band << 20) | @as(i32, @intCast(created & 0xFFFFF));
+    }
+
+    /// The cursor goes to the start of the line below a placement `rows`
+    /// tall, scrolling as needed (the polyfill does the same).
+    fn moveCursor(t: *terminal.Terminal, rows: u16) void {
+        var i: usize = 0;
+        while (i < rows) : (i += 1) t.index() catch break;
+        t.carriageReturn();
+    }
+
+    /// Renders what changed. Termio calls it once per batch of output, not
+    /// once per command.
+    pub fn flush(self: *Hotty, t: *terminal.Terminal) void {
+        const h = self.host orelse return;
+        self.prune(t);
+        if (t.modes.get(.synchronized_output)) return;
+        if (!hotty_host_has_dirty(h)) return;
+        _ = self.render(t);
+    }
+
+    /// Forgets placements whose image is gone: scrolled out of the
+    /// scrollback, erased, or left behind on the alternate screen. The
+    /// document stays, so the program can place it again (SPEC §5.4),
+    /// except when the terminal left the alternate screen the surface was
+    /// placed on: then the surface goes with it. An erase on the alternate
+    /// screen (a full-screen program repainting) only takes the placement.
+    fn prune(self: *Hotty, t: *terminal.Terminal) void {
+        const Gone = struct { name: []const u8, left_alt: bool };
+        var gone: [16]Gone = undefined;
+        var n: usize = 0;
+        var it = self.placed.iterator();
+        while (it.next()) |e| {
+            const p = e.value_ptr.*;
+            const left_alt = p.screen == .alternate and t.screens.active_key != .alternate;
+            const alive = if (t.screens.get(p.screen)) |s| s.kitty_images.images.contains(p.image_id) else false;
+            if (alive and !left_alt) continue;
+            gone[n] = .{ .name = e.key_ptr.*, .left_alt = left_alt };
+            n += 1;
+            if (n == gone.len) break;
+        }
+        for (gone[0..n]) |g| {
+            const kv = self.placed.fetchRemove(g.name) orelse continue;
+            defer self.alloc.free(kv.key);
+            if (!g.left_alt) continue;
+            self.deleteImage(t, kv.value);
+            self.deleteSurface(kv.key);
+        }
+    }
+
+    /// Deletes a surface's document, as the program's `a=del:s=` would.
+    fn deleteSurface(self: *Hotty, name: []const u8) void {
+        const h = self.host orelse return;
+        var buf: [128]u8 = undefined;
+        const body = std.fmt.bufPrint(&buf, "a=del:s={s}", .{name}) catch return;
+        const fx = self.effects();
+        hotty_host_osc(h, body.ptr, body.len, &fx);
+        self.replies.clearRetainingCapacity();
+        self.clearRemoves();
+    }
+
+    /// The cell size (font size, zoom) changed: every surface re-renders at
+    /// the new size, crisp, and replaces its pixels in place.
+    pub fn resized(self: *Hotty, t: *terminal.Terminal) void {
+        const h = self.host orelse return;
+        const cfg = self.config(t);
+        hotty_host_configure(h, &cfg);
+        _ = self.render(t);
+    }
+
+    // --- rendering -----------------------------------------------------------
+
+    const RenderCtx = struct { self: *Hotty, t: *terminal.Terminal, drew: bool = false };
+
+    /// Renders the dirty surfaces into their images. True if a frame went
+    /// out, for the renderer to draw.
+    fn render(self: *Hotty, t: *terminal.Terminal) bool {
+        const h = self.host orelse return false;
+        var ctx: RenderCtx = .{ .self = self, .t = t };
+        hotty_host_render(h, &ctx, onFrame);
+        return ctx.drew;
+    }
+
+    fn onFrame(
+        ctx_ptr: ?*anyopaque,
+        surface: [*:0]const u8,
+        w: u32,
+        h: u32,
+        rgba: [*]const u8,
+        stride: usize,
+        rects: [*]const Rect,
+        nrects: usize,
+        full: bool,
+    ) callconv(.c) void {
+        const ctx: *RenderCtx = @ptrCast(@alignCast(ctx_ptr.?));
+        ctx.drew = true;
+        const self = ctx.self;
+        const t = ctx.t;
+        const name = std.mem.span(surface);
+        const frame = rgba[0 .. stride * h];
+
+        // A new placement: transmit and display at the cursor.
+        for (self.places.items) |p| {
+            if (p.shown or !std.mem.eql(u8, p.surface, name)) continue;
+            const data = straight(self.alloc, frame, stride, .{ .x = 0, .y = 0, .w = w, .h = h }) catch return;
+            defer self.alloc.free(data);
+            self.place(t, name, p, w, h, data) catch |err| log.warn("hotty place failed: {}", .{err});
+            return;
+        }
+
+        const placed = self.placed.get(name) orelse return;
+        const screen = t.screens.get(placed.screen) orelse return;
+        const storage = &screen.kitty_images;
+        const img = storage.images.getPtr(placed.image_id) orelse return;
+
+        // An update of the same size on the active screen: kitty frame edits
+        // of the damaged rectangles only.
+        if (!full and img.width == w and img.height == h and placed.screen == t.screens.active_key) {
+            if (self.edit(t, placed.image_id, frame, stride, rects[0..nrects])) return;
+        }
+
+        // Everything changed, the size did, or the screen is not showing:
+        // replace the pixels whole, keeping the placement.
+        const data = straight(self.alloc, frame, stride, .{ .x = 0, .y = 0, .w = w, .h = h }) catch return;
+        defer self.alloc.free(data);
+        replaceImage(self.alloc, storage, img, w, h, data) catch |err|
+            log.warn("hotty: surface {s} not updated: {}", .{ name, err });
+    }
+
+    /// Writes each rectangle with an `a=f` edit of the image's first frame.
+    /// False if one failed: the caller then replaces the image whole.
+    fn edit(self: *Hotty, t: *terminal.Terminal, id: u32, frame: []const u8, stride: usize, rects: []const Rect) bool {
+        for (rects) |r| {
+            if (r.w == 0 or r.h == 0) continue;
+            const data = straight(self.alloc, frame, stride, r) catch return false;
+            defer self.alloc.free(data);
+            var cmd: kitty.graphics.Command = .{
+                .control = .{ .transmit_animation_frame = .{
+                    .transmission = .{
+                        .format = .rgba,
+                        .medium = .direct,
+                        .width = r.w,
+                        .height = r.h,
+                        .image_id = id,
+                    },
+                    .x = r.x,
+                    .y = r.y,
+                    .edit_frame = 1,
+                    .composition_mode = .overwrite,
+                } },
+                .quiet = .ok,
+                .data = data,
+            };
+            if (!self.exec(t, &cmd)) return false;
+        }
+        return true;
+    }
+
+    /// Runs a kitty graphics command built in memory on the active screen.
+    /// True unless the terminal reported a failure.
+    fn exec(self: *Hotty, t: *terminal.Terminal, cmd: *kitty.graphics.Command) bool {
+        // A program's own chunked upload may be in progress; our command
+        // must not become one of its chunks.
+        const storage = &t.screens.active.kitty_images;
+        const loading = storage.loading;
+        storage.loading = null;
+        defer storage.loading = loading;
+        // With `q=1`, only failures come back.
+        const resp = t.kittyGraphics(global.io(), self.alloc, cmd) orelse return true;
+        log.warn("hotty: kitty graphics: {s}", .{resp.message});
+        return false;
+    }
+
+    /// Replaces an image's pixels, possibly at a new size, keeping its
+    /// placements. The kitty protocol cannot do this: sending an image id
+    /// again deletes its placements.
+    fn replaceImage(alloc: Allocator, storage: *kitty.graphics.ImageStorage, img: *kitty.graphics.Image, w: u32, h: u32, data: []const u8) !void {
+        if (img.animation) |anim| if (anim.frames.items.len > 0) return error.Animated;
+        const old_len = img.data.len();
+        if (storage.total_bytes - old_len + data.len > storage.total_limit) return error.StorageFull;
+        const copy = try alloc.dupe(u8, data);
+        img.data.deinit(alloc);
+        img.data = .{ .complete = copy };
+        img.width = w;
+        img.height = h;
+        img.format = .rgba;
+        img.compression = .none;
+        storage.total_bytes = storage.total_bytes - old_len + data.len;
+        storage.markImageContentChanged(global.io(), img);
+    }
+
+    /// A tightly packed straight-alpha copy of rectangle `r` of a
+    /// premultiplied frame.
+    fn straight(alloc: Allocator, frame: []const u8, stride: usize, r: Rect) ![]u8 {
+        const row_len = @as(usize, r.w) * 4;
+        const out = try alloc.alloc(u8, row_len * r.h);
+        var y: usize = 0;
+        while (y < r.h) : (y += 1) {
+            const s_row = frame[(r.y + y) * stride + @as(usize, r.x) * 4 ..][0..row_len];
+            const d_row = out[y * row_len ..][0..row_len];
+            var i: usize = 0;
+            while (i < s_row.len) : (i += 4) {
+                const a = s_row[i + 3];
+                if (a == 255 or a == 0) {
+                    @memcpy(d_row[i .. i + 4], s_row[i .. i + 4]);
+                } else {
+                    const af: u32 = a;
+                    inline for (0..3) |c| {
+                        d_row[i + c] = @intCast(@min(255, (@as(u32, s_row[i + c]) * 255 + af / 2) / af));
+                    }
+                    d_row[i + 3] = a;
+                }
+            }
+        }
+        return out;
+    }
+
+    fn place(self: *Hotty, t: *terminal.Terminal, name: []const u8, p: Place, w: u32, h: u32, data: []const u8) !void {
+        // One image per placement: a surface placed again moves.
+        if (self.placed.fetchRemove(name)) |kv| {
+            self.deleteImage(t, kv.value);
+            self.alloc.free(kv.key);
+        }
+        const id = self.next_id;
+        self.next_id = if (self.next_id >= id_base + 0xff) id_base else self.next_id + 1;
+
+        var cmd: kitty.graphics.Command = .{
+            .control = .{ .transmit_and_display = .{
+                .transmission = .{
+                    .format = .rgba,
+                    .medium = .direct,
+                    .width = w,
+                    .height = h,
+                    .image_id = id,
+                    .placement_id = 1,
+                },
+                .display = self.display(id, p),
+            } },
+            .quiet = .ok,
+            .data = data,
+        };
+        if (!self.exec(t, &cmd)) return error.PlaceFailed;
+        const owned = try self.alloc.dupe(u8, name);
+        errdefer self.alloc.free(owned);
+        try self.placed.put(self.alloc, owned, .{
+            .image_id = id,
+            .cols = p.cols,
+            .rows = p.rows,
+            .win = p.win,
+            .z = p.z,
+            .created = p.created,
+            .screen = t.screens.active_key,
+        });
+        if (p.move_cursor) moveCursor(t, p.win.h);
+    }
+
+    // --- input --------------------------------------------------------------
+
+    const Target = struct { name: []const u8, x: f32, y: f32 };
+
+    /// Where a placed surface's window is on the viewport, in pixels, and
+    /// where the window starts in the surface. Null when it is not on the
+    /// active screen.
+    fn onScreen(self: *Hotty, t: *terminal.Terminal, p: Placed) ?struct { x0: f64, y0: f64, w: f64, h: f64, dx: f64, dy: f64 } {
+        if (p.screen != t.screens.active_key) return null;
+        const screen = t.screens.active;
+        const pkey: kitty.graphics.ImageStorage.PlacementKey = .{
+            .image_id = p.image_id,
+            .placement_id = .{ .tag = .external, .id = 1 },
+        };
+        const placement = screen.kitty_images.placements.get(pkey) orelse return null;
+        const pin = switch (placement.location) {
+            .pin => |pin| pin,
+            else => return null,
+        };
+        const vp = screen.pages.pointFromPin(.viewport, pin.*) orelse return null;
+        return .{
+            .x0 = @floatFromInt(@as(u32, vp.viewport.x) * self.cell_w),
+            .y0 = @floatFromInt(@as(u32, vp.viewport.y) * self.cell_h),
+            .w = @floatFromInt(@as(u32, p.win.w) * self.cell_w),
+            .h = @floatFromInt(@as(u32, p.win.h) * self.cell_h),
+            .dx = @floatFromInt(@as(u32, p.win.x) * self.cell_w),
+            .dy = @floatFromInt(@as(u32, p.win.y) * self.cell_h),
+        };
+    }
+
+    /// The surface under viewport pixel (`px`, `py`), the topmost where
+    /// placements overlap (SPEC §5.2), and the pixel inside it, found from
+    /// the active screen's kitty placements.
+    fn hit(self: *Hotty, t: *terminal.Terminal, px: f64, py: f64) ?Target {
+        if (self.cell_w == 0 or self.cell_h == 0) return null;
+        var top: ?Target = null;
+        var top_z: i32 = std.math.minInt(i32);
+        var it = self.placed.iterator();
+        while (it.next()) |e| {
+            const p = e.value_ptr.*;
+            const b = self.onScreen(t, p) orelse continue;
+            const z = stackZ(p.z, p.created);
+            if (px >= b.x0 and px < b.x0 + b.w and py >= b.y0 and py < b.y0 + b.h and (top == null or z > top_z)) {
+                // The placement shows the window; the surface's pixel is
+                // offset by where the window starts.
+                top = .{ .name = e.key_ptr.*, .x = @floatCast(px - b.x0 + b.dx), .y = @floatCast(py - b.y0 + b.dy) };
+                top_z = z;
+            }
+        }
+        return top;
+    }
+
+    /// Viewport pixel (`px`, `py`) in surface `name`, inside it or not.
+    fn at(self: *Hotty, t: *terminal.Terminal, name: []const u8, px: f64, py: f64) ?Target {
+        if (self.cell_w == 0 or self.cell_h == 0) return null;
+        const e = self.placed.getEntry(name) orelse return null;
+        if (e.value_ptr.hidden) return null;
+        const b = self.onScreen(t, e.value_ptr.*) orelse return null;
+        return .{ .name = e.key_ptr.*, .x = @floatCast(px - b.x0 + b.dx), .y = @floatCast(py - b.y0 + b.dy) };
+    }
+
+    /// A pointer event at viewport pixel (`px`, `py`). True if a surface took
+    /// it; replies for the program stay in `replies`.
+    fn pointer(self: *Hotty, t: *terminal.Terminal, kind: PointerKind, px: f64, py: f64, mods: u32) bool {
+        self.shape = null;
+        self.setLink(null);
+        const h = self.host orelse return false;
+        if (self.placed.count() == 0) {
+            self.capture_len = 0;
+            return false;
+        }
+        // While a press on the cells holds the pointer, the program gets
+        // every event, and no surface is hovered. A press then is one on
+        // the cells: it takes the keyboard back (SPEC §10.1).
+        if (self.program_hold) {
+            const fx = self.effects();
+            if (self.hover_len > 0) {
+                var buf: [73]u8 = undefined;
+                const old = std.fmt.bufPrintZ(&buf, "{s}", .{self.hover[0..self.hover_len]}) catch "";
+                hotty_host_pointer(h, old.ptr, @intFromEnum(PointerKind.leave), 0, 0, mods, &fx);
+                self.hover_len = 0;
+            }
+            if (kind == .down) {
+                if (hotty_host_focused(h)) |name| hotty_host_blur(h, name, &fx);
+            }
+            if (self.render(t)) self.drew = true;
+            return false;
+        }
+        // While a press holds the pointer, its surface gets every event.
+        const held: ?Target = if (self.capture_len > 0) self.at(t, self.capture[0..self.capture_len], px, py) else null;
+        if (self.capture_len > 0 and held == null) self.capture_len = 0; // it went away
+        const target = held orelse self.hit(t, px, py);
+        const fx = self.effects();
+
+        // Leaving a surface (or moving onto another) clears its hover.
+        const over: []const u8 = if (target) |tg| tg.name else "";
+        if (self.hover_len > 0 and !std.mem.eql(u8, self.hover[0..self.hover_len], over)) {
+            var buf: [73]u8 = undefined;
+            const old = std.fmt.bufPrintZ(&buf, "{s}", .{self.hover[0..self.hover_len]}) catch "";
+            hotty_host_pointer(h, old.ptr, @intFromEnum(PointerKind.leave), 0, 0, mods, &fx);
+            self.hover_len = 0;
+        }
+        if (target) |tg| {
+            if (tg.name.len <= self.hover.len) {
+                @memcpy(self.hover[0..tg.name.len], tg.name);
+                self.hover_len = tg.name.len;
+            }
+            var name_buf: [73]u8 = undefined;
+            const name = std.fmt.bufPrintZ(&name_buf, "{s}", .{tg.name}) catch return false;
+            hotty_host_pointer(h, name.ptr, @intFromEnum(kind), tg.x, tg.y, mods, &fx);
+            const css = hotty_host_cursor(h, name.ptr);
+            self.shape = if (css) |c| terminal.MouseShape.fromString(std.mem.span(c)) orelse .default else .default;
+            self.setLink(if (hotty_host_hyperlink(h, name.ptr)) |u| std.mem.span(u) else null);
+            switch (kind) {
+                .down => if (tg.name.len <= self.capture.len) {
+                    @memcpy(self.capture[0..tg.name.len], tg.name);
+                    self.capture_len = tg.name.len;
+                },
+                .up => {
+                    self.capture_len = 0;
+                    // Released outside it: the pointer has left it.
+                    const now = self.hit(t, px, py);
+                    if (now == null or !std.mem.eql(u8, now.?.name, tg.name)) {
+                        hotty_host_pointer(h, name.ptr, @intFromEnum(PointerKind.leave), 0, 0, mods, &fx);
+                        self.hover_len = 0;
+                        self.shape = null;
+                    }
+                },
+                else => {},
+            }
+        } else if (kind == .down) {
+            // A click outside every surface takes the keyboard back.
+            if (hotty_host_focused(h)) |name| hotty_host_blur(h, name, &fx);
+        }
+        if (self.render(t)) self.drew = true;
+        return target != null;
+    }
+
+    /// A key for the surface holding the keyboard. True if it used it.
+    fn key(self: *Hotty, t: *terminal.Terminal, code: u32, text: ?[*:0]const u8, mods: u32) bool {
+        const h = self.host orelse return false;
+        const fx = self.effects();
+        const consumed = hotty_host_key(h, code, text, mods, &fx);
+        if (self.render(t)) self.drew = true;
+        return consumed;
+    }
+
+    fn setLink(self: *Hotty, url: ?[]const u8) void {
+        if (self.link) |old| {
+            if (url != null and std.mem.eql(u8, old, url.?)) return;
+            self.alloc.free(old);
+        }
+        self.link = if (url) |u| self.alloc.dupeZ(u8, u) catch null else null;
+    }
+
+    /// The pointer's shape to show, when it changed since the last call (or
+    /// always, with `force`): over a hyperlink, what the terminal shows
+    /// over an OSC 8 one (a pointer with the gesture's keys held, text
+    /// without); else the surface's; else the terminal's own (`own`).
+    fn shapeChange(self: *Hotty, own: terminal.MouseShape, osc8: bool, force: bool) ?terminal.MouseShape {
+        const want: ?terminal.MouseShape = if (self.link != null)
+            (if (osc8) .pointer else .text)
+        else
+            self.shape;
+        if (!force and std.meta.eql(want, self.shown_shape)) return null;
+        self.shown_shape = want;
+        return want orelse own;
+    }
+
+    /// The link preview to show, when it changed (or always, with `force`):
+    /// the hyperlink's address, or "" to clear it.
+    fn previewChange(self: *Hotty, visible: bool, force: bool) ?[:0]const u8 {
+        const url: ?[:0]u8 = if (visible) self.link else null;
+        const same = if (url) |u|
+            (if (self.shown_url) |o| std.mem.eql(u8, u, o) else false)
+        else
+            self.shown_url == null;
+        if (!force and same) return null;
+        if (self.shown_url) |o| self.alloc.free(o);
+        self.shown_url = if (url) |u| self.alloc.dupeZ(u8, u) catch null else null;
+        return if (url) |u| u else "";
+    }
+
+    fn hasKeyboard(self: *Hotty) bool {
+        const h = self.host orelse return false;
+        return hotty_host_focused(h) != null;
+    }
+};
+
+// --- from Surface ------------------------------------------------------------
+
+fn hostMods(mods: input.Mods) u32 {
+    var m: u32 = 0;
+    if (mods.shift) m |= 1;
+    if (mods.ctrl) m |= 2;
+    if (mods.alt) m |= 4;
+    if (mods.super) m |= 8;
+    return m;
+}
+
+/// Sends what the surfaces replied to the program, and redraws when a
+/// surface took the event or drew a frame.
+fn deliver(s: *Surface, redraw: bool) void {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    if (hs.replies.items.len > 0) {
+        defer hs.replies.clearRetainingCapacity();
+        // Surface.queueIo drops writes in readonly mode; so do we.
+        if (!s.readonly) {
+            if (termio.Message.writeReq(s.alloc, hs.replies.items)) |msg| {
+                s.io.queueMessage(msg, .unlocked);
+            } else |_| {}
+        }
+    }
+    if (redraw) s.renderer_thread.wakeup.notify() catch {};
+}
+
+fn pointerAt(s: *Surface, kind: PointerKind, pos: apprt.CursorPos, mods: input.Mods) bool {
+    const coord: rendererpkg.Coordinate = .{ .surface = .{ .x = pos.x, .y = pos.y } };
+    const tp = coord.convert(.terminal, s.size).terminal;
+    const osc8 = osc8Gesture(s, mods);
+    var shape: ?terminal.MouseShape = null;
+    var preview: ?[:0]u8 = null;
+    defer if (preview) |p| s.alloc.free(p);
+    var open: ?[]u8 = null;
+    defer if (open) |u| s.alloc.free(u);
+    var drew = false;
+    const took = took: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const hs = &s.io.terminal_stream.handler.hotty;
+        // A hyperlink (SPEC §9) is the terminal's: with the OSC 8 gesture,
+        // its press and release never reach the surface, and the release
+        // opens it, as Ghostty opens an OSC 8 link.
+        switch (kind) {
+            .down => if (osc8 and hs.link != null) {
+                hs.link_press = true;
+                break :took true;
+            },
+            .up => if (hs.link_press) {
+                hs.link_press = false;
+                if (osc8) if (hs.link) |u| {
+                    open = s.alloc.dupe(u8, u) catch null;
+                };
+                break :took true;
+            },
+            else => {},
+        }
+        const took = hs.pointer(&s.io.terminal, kind, tp.x, tp.y, hostMods(mods));
+        shape = hs.shapeChange(s.io.terminal.mouse_shape, osc8, false);
+        if (hs.previewChange(osc8 and s.config.link_previews != .false, false)) |p| preview = s.alloc.dupeZ(u8, p) catch null;
+        drew = hs.drew;
+        hs.drew = false;
+        break :took took;
+    };
+    apply(s, shape, preview);
+    if (open) |u| openLink(s, u);
+    deliver(s, took or drew);
+    return took;
+}
+
+/// The OSC 8 gesture: Ctrl (Cmd on macOS) held, and Ghostty's link-osc8
+/// on. Shift may be held too: a surface never reports the mouse, so shift
+/// has nothing to override (with mouse reporting on, Ghostty takes it as
+/// the way past it).
+fn osc8Gesture(s: *Surface, mods: input.Mods) bool {
+    var m = mods;
+    m.shift = false;
+    return s.config.link_osc8 and m.equal(input.ctrlOrSuper(.{}));
+}
+
+/// Shows the pointer's shape and the link preview that changed.
+fn apply(s: *Surface, shape: ?terminal.MouseShape, preview: ?[:0]const u8) void {
+    // The pointer shows what the surface under it asks for (SPEC §9).
+    if (shape) |v| _ = s.rt_app.performAction(.{ .surface = s }, .mouse_shape, v) catch {};
+    if (preview) |url| _ = s.rt_app.performAction(.{ .surface = s }, .mouse_over_link, .{ .url = url }) catch {};
+}
+
+/// Opens a hyperlink as Surface.openUrl opens an OSC 8 one: the apprt
+/// first, with its policies (on macOS its allowlist and confirmation), then
+/// the fallback opener, which refuses OSC 8 targets where it must.
+fn openLink(s: *Surface, url: []const u8) void {
+    const action: apprt.action.OpenUrl = .{ .kind = .osc8, .url = url };
+    if (s.rt_app.performAction(.{ .surface = s }, .open_url, action) catch false) return;
+    internal_os.open(action.kind, action.url) catch |err| log.warn("hotty: could not open a hyperlink: {}", .{err});
+}
+
+/// Surface.init and Surface.setFontSize: the size the terminal's font is
+/// loaded at, for the CSS px (`cssPx`). The resize that follows a change
+/// re-renders the surfaces with it.
+pub fn surfaceFont(s: *Surface) void {
+    s.renderer_state.mutex.lockUncancelable(global.io());
+    defer s.renderer_state.mutex.unlock(global.io());
+    s.io.terminal_stream.handler.hotty.font_size = s.font_size;
+}
+
+/// Surface.keyCallback, after a change of modifiers: Ghostty resets the
+/// pointer for its cells, so a surface's shape and a hyperlink's preview
+/// are shown again, for the keys now held.
+pub fn surfaceMods(s: *Surface) void {
+    const osc8 = osc8Gesture(s, s.mouse.mods);
+    var shape: ?terminal.MouseShape = null;
+    var preview: ?[:0]u8 = null;
+    defer if (preview) |p| s.alloc.free(p);
+    {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const hs = &s.io.terminal_stream.handler.hotty;
+        if (hs.hover_len == 0) return; // not over a surface: the cells' business
+        shape = hs.shapeChange(s.io.terminal.mouse_shape, osc8, true);
+        if (hs.previewChange(osc8 and s.config.link_previews != .false, true)) |p| preview = s.alloc.dupeZ(u8, p) catch null;
+    }
+    apply(s, shape, preview);
+}
+
+/// Whether the program holds the pointer after a button event: the first
+/// press of a gesture (no other button down) decides, and holds it for the
+/// program unless a surface (or a hyperlink) took it; the hold lasts until
+/// no button is down. A press while a gesture goes on changes nothing, so a
+/// surface's drag stays the surface's and the program's the program's.
+fn programHolds(held: bool, first_press: bool, taken: bool, any_down: bool) bool {
+    if (!any_down) return false;
+    if (first_press) return !taken;
+    return held;
+}
+
+test programHolds {
+    const t = std.testing;
+    // A press on the cells holds the pointer for the program...
+    try t.expect(programHolds(false, true, false, true));
+    // ...through a second button pressed and released...
+    try t.expect(programHolds(true, false, false, true));
+    try t.expect(programHolds(true, false, true, true));
+    // ...until the last release, after which the pointer is free again.
+    try t.expect(!programHolds(true, false, false, false));
+    // A press a surface (or a hyperlink) takes is not the program's, and
+    // neither is a button pressed during it.
+    try t.expect(!programHolds(false, true, true, true));
+    try t.expect(!programHolds(false, false, false, true));
+    try t.expect(!programHolds(false, false, false, false));
+}
+
+/// Whether a button event is the program's whatever lies under it: the
+/// first press of a gesture with Alt held (Option on macOS, which Ghostty
+/// reports as Alt whatever `macos-option-as-alt` says). SPEC §9.2: it is a
+/// press on the cells, so no surface (nor a hyperlink in one) gets it, and
+/// the gesture it begins is the program's until the release
+/// (`programHolds`).
+fn altPress(action: input.MouseButtonState, first_press: bool, mods: input.Mods) bool {
+    return action == .press and first_press and mods.alt;
+}
+
+test altPress {
+    const t = std.testing;
+    // An Alt press that begins a gesture is the program's, with other keys
+    // held too...
+    try t.expect(altPress(.press, true, .{ .alt = true }));
+    try t.expect(altPress(.press, true, .{ .alt = true, .shift = true, .ctrl = true }));
+    // ...and a press without Alt is not: a surface may take it.
+    try t.expect(!altPress(.press, true, .{}));
+    try t.expect(!altPress(.press, true, .{ .shift = true }));
+    // The press decides: Alt held at a release, or at a press while a
+    // gesture goes on, changes nothing.
+    try t.expect(!altPress(.release, false, .{ .alt = true }));
+    try t.expect(!altPress(.press, false, .{ .alt = true }));
+}
+
+/// Surface.mouseButtonCallback: a left click on a surface belongs to it, and
+/// is neither reported to the program nor used for selection. A press on
+/// the cells, of any other button, or with Alt held (`altPress`) is the
+/// program's, and holds the pointer for it until the release
+/// (`programHolds`).
+pub fn surfaceButton(s: *Surface, action: input.MouseButtonState, button: input.MouseButton, mods: input.Mods) bool {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    // Ghostty has already recorded this event in click_state.
+    var others = false;
+    for (s.mouse.click_state, 0..) |state, i| {
+        if (i != @intFromEnum(button) and state == .press) others = true;
+    }
+    const first = action == .press and !others;
+    const any_down = action == .press or others;
+    const pos = s.rt_surface.getCursorPos() catch {
+        hs.program_hold = programHolds(hs.program_hold, first, false, any_down);
+        return false;
+    };
+    const was = hs.program_hold;
+    const alt = altPress(action, first, mods);
+    const took = button == .left and !alt and pointerAt(s, if (action == .press) .down else .up, pos, mods);
+    hs.program_hold = programHolds(was, first, took, any_down);
+    // A gesture the program now holds leaves the surface under the pointer.
+    // A left press kept from the surfaces by Alt is one on the cells, and
+    // takes the keyboard back as one does.
+    if (hs.program_hold and !was) _ = pointerAt(s, if (alt and button == .left) .down else .move, pos, mods);
+    return took;
+}
+
+/// Surface.cursorPosCallback: hovering a surface restyles it and is not
+/// reported.
+pub fn surfaceMove(s: *Surface, pos: apprt.CursorPos, mods: ?input.Mods) bool {
+    if (pos.x < 0 or pos.y < 0) return false;
+    return pointerAt(s, .move, pos, mods orelse s.mouse.mods);
+}
+
+/// Surface.keyCallback: the surface holding the keyboard gets the key first.
+/// Keys its focused element has no use for go to the program as usual.
+pub fn surfaceKey(s: *Surface, event: input.KeyEvent) bool {
+    if (s.readonly) return false;
+    const hs = &s.io.terminal_stream.handler.hotty;
+    var drew = false;
+    const consumed = consumed: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        if (!hs.hasKeyboard()) break :consumed false;
+        // The press decides; its release goes wherever the press went.
+        if (event.action == .release) break :consumed true;
+        const code: u32 = switch (event.key) {
+            .enter, .numpad_enter => 1,
+            .tab => 2,
+            .backspace => 3,
+            .delete => 4,
+            .escape => 5,
+            .arrow_left => 6,
+            .arrow_right => 7,
+            .arrow_up => 8,
+            .arrow_down => 9,
+            .home => 10,
+            .end => 11,
+            .page_up => 12,
+            .page_down => 13,
+            .space => 14,
+            else => 0,
+        };
+        var text_buf: [64]u8 = undefined;
+        const text: ?[*:0]const u8 = if (code == 0 and event.utf8.len > 0 and event.utf8.len < text_buf.len)
+            (std.fmt.bufPrintZ(&text_buf, "{s}", .{event.utf8}) catch break :consumed false).ptr
+        else if (code == 0)
+            break :consumed false
+        else
+            null;
+        const used = hs.key(&s.io.terminal, code, text, hostMods(event.mods));
+        drew = hs.drew;
+        hs.drew = false;
+        break :consumed used;
+    };
+    deliver(s, consumed or drew);
+    return consumed;
+}
