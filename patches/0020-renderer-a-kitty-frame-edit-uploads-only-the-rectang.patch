+test "kitty renderer prepares only the rectangles a frame edit changed" {
+    if (!GraphicsAPI.texture_region_updates) return error.SkipZigTest;
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var t = try terminal.Terminal.init(io, alloc, .{ .rows = 3, .cols = 3 });
+    defer t.deinit(alloc);
+    t.width_px = 30;
+    t.height_px = 30;
+
+    var state: State = .empty;
+    defer state.deinit(alloc);
+
+    const storage = &t.screens.active.kitty_images;
+    try storage.addImage(io, alloc, t.screens.active, .{
+        .id = 1,
+        .width = 2,
+        .height = 2,
+        .format = .rgba,
+        .data = .{ .complete = try alloc.dupe(u8, &(.{255} ** 16)) },
+    });
+    const pin = try t.screens.active.pages.trackPin(
+        t.screens.active.cursor.page_pin.*,
+    );
+    try storage.addPlacement(io, alloc, t.screens.active, 1, 1, .{
+        .location = .{ .pin = pin },
+        .columns = 1,
+        .rows = 1,
+    });
+    state.kittyUpdate(alloc, &t, .{ .width = 10, .height = 10 });
+
+    // Pretend the first generation is on the GPU. The texture is never
+    // used here, only its size is read.
+    const id: Id = .{ .kitty = 1 };
+    {
+        const entry = state.images.getPtr(id).?;
+        alloc.free(entry.image.pending.dataSlice());
+        var texture: Texture = undefined;
+        texture.width = 2;
+        texture.height = 2;
+        entry.image = .{ .ready = texture };
+    }
+
+    // Edit the bottom right pixel in place, as a=f with r=1 does.
+    const img = storage.images.getPtr(1).?;
+    @constCast(img.data.bytes().?)[12..16].* = .{ 0, 0, 255, 255 };
+    storage.markImageRegionChanged(io, alloc, img, .{
+        .x = 1,
+        .y = 1,
+        .width = 1,
+        .height = 1,
+    });
+
+    state.kittyUpdate(alloc, &t, .{ .width = 10, .height = 10 });
+    const entry = state.images.getPtr(id).?;
+    try testing.expectEqual(img.generation, entry.generation);
+    const regions = entry.image.update.regions;
+    try testing.expectEqual(@as(usize, 1), regions.len);
+    try testing.expectEqual(@as(u32, 1), regions[0].x);
+    try testing.expectEqual(@as(u32, 1), regions[0].y);
+    try testing.expectEqualSlices(u8, &.{ 0, 0, 255, 255 }, regions[0].data);
+
+    // The texture was never made, so it mustn't be freed.
+    entry.image.update.free(alloc);
+    _ = state.images.remove(id);
+}
