+        const changes = self.changes orelse return null;
+        const items = changes.entries.items;
+        if (items.len == 0) return null;
+        if (items[items.len - 1].generation != self.generation) return null;
+        if (generation == changes.base) return items;
+        for (items, 0..) |c, i| {
+            if (c.generation == generation) return items[i + 1 ..];
+        }
+        return null;
+    }
