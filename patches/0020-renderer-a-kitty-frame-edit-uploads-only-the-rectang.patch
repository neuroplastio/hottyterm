+    try testing.expectEqual(@as(usize, 2), img.changesSince(gen - 2).?.len);
+    try testing.expect(img.changesSince(gen - Image.Changes.max / 2 - 2) == null);
+    try testing.expect(img.changesSince(7) == null);
+}
