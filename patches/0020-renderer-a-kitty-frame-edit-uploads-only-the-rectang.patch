+    /// If the GPU already has an earlier generation of this Kitty image
+    /// and the image knows which rectangles changed since (frame edits
+    /// in place), copy only those for upload into the existing texture.
+    /// Returns false when the whole image must be prepared instead.
+    fn prepKittyChanges(
+        self: *State,
+        alloc: Allocator,
+        image: *const terminal.kitty.graphics.Image,
+    ) Allocator.Error!bool {
+        if (!GraphicsAPI.texture_region_updates) return false;
+        const entry = self.images.getPtr(.{ .kitty = image.id }) orelse return false;
+        if (entry.generation == image.generation) return false;
+        const texture = switch (entry.image) {
+            .ready => |t| t,
+            else => return false,
+        };
+        if (image.format != .rgba or
+            texture.width != image.width or
+            texture.height != image.height) return false;
+        const changes = image.changesSince(entry.generation) orelse return false;
+        const data = image.renderData().bytes() orelse return false;
+
+        const regions = try alloc.alloc(Image.Region, changes.len);
+        var made: usize = 0;
+        errdefer {
+            for (regions[0..made]) |r| alloc.free(r.data);
+            alloc.free(regions);
+        }
+        const stride: usize = @as(usize, image.width) * 4;
+        for (changes) |c| {
+            const r = c.region;
+            const row_len: usize = @as(usize, r.width) * 4;
+            const buf = try alloc.alloc(u8, row_len * r.height);
+            for (0..r.height) |row| {
+                const start = (r.y + row) * stride + @as(usize, r.x) * 4;
+                @memcpy(buf[row * row_len ..][0..row_len], data[start..][0..row_len]);
+            }
+            regions[made] = .{
+                .x = r.x,
+                .y = r.y,
+                .width = r.width,
+                .height = r.height,
+                .data = buf,
+            };
+            made += 1;
+        }
+
+        entry.image = .{ .update = .{ .texture = texture, .regions = regions } };
+        entry.generation = image.generation;
+        return true;
+    }
 };
 
