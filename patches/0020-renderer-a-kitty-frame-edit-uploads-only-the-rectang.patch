+test "kittygfx animation: an edit of the displayed frame logs its rectangle" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var t = try Terminal.init(io, alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+    const storage = &t.screens.active.kitty_images;
+    {
+        // 4x2 white RGBA.
+        const cmd = try command.Parser.parseString(
+            alloc,
+            "a=t,f=32,s=4,v=2,i=1;//////////////////////////////////////////8=",
+        );
+        defer cmd.deinit(alloc);
+        try testing.expect(execute(io, alloc, &t, &cmd).?.ok());
+    }
+    const gen1 = storage.imagePtrByIdOrNumber(1, 0).?.generation;
+
+    // A 2x1 edit of the root frame at (1, 1).
+    {
+        const cmd = try command.Parser.parseString(
+            alloc,
+            "a=f,i=1,f=32,s=2,v=1,x=1,y=1,r=1;AAD//wAA//8=",
+        );
+        defer cmd.deinit(alloc);
+        try testing.expect(execute(io, alloc, &t, &cmd).?.ok());
+    }
+    var img = storage.imagePtrByIdOrNumber(1, 0).?;
+    const gen2 = img.generation;
+    const changes = img.changesSince(gen1).?;
+    try testing.expectEqual(@as(usize, 1), changes.len);
+    try testing.expectEqual(
+        Image.Region{ .x = 1, .y = 1, .width = 2, .height = 1 },
+        changes[0].region,
+    );
+
+    // An edit hanging off the right edge logs only what it composed.
+    {
+        const cmd = try command.Parser.parseString(
+            alloc,
+            "a=f,i=1,f=32,s=2,v=1,x=3,y=0,r=1;AP8A/wD/AP8=",
+        );
+        defer cmd.deinit(alloc);
+        try testing.expect(execute(io, alloc, &t, &cmd).?.ok());
+    }
+    img = storage.imagePtrByIdOrNumber(1, 0).?;
+    try testing.expectEqual(@as(usize, 2), img.changesSince(gen1).?.len);
+    try testing.expectEqual(
+        Image.Region{ .x = 3, .y = 0, .width = 1, .height = 1 },
+        img.changesSince(gen2).?[0].region,
+    );
+
+    // A new frame shown is not an edit: the chain goes stale.
+    {
+        const cmd = try command.Parser.parseString(
+            alloc,
+            "a=f,i=1,f=32,s=4,v=2;//////////////////////////////////////////8=",
+        );
+        defer cmd.deinit(alloc);
+        try testing.expect(execute(io, alloc, &t, &cmd).?.ok());
+    }
+    {
+        const cmd = try command.Parser.parseString(alloc, "a=a,i=1,c=2");
+        defer cmd.deinit(alloc);
+        _ = execute(io, alloc, &t, &cmd);
+    }
+    img = storage.imagePtrByIdOrNumber(1, 0).?;
+    try testing.expect(img.changesSince(gen2) == null);
+}
