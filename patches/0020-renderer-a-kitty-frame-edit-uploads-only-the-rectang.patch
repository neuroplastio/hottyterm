+    /// Records that the edit which stamped the current generation over
+    /// `before` changed only `region` of the displayed frame. If anything
+    /// else stamped a generation since the last recorded edit, the
+    /// chain starts again at `before`; a full chain forgets its older
+    /// half. Running out of memory drops the chain, which only costs
+    /// renderers a whole upload.
+    pub fn logChange(
+        self: *Image,
+        alloc: Allocator,
+        before: u64,
+        region: Region,
+    ) void {
+        const changes = self.changes orelse changes: {
+            const c = alloc.create(Changes) catch return;
+            c.* = .{ .base = before };
+            self.changes = c;
+            break :changes c;
+        };
+        const items = changes.entries.items;
+        const last = if (items.len == 0) changes.base else items[items.len - 1].generation;
+        if (last != before) {
+            changes.entries.clearRetainingCapacity();
+            changes.base = before;
+        } else if (items.len >= Changes.max) {
+            // Starting again would lose a renderer that is only a few
+            // edits behind, and make it upload the whole image.
+            const keep = Changes.max / 2;
+            changes.base = items[items.len - keep - 1].generation;
+            std.mem.copyForwards(Changes.Change, items[0..keep], items[items.len - keep ..]);
+            changes.entries.shrinkRetainingCapacity(keep);
+        }
+        changes.entries.append(alloc, .{
+            .generation = self.generation,
+            .region = region,
+        }) catch self.dropChanges(alloc);
+    }
