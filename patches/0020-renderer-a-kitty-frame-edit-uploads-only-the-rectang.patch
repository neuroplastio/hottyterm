+    img.generation = 6;
+    img.logChange(alloc, 5, .{ .x = 1, .y = 1, .width = 2, .height = 1 });
+    try testing.expectEqual(@as(usize, 2), img.changesSince(4).?.len);
+    const since5 = img.changesSince(5).?;
+    try testing.expectEqual(@as(usize, 1), since5.len);
