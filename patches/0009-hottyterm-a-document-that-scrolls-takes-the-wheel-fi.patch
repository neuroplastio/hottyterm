+    /// A wheel's turn, a touchpad's scroll or a touch drag at viewport
+    /// pixel (`px`, `py`), by (`dx`, `dy`) pixels, positive right and
+    /// down. True if a surface took it: its document scrolled, or
+    /// `overscroll-behavior` stopped it there (SPEC §5.3). Over the cells,
+    /// or while the program holds the pointer, the gesture is the
+    /// terminal's, even where it goes on over a surface.
+    fn wheel(self: *Hotty, t: *terminal.Terminal, px: f64, py: f64, dx: f64, dy: f64, mods: u32) bool {
+        const h = self.host orelse return false;
+        const fx = self.effects();
+        const target: ?Target = if (self.program_hold) null else self.hit(t, px, py);
+        var name_buf: [73]u8 = undefined;
+        const name: ?[*:0]const u8 = if (target) |tg|
+            (std.fmt.bufPrintZ(&name_buf, "{s}", .{tg.name}) catch return false).ptr
+        else
+            null;
+        const x: f32 = if (target) |tg| tg.x else 0;
+        const y: f32 = if (target) |tg| tg.y else 0;
+        const took = hotty_host_wheel(h, name, x, y, @floatCast(dx), @floatCast(dy), mods, &fx);
+        if (self.render(t)) self.drew = true;
+        // Scrollbars show as it scrolls, and fade.
+        self.schedule(t);
+        return took;
+    }
+
     fn setLink(self: *Hotty, url: ?[]const u8) void {
         if (self.link) |old| {
             if (url != null and std.mem.eql(u8, old, url.?)) return;
@@ -1365,6 +1394,37 @@ fn windowLeft(s: *Surface, mods: input.Mods) void {
     deliver(s, drew);
 }
 
+/// Surface.scrollCallback: a wheel, a touchpad's scroll or a touch drag over
+/// a surface whose document scrolls (SPEC §5.3) is the surface's while it
+/// can move that way, and otherwise does what it does over the cells. True
+/// if a surface took it. Ghostty's offsets are positive towards the top and
+/// left, in wheel notches or (precision) pixels; a notch scrolls a surface
+/// as many pixels as it scrolls the cells.
+pub fn surfaceScroll(s: *Surface, xoff: f64, yoff: f64, scroll_mods: input.ScrollMods) bool {
+    const pos = s.rt_surface.getCursorPos() catch return false;
+    const coord: rendererpkg.Coordinate = .{ .surface = .{ .x = pos.x, .y = pos.y } };
+    const tp = coord.convert(.terminal, s.size).terminal;
+    const cell_w: f64 = @floatFromInt(s.size.cell.width);
+    const cell_h: f64 = @floatFromInt(s.size.cell.height);
+    const m = s.config.mouse_scroll_multiplier;
+    const dx: f64, const dy: f64 = if (scroll_mods.precision)
+        .{ -xoff, -yoff * m.precision }
+    else
+        .{ -xoff * cell_w, -yoff * cell_h * m.discrete };
+    var drew = false;
+    const took = took: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const hs = &s.io.terminal_stream.handler.hotty;
+        const took = hs.wheel(&s.io.terminal, tp.x, tp.y, dx, dy, hostMods(s.mouse.mods));
+        drew = hs.drew;
+        hs.drew = false;
+        break :took took;
+    };
+    deliver(s, took or drew);
+    return took;
+}
+
