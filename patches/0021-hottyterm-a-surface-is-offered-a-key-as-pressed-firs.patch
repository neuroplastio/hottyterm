 }
 
-/// Surface.keyCallback: the surface holding the keyboard gets the key first,
-/// named from the bytes the program would read for it (SPEC §10.4): Ghostty's
-/// own encoding, in the modes the program set, so a key is what a TUI would
-/// see, whatever the keyboard layout or remapping made of it. Keys its
-/// focused element has no use for go to the program as usual. The press
-/// decides, and its release goes where the press went, so a program that
-/// asked for event types never hears a release without its press, nor a
-/// press without its release.
+/// Surface.keyCallback, before the terminal's shortcuts: the surface holding
+/// the keyboard is offered a key that types no text as the user pressed it,
+/// named from the key event (SPEC §10.4), so Shift+Home selects in a field
+/// rather than scrolling the terminal, and Command+ArrowLeft goes to the
+/// line's start rather than becoming the 0x01 a binding writes. A key it
+/// does not use goes on to the shortcuts, and then to surfaceKey. A release
+/// goes where its press went.
+pub fn surfaceKeyPressed(s: *Surface, event: input.KeyEvent) bool {
+    if (s.readonly) return false;
+    const hs = &s.io.terminal_stream.handler.hotty;
+    if (event.action == .release) {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        if (!hs.held_keys.contains(event.key)) return false;
+        hs.held_keys.remove(event.key);
+        return true;
+    }
+    var buf: [64]u8 = undefined;
+    const name = pressedName(event, &buf) orelse return false;
+    if (reserved(s, event) or !holdsKeyboard(s)) return false;
+    var drew = false;
+    const used = used: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const used = hs.keyPressed(&s.io.terminal, name);
+        hs.held_keys.setPresent(event.key, used);
+        drew = hs.drew;
+        hs.drew = false;
+        break :used used;
+    };
+    deliver(s, used or drew);
+    return used;
+}
+
+/// Surface.keyEventIsBinding, which macOS asks before a key reaches
+/// keyCallback: a binding on a key the surface holding the keyboard is
+/// offered first is not `consumed`, so the menu does not perform it
+/// (Command+a's Select All) before the surface had the key. keyCallback
+/// still does, if the surface does not use it.
+pub fn bindingFlags(s: *Surface, event: input.KeyEvent, flags: input.Binding.Flags) input.Binding.Flags {
+    var f = flags;
+    var buf: [64]u8 = undefined;
+    if (!s.readonly and pressedName(event, &buf) != null and !reserved(s, event) and holdsKeyboard(s)) f.consumed = false;
+    return f;
+}
+
+/// The key `event` is, named as SPEC §10.4 writes it, from the key itself,
+/// with the command key (Super) as Meta, if it types no text: a key that is
+/// not a character, or a character with Control or Meta. Null for the
+/// others, which a surface is offered only as bytes, and for a character
+/// with Shift that is not a letter, which the event does not name.
+fn pressedName(event: input.KeyEvent, buf: []u8) ?[]const u8 {
+    if (event.composing or event.key.modifier()) return null;
+    const m = event.mods;
+    var w: std.Io.Writer = .fixed(buf);
+    if (namedKey(event.key)) |key| {
+        writeMods(&w, m.ctrl, m.alt, m.super, m.shift) catch return null;
+        w.writeAll(key) catch return null;
+        return w.buffered();
+    }
+    if (!m.ctrl and !m.super) return null;
+    var cp: u21 = event.unshifted_codepoint;
+    if (cp == 0) cp = event.key.codepoint() orelse return null;
+    if (cp < 0x20 or cp == 0x7f) return null;
+    // Shift shows in the character: Control+A.
+    if (m.shift) {
+        if (cp < 'a' or cp > 'z') return null;
+        cp -= 'a' - 'A';
+    }
+    writeMods(&w, m.ctrl, m.alt, m.super, false) catch return null;
+    if (cp == ' ') w.writeAll("Space") catch return null else w.print("{u}", .{cp}) catch return null;
+    return w.buffered();
+}
+
+fn writeMods(w: *std.Io.Writer, ctrl: bool, alt: bool, meta: bool, shift: bool) !void {
+    if (ctrl) try w.writeAll("Control+");
+    if (alt) try w.writeAll("Alt+");
+    if (meta) try w.writeAll("Meta+");
+    if (shift) try w.writeAll("Shift+");
+}
+
+/// The W3C key value of a key that is not a character.
+fn namedKey(key: input.Key) ?[]const u8 {
+    return switch (key) {
+        .arrow_left, .numpad_left => "ArrowLeft",
+        .arrow_right, .numpad_right => "ArrowRight",
+        .arrow_up, .numpad_up => "ArrowUp",
+        .arrow_down, .numpad_down => "ArrowDown",
+        .home, .numpad_home => "Home",
+        .end, .numpad_end => "End",
+        .page_up, .numpad_page_up => "PageUp",
+        .page_down, .numpad_page_down => "PageDown",
+        .insert, .numpad_insert => "Insert",
+        .delete, .numpad_delete => "Delete",
+        .backspace, .numpad_backspace => "Backspace",
+        .enter, .numpad_enter => "Enter",
+        .tab => "Tab",
+        .escape => "Escape",
+        inline .f1, .f2, .f3, .f4, .f5, .f6, .f7, .f8, .f9, .f10, .f11, .f12, .f13, .f14, .f15, .f16, .f17, .f18, .f19, .f20, .f21, .f22, .f23, .f24 => |k| comptime k.w3c(),
+        else => null,
+    };
+}
+
+/// The keys hottyterm keeps from a surface (SPEC §10.4 lets a host keep
+/// some): every key while a key sequence or a key table is under way, a key
+/// that starts a sequence, and a key bound to what a browser keeps too:
+/// opening, closing and picking windows, tabs and splits by number,
+/// quitting, the config, key tables.
+fn reserved(s: *Surface, event: input.KeyEvent) bool {
+    if (s.keyboard.sequence_set != null or s.keyboard.table_stack.items.len > 0) return true;
+    const entry = s.config.keybind.set.getEvent(event) orelse return false;
+    const leaf: input.Binding.Set.GenericLeaf = switch (entry.value_ptr.*) {
+        .leader => return true,
+        inline .leaf, .leaf_chained => |v| v.generic(),
+    };
+    for (leaf.actionsSlice()) |a| switch (a) {
+        .quit,
+        .new_window,
+        .new_tab,
+        .new_split,
+        .close_surface,
+        .close_tab,
+        .close_window,
+        .close_all_windows,
+        .goto_tab,
+        .last_tab,
+        .toggle_fullscreen,
+        .toggle_maximize,
+        .toggle_quick_terminal,
+        .toggle_command_palette,
+        .open_config,
+        .reload_config,
+        .activate_key_table,
+        .activate_key_table_once,
+        => return true,
+        else => {},
+    };
+    return false;
+}
+
+/// Surface.keyCallback, after the terminal's shortcuts: the surface holding
+/// the keyboard is offered the key a second time, named from the bytes the
+/// program would read for it (SPEC §10.4): Ghostty's own encoding, in the
+/// modes the program set, so a key is what a TUI would see, whatever the
+/// keyboard layout or remapping made of it. Keys its focused element has no
+/// use for go to the program as usual. The press decides, and its release
+/// goes where the press went, so a program that asked for event types never
+/// hears a release without its press, nor a press without its release.
 pub fn surfaceKey(s: *Surface, event: input.KeyEvent) bool {
     if (s.readonly) return false;
     const hs = &s.io.terminal_stream.handler.hotty;
