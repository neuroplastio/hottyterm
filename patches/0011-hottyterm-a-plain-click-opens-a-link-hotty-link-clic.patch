From: HOTTY Agent <hotty@neuroplast.io>
Date: Thu, 8 Oct 2026 17:21:16 +0200
Subject: [PATCH 11/12] hottyterm: a plain click opens a link
 (hotty-link-click)

`hotty-link-click = plain`, the default, opens a link with a click and no
modifiers held, as a browser does: a URL or an OSC 8 hyperlink in the
cells, and a HOTTY surface's hyperlink. The pointer over one underlines
it. Where the program reports the mouse the click stays the program's,
as without this. A drag still selects; Ctrl (Cmd on macOS) and click
still opens. `modifier` is Ghostty's behaviour.

hotty.zig decides (plainLinkClick, osc8Gesture). Upstream lines:
Surface.zig 4 (the config field and its init; mouseModsWithCapture,
whose callers are the cells' link handling, takes no modifiers as the
link gesture; mouseRefreshLinks gives the renderer those modifiers, so
hovering underlines), Config.zig 14 (the option and its enum).
---
 src/Surface.zig       |  4 ++++
 src/config/Config.zig | 14 ++++++++++++++
 src/termio/hotty.zig  | 24 +++++++++++++++++++-----
 3 files changed, 37 insertions(+), 5 deletions(-)

diff --git a/src/Surface.zig b/src/Surface.zig
index b63bc9a5..2745ad3a 100644
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -344,6 +344,7 @@ const DerivedConfig = struct {
     vt_window_resize_allowed: bool,
     links: []DerivedConfig.Link,
     link_osc8: bool,
+    hotty_link_click: configpkg.Config.HottyLinkClick,
     link_previews: configpkg.LinkPreviews,
     scroll_to_bottom: configpkg.Config.ScrollToBottom,
     notify_on_command_finish: configpkg.Config.NotifyOnCommandFinish,
@@ -425,6 +426,7 @@ const DerivedConfig = struct {
             .vt_window_resize_allowed = config.@"vt-window-resize-allowed",
             .links = links,
             .link_osc8 = config.@"link-osc8",
+            .hotty_link_click = config.@"hotty-link-click",
             .link_previews = config.@"link-previews",
             .scroll_to_bottom = config.@"scroll-to-bottom",
             .notify_on_command_finish = config.@"notify-on-command-finish",
@@ -1620,6 +1622,7 @@ fn mouseRefreshLinks(
     // Update the last point that we checked for links so we don't
     // recheck if the mouse moves some pixels to the same point.
     self.mouse.link_point = pos_vp;
+    self.renderer_state.mouse.mods = self.mouseModsWithCapture(self.mouse.mods);
 
     // We use an arena for everything below to make things easy to clean up.
     // In the case we don't do any allocs this is very cheap to setup
@@ -4505,6 +4508,7 @@ fn linkAtPin(
 ///
 /// The renderer state mutex must be held.
 fn mouseModsWithCapture(self: *Surface, mods: input.Mods) input.Mods {
+    if (hotty.plainLinkClick(self, mods)) return input.ctrlOrSuper(.{});
     // In any of these scenarios, whatever mods are set (even shift)
     // are preserved.
     if (self.io.terminal.flags.mouse_event == .none) return mods;
diff --git a/src/config/Config.zig b/src/config/Config.zig
index 55ec77b3..c23a5f28 100644
--- a/src/config/Config.zig
+++ b/src/config/Config.zig
@@ -3948,6 +3948,17 @@ term: []const u8 = "xterm-ghostty",
 /// only what the program sent them. (HOTTY SPEC §7.2.)
 @"hotty-net": []const u8 = "",
 
+// hottyterm: how a click opens a link.
+/// How a click opens a link: a URL, or an OSC 8 hyperlink, in the cells or
+/// in a HOTTY surface.
+///
+///   * `plain` - a click with no modifiers held opens it, and the pointer
+///     over one underlines it, except in the cells while the program
+///     reports the mouse: the click is the program's there. A click with
+///     Ctrl (Cmd on macOS) held opens it too.
+///   * `modifier` - only a click with Ctrl (Cmd on macOS) held opens it.
+@"hotty-link-click": HottyLinkClick = .plain,
+
 /// Configures the low-level API to use for async IO, eventing, etc.
 ///
 /// Most users should leave this set to `auto`. This will automatically detect
@@ -5563,6 +5574,9 @@ pub const WindowSubtitle = enum {
     @"working-directory",
 };
 
+// hottyterm: `hotty-link-click`.
+pub const HottyLinkClick = enum { plain, modifier };
+
 pub const LinkPreviews = enum {
     false,
     true,
diff --git a/src/termio/hotty.zig b/src/termio/hotty.zig
index 56580eda..c6287e59 100644
--- a/src/termio/hotty.zig
+++ b/src/termio/hotty.zig
@@ -1237,14 +1237,28 @@ fn pointerAt(s: *Surface, kind: PointerKind, pos: apprt.CursorPos, mods: input.M
     return took;
 }
 
-/// The OSC 8 gesture: Ctrl (Cmd on macOS) held, and Ghostty's link-osc8
-/// on. Shift may be held too: a surface never reports the mouse, so shift
-/// has nothing to override (with mouse reporting on, Ghostty takes it as
-/// the way past it).
+/// The OSC 8 gesture: Ctrl (Cmd on macOS) held, or with `hotty-link-click
+/// = plain` no modifier, and Ghostty's link-osc8 on. Shift may be held
+/// too: a surface never reports the mouse, so shift has nothing to
+/// override (with mouse reporting on, Ghostty takes it as the way past it).
 fn osc8Gesture(s: *Surface, mods: input.Mods) bool {
     var m = mods;
     m.shift = false;
-    return s.config.link_osc8 and m.equal(input.ctrlOrSuper(.{}));
+    const plain = s.config.hotty_link_click == .plain and m.equal(.{});
+    return s.config.link_osc8 and (plain or m.equal(input.ctrlOrSuper(.{})));
+}
+
+/// Surface.mouseModsWithCapture, for the cells' links: with
+/// `hotty-link-click = plain`, no modifier held is the link gesture (Ctrl,
+/// Cmd on macOS), so a plain click opens a URL or an OSC 8 hyperlink and the
+/// pointer over one underlines it, as in a browser. Not while the program
+/// reports the mouse: the click is its own, as it is without this. A drag
+/// still selects (Surface opens a link only on a release that did not
+/// drag). Needs the renderer state's lock.
+pub fn plainLinkClick(s: *Surface, mods: input.Mods) bool {
+    return s.config.hotty_link_click == .plain and
+        s.io.terminal.flags.mouse_event == .none and
+        mods.binding().equal(.{});
 }
 
 /// Shows the pointer's shape and the link preview that changed.
