-                switch (t.key) {
-                    .unicode => |cp| cp == 'f',
-                    else => false,
-                };
             const gone = switch (action) {
                 .new_tab,
                 .close_tab,
@@ -7486,11 +7479,12 @@ pub const Keybinds = struct {
                 .goto_tab,
                 .move_tab,
                 .toggle_tab_overview,
+                .close_surface,
                 .close_window,
                 .close_all_windows,
+                .quit,
+                .toggle_fullscreen,
