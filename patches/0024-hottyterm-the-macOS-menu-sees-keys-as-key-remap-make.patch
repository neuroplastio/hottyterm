                                                    ghostty_input_key_s,
diff --git a/macos/Sources/App/AppDelegate.swift b/macos/Sources/App/AppDelegate.swift
index 34959158e..718d78a21 100644
--- a/macos/Sources/App/AppDelegate.swift
+++ b/macos/Sources/App/AppDelegate.swift
@@ -1193,9 +1193,11 @@ extension AppDelegate {
         syncMenuShortcut(config, action: "new_tab", menuItem: self.menuNewTab)
         syncMenuShortcut(config, action: "close_surface", menuItem: self.menuClose)
         syncMenuShortcut(config, action: "close_tab", menuItem: self.menuCloseTab)
-        // hottyterm: no tabs.
+        // hottyterm: no tabs, and full screen is the window manager's.
         self.menuNewTab?.isHidden = true
         self.menuCloseTab?.isHidden = true
+        self.menuToggleFullScreen?.keyEquivalent = ""
+        self.menuToggleFullScreen?.keyEquivalentModifierMask = []
         syncMenuShortcut(config, action: "close_window", menuItem: self.menuCloseWindow)
         syncMenuShortcut(config, action: "close_all_windows", menuItem: self.menuCloseAllWindows)
         syncMenuShortcut(config, action: "new_split:right", menuItem: self.menuSplitRight)
diff --git a/macos/Sources/Ghostty/Surface View/SurfaceView_AppKit.swift b/macos/Sources/Ghostty/Surface View/SurfaceView_AppKit.swift
index 36ad8f100..fe9d56b75 100644
--- a/macos/Sources/Ghostty/Surface View/SurfaceView_AppKit.swift	
+++ b/macos/Sources/Ghostty/Surface View/SurfaceView_AppKit.swift	
@@ -1323,6 +1323,30 @@ extension Ghostty {
                 return false
             }
 
+            // hottyterm: the menu sees a key as `key-remap` makes it (Cmd and
+            // Ctrl swapped, say), not as it came. A key that becomes no
+            // Command key is the terminal's, never the menu's: Ctrl+H is not
+            // Hide. One that becomes a Command key goes to the menu as that.
+            let modKeys: NSEvent.ModifierFlags = [.shift, .control, .option, .command]
+            let rawMods = event.modifierFlags.intersection(modKeys)
+            let remappedMods = surface.map { surface in
+                Ghostty.eventModifierFlags(
+                    mods: ghostty_surface_key_remap_mods(surface, Ghostty.ghosttyMods(event.modifierFlags))
+                ).intersection(modKeys)
+            } ?? rawMods
+            let menuEvent: NSEvent = remappedMods == rawMods ? event : NSEvent.keyEvent(
+                with: .keyDown,
+                location: event.locationInWindow,
+                modifierFlags: event.modifierFlags.subtracting(modKeys).union(remappedMods),
+                timestamp: event.timestamp,
+                windowNumber: event.windowNumber,
+                context: nil,
+                characters: event.characters ?? "",
+                charactersIgnoringModifiers: event.charactersIgnoringModifiers ?? "",
+                isARepeat: event.isARepeat,
+                keyCode: event.keyCode
+            ) ?? event
+
             // Get information about if this is a binding.
             let bindingFlags = surfaceModel.flatMap { surface in
                 var ghosttyEvent = event.ghosttyKeyEvent(GHOSTTY_ACTION_PRESS)
@@ -1345,7 +1369,7 @@ extension Ghostty {
                    bindingFlags.isDisjoint(with: [.all, .performable]),
                    bindingFlags.contains(.consumed) {
                     if let appDelegate = NSApp.delegate as? AppDelegate,
-                       appDelegate.performGhosttyBindingMenuKeyEquivalent(with: event) {
+                       appDelegate.performGhosttyBindingMenuKeyEquivalent(with: menuEvent) {
                         return true
                     }
                 }
@@ -1354,6 +1378,17 @@ extension Ghostty {
                 return true
             }
 
+            // hottyterm: a remapped key that is no binding: the menu's only
+            // if it became a Command key, and otherwise the terminal's.
+            if remappedMods != rawMods {
+                if remappedMods.contains(.command),
+                   NSApp.mainMenu?.performKeyEquivalent(with: menuEvent) == true {
+                    return true
+                }
+                self.keyDown(with: event)
+                return true
+            }
+
             let equivalent: String
             switch event.charactersIgnoringModifiers {
             case "\r":
diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index b90366ac7..d34bb6e48 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -2027,6 +2027,20 @@ pub const CAPI = struct {
         return @intCast(@as(input.Mods.Backing, @bitCast(result)));
     }
 
+    /// hottyterm: the modifiers `mods_raw` stand for after `key-remap`, so
+    /// that the macOS menu sees a key as remapped.
+    export fn ghostty_surface_key_remap_mods(
+        surface: *Surface,
+        mods_raw: c_int,
+    ) c_int {
+        const mods: input.Mods = @bitCast(@as(
+            input.Mods.Backing,
+            @truncate(@as(c_uint, @bitCast(mods_raw))),
+        ));
+        const result = surface.core_surface.config.key_remaps.apply(mods);
+        return @intCast(@as(input.Mods.Backing, @bitCast(result)));
+    }
+
     /// Send this for raw keypresses (i.e. the keyDown event on macOS).
     /// This will handle the keymap translation and send the appropriate
     /// key and char events.
