     }
 
+    /// A finger at viewport pixel (`px`, `py`) (SPEC §9.1). A touch that
+    /// begins over a surface that takes the pointer there is that surface's
+    /// to decide, every phase of it, taps included, and hotty-blitz says
+    /// whose it is; one over the cells, or while the program holds the
+    /// pointer, is the terminal's. A touch hovers nothing.
+    fn touch(self: *Hotty, t: *terminal.Terminal, phase: TouchPhase, px: f64, py: f64, mods: u32) Touch {
+        const h = self.host orelse return .cells;
+        if (phase == .down) {
+            self.touch_len = 0;
+            const tg = (if (self.program_hold) null else self.hit(t, px, py)) orelse return .cells;
+            if (tg.name.len > self.touch_surface.len) return .cells;
+            @memcpy(self.touch_surface[0..tg.name.len], tg.name);
+            self.touch_len = tg.name.len;
+        }
+        if (self.touch_len == 0) {
+            // The lift ends the wheel gesture the touch scrolled with.
+            if (phase == .up) hotty_host_end_gesture(h);
+            return .cells;
+        }
+        const own = self.touch_surface[0..self.touch_len];
+        var name_buf: [73]u8 = undefined;
+        const name = std.fmt.bufPrintZ(&name_buf, "{s}", .{own}) catch return .cells;
+        // Its surface gone from the screen: the touch is cancelled, and the
+        // rest of it is the terminal's.
+        const p = self.at(t, own, px, py);
+        const fx = self.effects();
+        const ph: TouchPhase = if (p == null) .cancel else phase;
+        const r = hotty_host_touch(h, name.ptr, @intFromEnum(ph), if (p) |q| q.x else 0, if (p) |q| q.y else 0, mods, &fx);
+        if (phase == .up or p == null) self.touch_len = 0;
+        if (phase == .up and r != 2) hotty_host_end_gesture(h);
+        if (self.render(t)) self.drew = true;
+        // A drag that scrolls shows scrollbars, which fade.
+        self.schedule(t);
+        return switch (r) {
+            1 => .hold,
+            2 => .taken,
+            else => .scroll,
+        };
+    }
+
     fn setLink(self: *Hotty, url: ?[]const u8) void {
         if (self.link) |old| {
             if (url != null and std.mem.eql(u8, old, url.?)) return;
@@ -1458,6 +1529,34 @@ pub fn surfaceScroll(s: *Surface, xoff: f64, yoff: f64, scroll_mods: input.Scrol
     return took;
 }
 
+/// A touch on the apprt's surface, at its pixel `pos`: the apprt passes
+/// every phase of every touch here, and does with it what the result says
+/// (`Touch`). Over a surface, hotty-blitz decides whether the touch drags
+/// (SPEC §9.1), so its taps never reach Surface.mouseButtonCallback, and its
+/// moves reach Surface.scrollCallback only once it pans.
+pub fn surfaceTouch(s: *Surface, phase: TouchPhase, pos: apprt.CursorPos, mods: input.Mods) Touch {
+    const coord: rendererpkg.Coordinate = .{ .surface = .{ .x = pos.x, .y = pos.y } };
+    const tp = coord.convert(.terminal, s.size).terminal;
+    var drew = false;
+    const r: Touch = r: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const hs = &s.io.terminal_stream.handler.hotty;
+        // A touch that only focuses the split, as a click then does
+        // (hotty-focus-click = focus), is the terminal's.
+        if (phase == .down and !s.focused and s.config.hotty_focus_click == .focus) {
+            hs.touch_len = 0;
+            break :r .cells;
+        }
+        const r = hs.touch(&s.io.terminal, phase, tp.x, tp.y, hostMods(mods));
+        drew = hs.drew;
+        hs.drew = false;
+        break :r r;
+    };
+    deliver(s, r == .taken or drew);
+    return r;
+}
