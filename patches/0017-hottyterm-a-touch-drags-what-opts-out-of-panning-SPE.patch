 pub const PointerKind = enum(u32) { move = 0, down = 1, up = 2, leave = 3 };
 
+/// A finger's phase, as hotty_host_touch takes it: down when the first
+/// finger touches; cancel when a second one does or the platform cancelled
+/// it. hottyterm takes no long press, so it never sends hotty-blitz's 4.
+pub const TouchPhase = enum(u32) { down = 0, move = 1, up = 2, cancel = 3 };
+
+/// Whose a touch is after one of its phases (SPEC §9.1), for the apprt.
+pub const Touch = enum {
+    /// It began over the cells: the terminal's, clicks and scrolls.
+    cells,
+    /// It began over a surface, which has its taps, and the terminal
+    /// scrolls with its moves: it pans.
+    scroll,
+    /// It began over a surface that may drag with it: hold its moves, and
+    /// scroll with them once it pans (the moves held included).
+    hold,
+    /// The surface's: a drag, or on up a tap it took as a click.
+    taken,
+
+    /// The terminal scrolls with the touch's moves.
+    pub fn scrolls(self: Touch) bool {
+        return self == .cells or self == .scroll;
+    }
+};
