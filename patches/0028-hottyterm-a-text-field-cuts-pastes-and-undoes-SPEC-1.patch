+/// What a text field's cut and paste ask of the clipboard (SPEC §10.2),
+/// after a key, once the renderer lock is let go: a paste's request may
+/// complete at once, and takes the lock to type into the field.
+fn clipboard(s: *Surface) void {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    const cut, const paste = taken: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        defer hs.cut = null;
+        defer hs.paste_wanted = false;
+        break :taken .{ hs.cut, hs.paste_wanted };
+    };
+    if (cut) |c| {
+        defer hs.alloc.free(c);
+        setClipboards(s, &.{.standard}, c);
+    }
+    if (paste) _ = s.performBindingAction(.paste_from_clipboard) catch |err|
+        log.warn("hotty: a field's paste could not read the clipboard err={}", .{err});
+}
+
+/// Surface.completeClipboardPaste: while a text field has the keyboard,
+/// what the terminal pastes types into it, a field's paste and the
+/// terminal's own alike, and does not reach the program (SPEC §11). False
+/// when none has it: the terminal pastes to the program as usual.
+pub fn pasteInto(s: *Surface, data: []const u8) bool {
+    if (s.readonly or !holdsKeyboard(s)) return false;
+    var drew = false;
+    const took = took: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const hs = &s.io.terminal_stream.handler.hotty;
+        const h = hs.host orelse break :took false;
+        const fx = hs.effects();
+        const took = hotty_host_paste(h, data.ptr, data.len, &fx);
+        if (hs.render(&s.io.terminal)) hs.drew = true;
+        drew = hs.drew;
+        hs.drew = false;
+        break :took took;
+    };
+    deliver(s, took or drew);
+    return took;
+}
+
+/// Surface.startClipboardRequest: a paste asks for text, not for kitty's
+/// paste event, while a surface has the keyboard, so that a text field can
+/// take it (SPEC §11).
+pub fn pastesText(s: *Surface) bool {
+    return holdsKeyboard(s);
+}
+
 fn setClipboards(s: *Surface, clipboards: []const apprt.Clipboard, text: [:0]const u8) void {
     const contents: []const apprt.ClipboardContent = &.{.{ .mime = "text/plain", .data = text }};
     for (clipboards) |c| s.rt_surface.setClipboard(c, contents, false) catch |err| {
@@ -1823,6 +1896,7 @@ pub fn surfaceKeyPressed(s: *Surface, event: input.KeyEvent) bool {
         break :used used;
     };
     deliver(s, used or drew);
+    clipboard(s);
     return used;
 }
 
