diff --git a/src/config/Config.zig b/src/config/Config.zig
index d8e86d43c..010084d5e 100644
--- a/src/config/Config.zig
+++ b/src/config/Config.zig
@@ -7453,6 +7453,49 @@ pub const Keybinds = struct {
                 .{ .esc = "f" },
             );
         }
+
+        try hottytermDefaults(&self.set, alloc);
+    }
+
+    /// hottyterm: no tabs, since plx has them, and windows and full screen
+    /// are the window manager's: no default keys for tabs, for quitting,
+    /// for closing windows or for full screen. The Mac keeps Cmd+Q, Cmd+W
+    /// and Ctrl+Cmd+F, which no window manager gives there.
+    fn hottytermDefaults(set: *inputpkg.Binding.Set, alloc: Allocator) !void {
+        const mac = comptime builtin.target.os.tag.isDarwin();
+        var drop: std.ArrayList(inputpkg.Binding.Trigger) = .empty;
+        defer drop.deinit(alloc);
+        var it = set.bindings.iterator();
+        while (it.next()) |entry| {
+            const t = entry.key_ptr.*;
+            const action = switch (entry.value_ptr.*) {
+                .leaf => |leaf| leaf.action,
+                else => continue,
+            };
+            const ctrl_cmd_f = t.mods.ctrl and t.mods.super and !t.mods.shift and !t.mods.alt and
+                switch (t.key) {
+                    .unicode => |cp| cp == 'f',
+                    else => false,
+                };
+            const gone = switch (action) {
+                .new_tab,
+                .close_tab,
+                .previous_tab,
+                .next_tab,
+                .last_tab,
+                .goto_tab,
+                .move_tab,
+                .toggle_tab_overview,
+                .close_window,
+                .close_all_windows,
+                => true,
+                .quit => !mac,
+                .toggle_fullscreen => !(mac and ctrl_cmd_f),
+                else => false,
+            };
+            if (gone) try drop.append(alloc, t);
+        }
+        for (drop.items) |t| set.remove(alloc, t);
     }
 
     pub fn parseCLI(self: *Keybinds, alloc: Allocator, input: ?[]const u8) !void {
