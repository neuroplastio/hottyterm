+        const took = buttonAt(s, action, .right, pos, context_mods, .{ .context = true });
+        if (!took) appKitProgramClick(s, action, pos, mods);
+        return true;
+    }
+    const held = !hs.captured_buttons.empty() or hs.program_hold;
+    if (held or !mods.shift) {
+        if (buttonAt(s, action, .right, pos, context_mods, .{ .context = true, .alt_over = &alt_over })) return true;
+        if (hs.program_hold or alt_over) {
+            appKitProgramClick(s, action, pos, mods);
+            return true;
+        }
+        _ = buttonAt(s, .release, .right, pos, context_mods, .{ .context = true });
+    }
+    if (!s.mouseCaptured()) {
+        _ = s.mouseButtonCallbackRouted(.press, .right, mods, false) catch false;
+        // AppKit tracks the menu and supplies no matching terminal release.
+        hs.program_hold = menuTakesRelease(&s.mouse.click_state, hs.program_hold);
+    }
+    return false;
+}
+
+fn appKitProgramClick(s: *Surface, action: input.MouseButtonState, pos: apprt.CursorPos, mods: input.Mods) void {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    hs.program_hold = appKitControlButtonState(&s.mouse.click_state, &hs.program_control_click, action);
+    lockState(s, @src());
+    defer s.renderer_state.mutex.unlock(global.io());
+    if (s.config.mouse_reporting and s.io.terminal.flags.mouse_event != .none) {
+        const report = mouseButtonReport(.left, mods, true);
+        s.mouseReport(report.button, if (action == .press) .press else .release, report.mods, pos);
+    }
+}
+
+/// The terminal receives a right-button report for an intercepted
+/// Control-click. Ghostty tracks the physical left button in its chord.
+fn appKitControlButtonState(states: []input.MouseButtonState, active: *bool, action: input.MouseButtonState) bool {
+    active.* = action == .press;
+    states[@backingInt(input.MouseButton.left)] = action;
+    return std.mem.findScalar(input.MouseButtonState, states, .press) != null;
+}
+
+const MouseButtonReport = struct { button: ?input.MouseButton, mods: input.Mods };
+
+fn mouseButtonReport(physical: ?input.MouseButton, mods: input.Mods, control_click: bool) MouseButtonReport {
+    if (control_click and physical == .left) return .{
+        .button = .right,
+        .mods = mods.unset(.{ .ctrl = true }),
+    };
+    return .{ .button = physical, .mods = mods };
+}
+
+fn motionButtonReport(states: []const input.MouseButtonState, mods: input.Mods, control_click: bool) MouseButtonReport {
+    // Match Ghostty's choice of the first pressed physical button.
+    const physical: ?input.MouseButton = if (std.mem.findScalar(input.MouseButtonState, states, .press)) |i|
+        @fromBackingInt(@intCast(i))
+    else
+        null;
+    return mouseButtonReport(physical, mods, control_click);
+}
+
+/// Surface.cursorPosCallback, with the renderer lock held. Preserve the
+/// physical chord until the reporting boundary.
+pub fn mouseMotionReport(s: *Surface, pos: apprt.CursorPos) void {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    const report = motionButtonReport(&s.mouse.click_state, s.mouse.mods, hs.program_control_click);
+    s.mouseReport(report.button, .motion, report.mods, pos);
+}
+
+fn expectSgrMouseReport(report: MouseButtonReport, action: input.MouseAction, x: f32, opts: input.mouse_encode.Options, expected: []const u8) !void {
+    var buf: [32]u8 = undefined;
+    var writer: std.Io.Writer = .fixed(&buf);
+    try input.mouse_encode.encode(&writer, .{
+        .button = report.button,
+        .mods = report.mods,
+        .action = action,
+        .pos = .{ .x = x },
+    }, opts);
+    try std.testing.expectEqualStrings(expected, writer.buffered());
+}
