+/// GestureClick counts the first press. A capture-phase controller
+/// intercepts a chord press before GTK cancels that gesture, and delivers
+/// physical releases even if GTK has already stopped tracking the click.
+pub fn gtkMouseButton(
+    event: *@import("gdk").Event,
+    buttons: *MouseButtons,
+    widget: anytype,
+    render_widget: *@import("gtk").Widget,
+    comptime translate: anytype,
+    comptime down: anytype,
+    comptime up: anytype,
