+test "AppKit Control-click SGR reports and physical chord release orders" {
+    const t = std.testing;
+    const left = @backingInt(input.MouseButton.left);
+    const right = @backingInt(input.MouseButton.right);
+    const mods: input.Mods = .{ .alt = true, .ctrl = true };
+    const intercepted = mouseButtonReport(.left, mods, true);
+    const real_right = mouseButtonReport(.right, mods, false);
+
+    for ([_]terminal.MouseEvent{ .button, .any }) |mode| {
+        for ([_]enum { single, right_first, left_first }{ .single, .right_first, .left_first }) |release_order| {
+            var states: [input.MouseButton.max + 1]input.MouseButtonState = @splat(.release);
+            var active = false;
+            var last: ?terminal.point.Coordinate = null;
+            const opts: input.mouse_encode.Options = .{
+                .event = mode,
+                .format = .sgr,
+                .size = .{ .screen = .{ .width = 80, .height = 32 }, .cell = .{ .width = 8, .height = 16 }, .padding = .{} },
+                .last_cell = &last,
+            };
+
+            try t.expect(appKitControlButtonState(&states, &active, .press));
+            try t.expectEqual(input.MouseButtonState.release, states[right]);
+            try expectSgrMouseReport(intercepted, .press, 0, opts, "\x1b[<10;1;1M");
+            if (release_order != .single) {
+                states[right] = .press;
+                try expectSgrMouseReport(real_right, .press, 0, opts, "\x1b[<26;1;1M");
+            }
+            try expectSgrMouseReport(motionButtonReport(&states, mods, active), .motion, 8, opts, "\x1b[<42;2;1M");
+
+            if (release_order == .left_first) {
+                try t.expect(appKitControlButtonState(&states, &active, .release));
+                try t.expectEqual(input.MouseButtonState.press, states[right]);
+                try expectSgrMouseReport(intercepted, .release, 8, opts, "\x1b[<10;2;1m");
+                try expectSgrMouseReport(motionButtonReport(&states, mods, active), .motion, 16, opts, "\x1b[<58;3;1M");
+                states[right] = .release;
+                try expectSgrMouseReport(real_right, .release, 16, opts, "\x1b[<26;3;1m");
+            } else {
+                if (release_order == .right_first) {
+                    states[right] = .release;
+                    try t.expect(programHolds(true, false, false, states[left] == .press));
+                    try expectSgrMouseReport(real_right, .release, 8, opts, "\x1b[<26;2;1m");
+                    try expectSgrMouseReport(motionButtonReport(&states, mods, active), .motion, 16, opts, "\x1b[<42;3;1M");
+                }
+                try t.expect(!appKitControlButtonState(&states, &active, .release));
+                try expectSgrMouseReport(intercepted, .release, 16, opts, "\x1b[<10;3;1m");
+            }
+            try t.expect(!active);
+            const after = motionButtonReport(&states, mods, active);
+            try t.expectEqual(@as(?input.MouseButton, null), after.button);
+            try t.expect(after.mods.ctrl);
+        }
+    }
+}
