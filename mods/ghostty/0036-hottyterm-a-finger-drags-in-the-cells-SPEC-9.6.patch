+/// The reports of the mouse that a finger in the program's area made
+/// (SPEC §9.6), as Ghostty reports the mouse's (Surface.mouseReport): in
+/// the program's mode and encoding, the primary button held from the press
+/// to the release, so its moves report as a drag. Nothing is selected, and
+/// a press drops the selection, as a reported press does. Shift is left
+/// out unless Ghostty would report a press with it (`mouse-shift-capture`,
+/// or the program asking): without that, Shift and a press select. A
+/// report the program no longer reads the mouse for is not made; the
+/// button is still let go. Under the renderer lock.
+fn touchMouse(s: *Surface, hs: *Hotty) void {
+    defer hs.mouse_len = 0;
+    const left = &s.mouse.click_state[@intFromEnum(input.MouseButton.left)];
+    const shift = s.mouseShiftCapture(false);
+    for (hs.mouse[0..hs.mouse_len]) |m| {
+        const action: input.MouseAction = switch (m.kind) {
+            1 => .press,
+            2 => .release,
+            else => .motion,
+        };
+        switch (action) {
+            .press => left.* = .press,
+            .release => left.* = .release,
+            .motion => {},
+        }
+        if (!s.config.mouse_reporting or s.io.terminal.flags.mouse_event == .none) continue;
+        if (action == .press) s.setSelection(null) catch {};
+        const at = (rendererpkg.Coordinate{ .terminal = .{ .x = m.x, .y = m.y } }).convert(.surface, s.size).surface;
+        var mods = modsOf(m.mods);
+        if (!shift) mods.shift = false;
+        s.mouseReport(.left, action, mods, .{ .x = @floatCast(at.x), .y = @floatCast(at.y) });
+    }
+}
+
+/// The keys `hostMods` wrote.
+fn modsOf(bits: u32) input.Mods {
+    return .{ .shift = bits & 1 != 0, .ctrl = bits & 2 != 0, .alt = bits & 4 != 0, .super = bits & 8 != 0 };
+}
