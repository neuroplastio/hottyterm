From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Mon, 16 Nov 2026 20:22:00 +0100
Subject: [PATCH 57/70] hottyterm: emoji draw from Noto Color Emoji on every
 platform

Noto Color Emoji is the emoji fallback on every platform, ahead of any
emoji font the system has: on Linux upstream's embedded CBDT file, and on
macOS, where upstream adds Apple Color Emoji, the same PNGs as sbix,
since CoreText draws no CBDT. hottyterm's scripts/build-macos.sh makes
that copy (scripts/noto-sbix.py) and names it in HOTTYTERM_EMOJI_SBIX.
hotty-blitz draws a surface's emoji from the same file, so an emoji in
the cells and one in a surface are the same drawing.

Adds an sbix import in src/build/SharedDeps.zig, emoji_color in
src/font/embedded.zig, and removes upstream's Apple Color Emoji lookup in
src/font/SharedGridSet.zig.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/build/SharedDeps.zig   | 12 ++++++
 src/font/SharedGridSet.zig | 75 ++++++++++++++++----------------------
 src/font/embedded.zig      |  9 +++++
 3 files changed, 53 insertions(+), 43 deletions(-)

diff --git a/src/build/SharedDeps.zig b/src/build/SharedDeps.zig
index 6905b5710..466ba1035 100644
--- a/src/build/SharedDeps.zig
+++ b/src/build/SharedDeps.zig
@@ -672,6 +672,18 @@ pub fn add(
             );
         }
 
+        // Noto Color Emoji as sbix, for CoreText, which draws no CBDT:
+        // hottyterm's scripts/build-macos.sh makes it (scripts/noto-sbix.py)
+        // and names it here.
+        if (target.result.os.tag.isDarwin()) {
+            const sbix = b.graph.environ_map.get("HOTTYTERM_EMOJI_SBIX") orelse
+                std.debug.panic("HOTTYTERM_EMOJI_SBIX is not set: build with hottyterm's scripts/build-macos.sh", .{});
+            step.root_module.addAnonymousImport(
+                "hottyterm_emoji_sbix",
+                .{ .root_source_file = .{ .cwd_relative = sbix } },
+            );
+        }
+
         // Symbols-only nerd font
         if (b.lazyDependency("nerd_fonts_symbols_only", .{})) |nf_symbols| {
             step.root_module.addAnonymousImport(
diff --git a/src/font/SharedGridSet.zig b/src/font/SharedGridSet.zig
index af5da0a26..f08c0b7d8 100644
--- a/src/font/SharedGridSet.zig
+++ b/src/font/SharedGridSet.zig
@@ -295,53 +295,16 @@ fn collection(
         },
     );
 
-    // On macOS, always search for and add the Apple Emoji font
-    // as our preferred emoji font for fallback. We do this in case
-    // people add other emoji fonts to their system, we always want to
-    // prefer the official one. Users can override this by explicitly
-    // specifying a font-family for emoji.
-    if (comptime builtin.target.os.tag.isDarwin() and Discover != void) apple_emoji: {
-        const disco = try self.discover() orelse break :apple_emoji;
-
-        // Fast path: we know the exact name of the font we want so we
-        // can look it up directly, which is sometimes significantly faster than
-        // full discovery (e.g. CoreText).
-        if (@hasDecl(Discover, "discoverExactFamily")) {
-            if (try disco.discoverExactFamily(
-                "Apple Color Emoji",
-            )) |face| {
-                _ = try c.addDeferred(self.alloc, face, .{
-                    .style = .regular,
-                    .fallback = true,
-                    // No size adjustment for emojis.
-                    .size_adjustment = .none,
-                });
-                break :apple_emoji;
-            }
-        }
-
-        var disco_it = try disco.discover(self.alloc, .{
-            .family = "Apple Color Emoji",
-        });
-        defer disco_it.deinit();
-        if (try disco_it.next()) |face| {
-            _ = try c.addDeferred(self.alloc, face, .{
-                .style = .regular,
-                .fallback = true,
-                // No size adjustment for emojis.
-                .size_adjustment = .none,
-            });
-        }
-    }
-
-    // Emoji fallback. We don't include this on Mac since Mac is expected
-    // to always have the Apple Emoji available on the system.
-    if (comptime !builtin.target.os.tag.isDarwin() or Discover == void) {
+    // Emoji fallback: Noto Color Emoji on every platform, macOS too, where
+    // upstream adds Apple Color Emoji instead, so emoji look as they do in
+    // hotty-blitz's surfaces, which draw the same file. Users can still pick
+    // another emoji font with font-family or font-codepoint-map.
+    {
         _ = try c.add(
             self.alloc,
             try .init(
                 self.font_lib,
-                font.embedded.emoji,
+                font.embedded.emoji_color,
                 load_options.faceOptions(),
             ),
             .{
@@ -813,3 +776,29 @@ test SharedGridSet {
     set.deref(key1);
     try testing.expectEqual(@as(usize, 0), set.count());
 }
+
+test "hottyterm: emoji draw from Noto Color Emoji, whatever the system has" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var set = try SharedGridSet.init(alloc);
+    defer set.deinit();
+
+    var cfg = try Config.default(alloc);
+    defer cfg.deinit();
+
+    var keycfg = try DerivedConfig.init(alloc, &cfg);
+    defer keycfg.deinit();
+
+    const key, const grid = try set.ref(&keycfg, .{ .points = 12 });
+    defer set.deref(key);
+
+    var buf: [256]u8 = undefined;
+    // 😀, ⚡ and 👍: emoji presentation, from the colour face.
+    for ([_]u32{ 0x1F600, 0x26A1, 0x1F44D }) |cp| {
+        const idx = (try grid.getIndex(alloc, cp, .regular, null)).?;
+        const face = try grid.resolver.collection.getFace(idx);
+        try testing.expectEqualStrings("Noto Color Emoji", try face.name(&buf));
+        try testing.expect(face.hasColor());
+    }
+}
diff --git a/src/font/embedded.zig b/src/font/embedded.zig
index bd8e51be9..61afc74ec 100644
--- a/src/font/embedded.zig
+++ b/src/font/embedded.zig
@@ -5,6 +5,8 @@
 //! Be careful to ensure that any fonts you embed are licensed for
 //! redistribution and include their license as necessary.
 
+const builtin = @import("builtin");
+
 /// The default font: Adwaita Mono, the monospace font hotty-blitz ships
 /// for surfaces, so the cells and the surfaces draw in one font.
 pub const default_regular = @embedFile("adwaita_mono_regular");
@@ -27,6 +29,13 @@ pub const bold_italic = @embedFile("jetbrains_mono_bold_italic");
 
 /// Emoji fonts
 pub const emoji = @embedFile("res/NotoColorEmoji.ttf");
+/// The colour emoji font the terminal draws from: Noto Color Emoji on every
+/// platform. CoreText draws no CBDT, so macOS embeds the same PNGs as sbix
+/// (hottyterm's scripts/noto-sbix.py, through HOTTYTERM_EMOJI_SBIX).
+pub const emoji_color = if (builtin.target.os.tag.isDarwin())
+    @embedFile("hottyterm_emoji_sbix")
+else
+    emoji;
 pub const emoji_text = @embedFile("res/NotoEmoji-Regular.ttf");
 
 // Fonts below are ONLY used for testing.
