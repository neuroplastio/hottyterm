diff --git a/src/renderer/hotty_layers.zig b/src/renderer/hotty_layers.zig
new file mode 100644
index 000000000..8da558753
--- /dev/null
+++ b/src/renderer/hotty_layers.zig
@@ -0,0 +1,439 @@
+//! hottyterm: hotty surfaces the apprt composites over the terminal's frame,
+//! as a browser composites layers. A change to one writes its pixels here
+//! and asks the apprt for a draw: no terminal frame is drawn for it. The
+//! renderer draws no quad for them, and tells the apprt where each one
+//! shows (`Geometry`) with every frame it exports, so a scroll moves them
+//! with the cells.
+//!
+//! Pixels are premultiplied RGBA, `w * 4` bytes a row, as hotty-blitz
+//! paints them. The apprt makes textures from a layer's buffers and holds a
+//! buffer while a texture of it lives: a write goes to a buffer the apprt
+//! does not hold, brought up to date first from the newest one with only
+//! what changed since it was the newest (`Buffer.stale`).
+//!
+//! The terminal's lock may be held when this mutex is taken, never the
+//! other way round.
+
+const std = @import("std");
+const global = @import("../global.zig");
+
+const alloc = std.heap.c_allocator;
+
+pub const Rect = extern struct { x: u32, y: u32, w: u32, h: u32 };
+
+/// Where a composited surface shows in a frame, in the frame's pixels.
+pub const Geometry = struct {
+    image_id: u32,
+    /// The placement's top left and size.
+    x: i32,
+    y: i32,
+    w: u32,
+    h: u32,
+    /// The part of the image it shows.
+    source_x: u32,
+    source_y: u32,
+    source_w: u32,
+    source_h: u32,
+};
+
+/// At most this many rectangles in a region: past it, their bounds.
+const MAX_RECTS = 16;
+
+pub const Region = struct {
+    rects: std.ArrayListUnmanaged(Rect) = .empty,
+
+    pub fn add(self: *Region, r: Rect) void {
+        if (r.w == 0 or r.h == 0) return;
+        if (self.rects.items.len >= MAX_RECTS) {
+            var b = r;
+            for (self.rects.items) |o| b = bounds(b, o);
+            self.rects.clearRetainingCapacity();
+            self.rects.appendAssumeCapacity(b);
+            return;
+        }
+        self.rects.append(alloc, r) catch {
+            // Out of memory: everything there is counts.
+            var b = r;
+            for (self.rects.items) |o| b = bounds(b, o);
+            self.rects.clearRetainingCapacity();
+            if (self.rects.capacity > 0) self.rects.appendAssumeCapacity(b);
+        };
+    }
+
+    fn deinit(self: *Region) void {
+        self.rects.deinit(alloc);
+    }
+};
+
+fn bounds(a: Rect, b: Rect) Rect {
+    const x0 = @min(a.x, b.x);
+    const y0 = @min(a.y, b.y);
+    const x1 = @max(a.x + a.w, b.x + b.w);
+    const y1 = @max(a.y + a.h, b.y + b.h);
+    return .{ .x = x0, .y = y0, .w = x1 - x0, .h = y1 - y0 };
+}
+
+/// A layer's pixels, as one of its buffers.
+pub const Buffer = struct {
+    data: []u8,
+    /// One for the layer while the buffer is one of its own, and one for
+    /// each texture the apprt made of it.
+    refs: std.atomic.Value(u32) = .init(1),
+    /// What changed since its pixels were the newest.
+    stale: Region = .{},
+
+    /// Lets go of a hold (`Layers.take`); the last frees it. Any thread.
+    pub fn release(self: *Buffer) void {
+        if (self.refs.fetchSub(1, .acq_rel) != 1) return;
+        alloc.free(self.data);
+        self.stale.deinit();
+        alloc.destroy(self);
+    }
+
+    fn free(self: *const Buffer) bool {
+        return self.refs.load(.acquire) == 1;
+    }
+};
+
+const Layer = struct {
+    image_id: u32,
+    w: u32,
+    h: u32,
+    bufs: std.ArrayListUnmanaged(*Buffer) = .empty,
+    newest: ?*Buffer = null,
+    /// What changed since the apprt last took the pixels.
+    pending: Region = .{},
+    /// Counts writes: what the apprt took is current while its version is
+    /// this one.
+    version: u64 = 1,
+    /// Seen by the sync under way (`keep`).
+    kept: bool = true,
+
+    fn deinit(self: *Layer) void {
+        for (self.bufs.items) |b| b.release();
+        self.bufs.deinit(alloc);
+        self.pending.deinit();
+    }
+
+    /// A buffer to write: one the apprt does not hold, else a new one.
+    /// When some go free again, more than three are let go.
+    fn writable(self: *Layer) ?*Buffer {
+        var pick: ?*Buffer = null;
+        var i: usize = 0;
+        while (i < self.bufs.items.len) {
+            const b = self.bufs.items[i];
+            if (b != self.newest and b.free()) {
+                if (pick == null) {
+                    pick = b;
+                } else if (self.bufs.items.len > 3) {
+                    _ = self.bufs.swapRemove(i);
+                    b.release();
+                    continue;
+                }
+            }
+            i += 1;
+        }
+        if (pick) |b| return b;
+        const b = alloc.create(Buffer) catch return null;
+        const data = alloc.alloc(u8, @as(usize, self.w) * self.h * 4) catch {
+            alloc.destroy(b);
+            return null;
+        };
+        b.* = .{ .data = data };
+        self.bufs.append(alloc, b) catch {
+            b.release();
+            return null;
+        };
+        // All of it is to be filled.
+        b.stale.add(.{ .x = 0, .y = 0, .w = self.w, .h = self.h });
+        return b;
+    }
+
+    /// Writes `rects` of `frame` (premultiplied, rows `stride` apart), or
+    /// all of it.
+    fn write(self: *Layer, frame: []const u8, stride: usize, rects: []const Rect, full: bool) bool {
+        const whole = [_]Rect{.{ .x = 0, .y = 0, .w = self.w, .h = self.h }};
+        const rs: []const Rect = if (full) &whole else rects;
+        const b = self.writable() orelse return false;
+        // Up to date first with what changed since it was the newest, unless
+        // all of it is written now.
+        if (!full) if (self.newest) |n| {
+            for (b.stale.rects.items) |r| copy(b.data, self.w, n.data, self.w * 4, r);
+        };
+        b.stale.rects.clearRetainingCapacity();
+        for (rs) |r| copy(b.data, self.w, frame, stride, r);
+        for (self.bufs.items) |o| if (o != b) for (rs) |r| o.stale.add(r);
+        for (rs) |r| self.pending.add(r);
+        self.newest = b;
+        self.version +%= 1;
+        return true;
+    }
+};
+
+fn copy(dst: []u8, w: u32, src: []const u8, stride: usize, r: Rect) void {
+    const row = @as(usize, r.w) * 4;
+    const dst_stride = @as(usize, w) * 4;
+    var y: usize = 0;
+    while (y < r.h) : (y += 1) {
+        const at = (r.y + y);
+        @memcpy(
+            dst[at * dst_stride + @as(usize, r.x) * 4 ..][0..row],
+            src[at * stride + @as(usize, r.x) * 4 ..][0..row],
+        );
+    }
+}
+
+pub const Layers = struct {
+    mutex: std.Io.Mutex = .init,
+    /// Whether the apprt composites: set by it once, before any frame.
+    enabled: std.atomic.Value(bool) = .init(false),
+    /// Surface name (owned) → its layer.
+    layers: std.StringHashMapUnmanaged(Layer) = .empty,
+    /// Whether the sync under way made or let go of a layer.
+    synced: bool = false,
+    /// How the apprt is told a layer has new pixels, when not by a redraw.
+    notifier: ?Notifier = null,
+
+    pub const Notifier = struct {
+        ctx: *anyopaque,
+        /// Called under the lock: it only asks for a draw.
+        f: *const fn (*anyopaque) void,
+    };
+
+    pub fn setNotifier(self: *Layers, n: ?Notifier) void {
+        self.lock();
+        defer self.unlock();
+        self.notifier = n;
+    }
+
+    /// Tells the apprt a layer has new pixels: false when it has no
+    /// notifier and wants a redraw.
+    pub fn notify(self: *Layers) bool {
+        self.lock();
+        defer self.unlock();
+        const n = self.notifier orelse return false;
+        n.f(n.ctx);
+        return true;
+    }
+
+    pub fn deinit(self: *Layers) void {
+        var it = self.layers.iterator();
+        while (it.next()) |e| {
+            alloc.free(e.key_ptr.*);
+            e.value_ptr.deinit();
+        }
+        self.layers.deinit(alloc);
+    }
+
+    fn lock(self: *Layers) void {
+        self.mutex.lockUncancelable(global.io());
+    }
+
+    fn unlock(self: *Layers) void {
+        self.mutex.unlock(global.io());
+    }
+
+    pub fn on(self: *const Layers) bool {
+        return self.enabled.load(.acquire);
+    }
+
+    /// A frame of surface `name`: true if it is a layer and took it. One
+    /// of another size is taken only whole.
+    pub fn write(self: *Layers, name: []const u8, w: u32, h: u32, frame: []const u8, stride: usize, rects: []const Rect, full: bool) bool {
+        if (!self.on()) return false;
+        self.lock();
+        defer self.unlock();
+        const l = self.layers.getPtr(name) orelse return false;
+        for (rects) |r| if (@as(u64, r.x) + r.w > w or @as(u64, r.y) + r.h > h) return false;
+        if (l.w != w or l.h != h) {
+            if (!full) return false;
+            for (l.bufs.items) |b| b.release();
+            l.bufs.clearRetainingCapacity();
+            l.newest = null;
+            l.w = w;
+            l.h = h;
+        }
+        return l.write(frame, stride, rects, full);
+    }
+
+    /// Starts a sync: what `keep` does not name by `endSync` is let go.
+    pub fn beginSync(self: *Layers) void {
+        self.lock();
+        self.synced = false;
+        var it = self.layers.valueIterator();
+        while (it.next()) |l| l.kept = false;
+    }
+
+    /// Surface `name` is a layer, of image `image_id`, `w` by `h`. If it is
+    /// new, its pixels are `straight`'s (straight alpha), premultiplied.
+    pub fn keep(self: *Layers, name: []const u8, image_id: u32, w: u32, h: u32, straight: []const u8) void {
+        if (self.layers.getPtr(name)) |l| {
+            l.kept = true;
+            l.image_id = image_id;
+            return;
+        }
+        if (straight.len != @as(usize, w) * h * 4) return;
+        const owned = alloc.dupe(u8, name) catch return;
+        var l: Layer = .{ .image_id = image_id, .w = w, .h = h };
+        const b = l.writable() orelse {
+            alloc.free(owned);
+            return;
+        };
+        @memcpy(b.data, straight);
+        premultiply(b.data);
+        b.stale.rects.clearRetainingCapacity();
+        l.newest = b;
+        self.layers.put(alloc, owned, l) catch {
+            alloc.free(owned);
+            l.deinit();
+            return;
+        };
+        self.synced = true;
+    }
+
+    /// Whether `name` is a layer (within a sync).
+    pub fn has(self: *Layers, name: []const u8) bool {
+        return self.layers.contains(name);
+    }
+
+    /// Lets go of surface `name`'s layer (within a sync).
+    pub fn drop(self: *Layers, name: []const u8) void {
+        const kv = self.layers.fetchRemove(name) orelse return;
+        alloc.free(kv.key);
+        var l = kv.value;
+        l.deinit();
+        self.synced = true;
+    }
+
+    /// Ends a sync: true if the layers are not the ones before it.
+    pub fn endSync(self: *Layers) bool {
+        defer self.unlock();
+        var changed = self.synced;
+        var again = true;
+        while (again) {
+            again = false;
+            var it = self.layers.iterator();
+            while (it.next()) |e| {
+                if (e.value_ptr.kept) continue;
+                const key = e.key_ptr.*;
+                e.value_ptr.deinit();
+                self.layers.removeByPtr(e.key_ptr);
+                alloc.free(key);
+                changed = true;
+                again = true;
+                break;
+            }
+        }
+        return changed;
+    }
+
+    /// Whether image `image_id` is a layer's.
+    pub fn composited(self: *Layers, image_id: u32) bool {
+        if (!self.on()) return false;
+        self.lock();
+        defer self.unlock();
+        var it = self.layers.valueIterator();
+        while (it.next()) |l| if (l.image_id == image_id) return true;
+        return false;
+    }
+
+    pub const Taken = struct {
+        /// Held for the caller, who releases it.
+        buffer: *Buffer,
+        w: u32,
+        h: u32,
+        version: u64,
+        /// What changed since the caller last took them; the whole of it
+        /// when `None` came before.
+        changed: []const Rect,
+    };
+
+    /// Image `image_id`'s newest pixels, if their version is not
+    /// `version`. `changed` is valid until the next call. Main thread.
+    pub fn take(self: *Layers, image_id: u32, version: u64, changed: *std.ArrayListUnmanaged(Rect)) ?Taken {
+        self.lock();
+        defer self.unlock();
+        var it = self.layers.valueIterator();
+        while (it.next()) |l| {
+            if (l.image_id != image_id) continue;
+            if (l.version == version) return null;
+            const b = l.newest orelse return null;
+            _ = b.refs.fetchAdd(1, .acq_rel);
+            changed.clearRetainingCapacity();
+            changed.appendSlice(alloc, l.pending.rects.items) catch {
+                changed.clearRetainingCapacity();
+                changed.append(alloc, .{ .x = 0, .y = 0, .w = l.w, .h = l.h }) catch {};
+            };
+            l.pending.rects.clearRetainingCapacity();
+            return .{ .buffer = b, .w = l.w, .h = l.h, .version = l.version, .changed = changed.items };
+        }
+        return null;
+    }
+
+    pub fn freeRects(list: *std.ArrayListUnmanaged(Rect)) void {
+        list.deinit(alloc);
+    }
+};
+
+fn premultiply(px: []u8) void {
+    var i: usize = 0;
+    while (i + 4 <= px.len) : (i += 4) {
+        const a: u32 = px[i + 3];
+        if (a == 255) continue;
+        inline for (0..3) |c| px[i + c] = @intCast((@as(u32, px[i + c]) * a + 127) / 255);
+    }
+}
+
+test "a write goes to a buffer the apprt does not hold, brought up to date" {
+    var ls: Layers = .{};
+    defer ls.deinit();
+    ls.enabled.store(true, .release);
+    const w = 4;
+    const h = 2;
+    var px: [w * h * 4]u8 = @splat(255);
+    ls.beginSync();
+    ls.keep("s", 7, w, h, &px);
+    _ = ls.endSync();
+
+    var changed: std.ArrayListUnmanaged(Rect) = .empty;
+    defer Layers.freeRects(&changed);
+    const first = ls.take(7, 0, &changed).?;
+    // Held: the next write goes elsewhere.
+    var frame: [w * h * 4]u8 = @splat(0);
+    try std.testing.expect(ls.write("s", w, h, &frame, w * 4, &.{.{ .x = 1, .y = 0, .w = 1, .h = 1 }}, false));
+    const second = ls.take(7, first.version, &changed).?;
+    try std.testing.expect(second.buffer != first.buffer);
+    try std.testing.expectEqualSlices(Rect, &.{.{ .x = 1, .y = 0, .w = 1, .h = 1 }}, second.changed);
+    // The rest is as it was.
+    try std.testing.expectEqual(@as(u8, 255), second.buffer.data[0]);
+    try std.testing.expectEqual(@as(u8, 0), second.buffer.data[4]);
+    // Nothing new: nothing to take.
+    try std.testing.expect(ls.take(7, second.version, &changed) == null);
+    first.buffer.release();
+    // The first is free again: written next, with what it missed.
+    try std.testing.expect(ls.write("s", w, h, &frame, w * 4, &.{.{ .x = 2, .y = 1, .w = 1, .h = 1 }}, false));
+    const third = ls.take(7, second.version, &changed).?;
+    try std.testing.expect(third.buffer == first.buffer);
+    try std.testing.expectEqual(@as(u8, 0), third.buffer.data[4]);
+    try std.testing.expectEqual(@as(u8, 0), third.buffer.data[(1 * w + 2) * 4]);
+    try std.testing.expectEqual(@as(u8, 255), third.buffer.data[(1 * w + 3) * 4]);
+    second.buffer.release();
+    third.buffer.release();
+}
+
+test "a sync lets go of what it does not keep" {
+    var ls: Layers = .{};
+    defer ls.deinit();
+    ls.enabled.store(true, .release);
+    var px: [4]u8 = .{ 255, 0, 0, 128 };
+    ls.beginSync();
+    ls.keep("a", 1, 1, 1, &px);
+    ls.keep("b", 2, 1, 1, &px);
+    try std.testing.expect(ls.endSync());
+    try std.testing.expect(ls.composited(1));
+    ls.beginSync();
+    ls.keep("b", 2, 1, 1, &px);
+    try std.testing.expect(ls.endSync());
+    try std.testing.expect(!ls.composited(1));
+    try std.testing.expect(ls.composited(2));
+}
