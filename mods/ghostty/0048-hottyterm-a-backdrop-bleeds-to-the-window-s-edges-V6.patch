     entry.image.update.free(alloc);
     _ = state.images.remove(id);
 }
+
+test "hottyterm: a backdrop bleeds past the grid's edges it reaches" {
+    const testing = std.testing;
+    // 191x55 cells of 15x33 in a window 2874x1845 with no padding: 9
+    // pixels left over at the right and 30 at the bottom.
+    const b: State.Bleed = .{
+        .cell_width = 15,
+        .cell_height = 33,
+        .grid_width = 191 * 15,
+        .grid_height = 55 * 33,
+        .left = 0,
+        .top = 0,
+        .right = 2874,
+        .bottom = 1845,
+    };
+    const full: Placement = .{
+        .image_id = .{ .kitty = 1 },
+        .layer = .below_background,
+        .x = 0,
+        .y = 0,
+        .z = 0,
+        .width = 191 * 15,
+        .height = 55 * 33,
+        .cell_offset_x = 0,
+        .cell_offset_y = 0,
+        .source_x = 0,
+        .source_y = 0,
+        .source_width = 191 * 15,
+        .source_height = 55 * 33,
+        .backdrop = true,
+    };
+    const qs = State.bleedQuads(b, full);
+    var drawn: usize = 0;
+    for (qs) |q| drawn += @intFromBool(q != null);
+    // The right strip, the bottom strip and their corner.
+    try testing.expectEqual(@as(usize, 3), drawn);
+    // Parts in order: the three above, left and right, the three below.
+    // The right strip: the last column's middle, all the way down.
+    const right = qs[4].?;
+    try testing.expectEqual([2]f32{ 2865, 0 }, right.cell_offset);
+    try testing.expectEqual([2]f32{ 9, 1815 }, right.dest_size);
+    try testing.expectEqual([4]f32{ 2864.5, 0, 0, 1815 }, right.source_rect);
+    // The bottom strip: the last row's middle, all the way across.
+    const bottom = qs[6].?;
+    try testing.expectEqual([2]f32{ 0, 1815 }, bottom.cell_offset);
+    try testing.expectEqual([2]f32{ 2865, 30 }, bottom.dest_size);
+    try testing.expectEqual([4]f32{ 0, 1814.5, 2865, 0 }, bottom.source_rect);
+    // Their corner: the corner pixel's middle.
+    const corner = qs[7].?;
+    try testing.expectEqual([2]f32{ 2865, 1815 }, corner.cell_offset);
+    try testing.expectEqual([2]f32{ 9, 30 }, corner.dest_size);
+    try testing.expectEqual([4]f32{ 2864.5, 1814.5, 0, 0 }, corner.source_rect);
+
+    // With 10 pixels of padding all round, 190x55 cells: every side and
+    // corner.
+    var padded = b;
+    padded.grid_width = 190 * 15;
+    padded.left = -10;
+    padded.top = -10;
+    padded.right = 2874 - 10;
+    padded.bottom = 1845 - 10;
+    var fits = full;
+    fits.width = 190 * 15;
+    fits.source_width = 190 * 15;
+    drawn = 0;
+    for (State.bleedQuads(padded, fits)) |q| drawn += @intFromBool(q != null);
+    try testing.expectEqual(@as(usize, 8), drawn);
+    const top_left = State.bleedQuads(padded, fits)[0].?;
+    try testing.expectEqual([2]f32{ -10, -10 }, top_left.cell_offset);
+    try testing.expectEqual([2]f32{ 10, 10 }, top_left.dest_size);
+    try testing.expectEqual([4]f32{ 0.5, 0.5, 0, 0 }, top_left.source_rect);
+    const bottom_right = State.bleedQuads(padded, fits)[7].?;
+    try testing.expectEqual([2]f32{ 2850, 1815 }, bottom_right.cell_offset);
+    try testing.expectEqual([2]f32{ 14, 20 }, bottom_right.dest_size);
+
+    // A backdrop that reaches no edge doesn't bleed.
+    var inner = full;
+    inner.x = 2;
+    inner.y = 1;
+    inner.width = 10 * 15;
+    inner.height = 4 * 33;
+    for (State.bleedQuads(padded, inner)) |q| try testing.expect(q == null);
+}
diff --git a/src/termio/hotty.zig b/src/termio/hotty.zig
index 89a121761..195f66441 100644
--- a/src/termio/hotty.zig
+++ b/src/termio/hotty.zig
@@ -1049,6 +1049,14 @@ pub const Hotty = struct {
         return (band << 20) | @as(i32, @intCast(created & 0xFFFFF));
     }
 
+    /// Whether a kitty placement is a backdrop's: a surface's image, at a
+    /// z under kitty's line for images below the cells' backgrounds
+    /// (stackZ). The renderer bleeds it into the window's padding.
+    pub fn isBackdrop(image_id: u32, z: i32) bool {
+        return image_id >= id_base and image_id - id_base < id_span and
+            z < std.math.minInt(i32) / 2;
+    }
+
     /// The cursor goes to the start of the line below a placement `rows`
     /// tall, scrolling as needed (the polyfill does the same).
     fn moveCursor(t: *terminal.Terminal, rows: u16) void {
@@ -3450,3 +3458,20 @@ test "Hotty.stackZ backdrops" {
     try t.expect(Hotty.stackZ(-1, 5, true) < Hotty.stackZ(0, 0, true));
     try t.expect(Hotty.stackZ(0, 4, true) < Hotty.stackZ(0, 5, true));
 }
+
+test "Hotty.isBackdrop" {
+    const t = std.testing;
+    // A surface's backdrop placement, at every z and creation.
+    for ([_]i32{ -1000, 0, 1000 }) |z| {
+        for ([_]u32{ 0, 0x7FFFF }) |c| {
+            try t.expect(Hotty.isBackdrop(id_base, Hotty.stackZ(z, c, true)));
+            try t.expect(Hotty.isBackdrop(id_base + id_span - 1, Hotty.stackZ(z, c, true)));
+            // Not a surface's placement above the cells.
+            try t.expect(!Hotty.isBackdrop(id_base, Hotty.stackZ(z, c, false)));
+        }
+    }
+    // Not a program's own kitty image under the backgrounds.
+    try t.expect(!Hotty.isBackdrop(7, std.math.minInt(i32)));
+    try t.expect(!Hotty.isBackdrop(id_base - 1, std.math.minInt(i32)));
+    try t.expect(!Hotty.isBackdrop(id_base + id_span, std.math.minInt(i32)));
+}
