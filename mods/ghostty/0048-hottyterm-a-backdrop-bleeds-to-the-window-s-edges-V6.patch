+            // hottyterm: a backdrop goes on past the grid (Bleed).
+            if (placement_type == .kitty_below_bg and p.backdrop) {
+                for (bleedQuads(self.bleed, p)) |q| {
+                    if (q) |quad| drawQuad(api, pipeline, pass, texture, quad);
