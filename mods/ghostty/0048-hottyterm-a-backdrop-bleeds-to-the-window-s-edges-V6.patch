+
+    /// Draws one image quad.
+    fn drawQuad(
+        api: *GraphicsAPI,
+        pipeline: GraphicsAPI.Pipeline,
+        pass: *GraphicsAPI.RenderPass,
+        texture: Texture,
+        quad: GraphicsAPI.shaders.Image,
+    ) void {
+        // Create our vertex buffer, which is always exactly one item.
+        // future(mitchellh): we can group rendering multiple instances of a single image
+        var buf = GraphicsAPI.Buffer(GraphicsAPI.shaders.Image).initFill(
+            api.imageBufferOptions(),
+            &.{quad},
+        ) catch |err| {
+            log.warn("error creating image vertex buffer err={}", .{err});
+            return;
+        };
+        defer buf.deinit();
+
+        pass.step(.{
+            .pipeline = pipeline,
+            .buffers = &.{buf.buffer},
+            .textures = &.{texture},
+            .draw = .{
+                .type = .triangle_strip,
+                .vertex_count = 4,
+            },
+        });
+    }
+
+    /// hottyterm: the quads a backdrop bleeds in (Bleed): past each edge of
+    /// the grid it reaches, to the window's edge, a strip of its outermost
+    /// pixels, and in a corner its corner pixel. Each samples the middle of
+    /// those pixels, so the strip is their colour exactly. Null for a part
+    /// with nothing to draw.
+    fn bleedQuads(b: Bleed, p: Placement) [8]?GraphicsAPI.shaders.Image {
+        var out: [8]?GraphicsAPI.shaders.Image = @splat(null);
+        if (b.cell_width <= 0 or b.cell_height <= 0) return out;
+        const x0 = @as(f32, @floatFromInt(p.x)) * b.cell_width + @as(f32, @floatFromInt(p.cell_offset_x));
+        const y0 = @as(f32, @floatFromInt(p.y)) * b.cell_height + @as(f32, @floatFromInt(p.cell_offset_y));
+        const x1 = x0 + @as(f32, @floatFromInt(p.width));
+        const y1 = y0 + @as(f32, @floatFromInt(p.height));
+        // The parts across and down: before the placement, the placement,
+        // and after it, each as far as the window where it reaches the
+        // grid's edge (half a pixel is rounding), else empty.
+        const xs = [3][2]f32{
+            .{ if (x0 <= 0.5) @min(b.left, x0) else x0, x0 },
+            .{ x0, x1 },
+            .{ x1, if (x1 >= b.grid_width - 0.5) @max(b.right, x1) else x1 },
+        };
+        const ys = [3][2]f32{
+            .{ if (y0 <= 0.5) @min(b.top, y0) else y0, y0 },
+            .{ y0, y1 },
+            .{ y1, if (y1 >= b.grid_height - 0.5) @max(b.bottom, y1) else y1 },
+        };
+        // The source across and down for each: the first pixels' middle,
+        // all of it, the last pixels' middle.
+        const sx: f32 = @floatFromInt(p.source_x);
+        const sy: f32 = @floatFromInt(p.source_y);
+        const sw: f32 = @floatFromInt(p.source_width);
+        const sh: f32 = @floatFromInt(p.source_height);
+        const us = [3][2]f32{ .{ sx + 0.5, 0 }, .{ sx, sw }, .{ sx + sw - 0.5, 0 } };
+        const vs = [3][2]f32{ .{ sy + 0.5, 0 }, .{ sy, sh }, .{ sy + sh - 0.5, 0 } };
+        var n: usize = 0;
+        for (0..3) |j| {
+            for (0..3) |i| {
+                if (i == 1 and j == 1) continue; // the placement itself
+                const k = n;
+                n += 1;
+                const w = xs[i][1] - xs[i][0];
+                const h = ys[j][1] - ys[j][0];
+                if (w <= 0 or h <= 0) continue;
+                out[k] = .{
+                    .grid_pos = .{ 0, 0 },
+                    .cell_offset = .{ xs[i][0], ys[j][0] },
+                    .source_rect = .{ us[i][0], vs[j][0], us[i][1], vs[j][1] },
+                    .dest_size = .{ w, h },
+                };
+            }
         }
+        return out;
     }
 
     /// Update our overlay state. Null value deletes any existing overlay.
@@ -347,6 +440,7 @@ pub const State = struct {
                 .source_y = p.source_y,
                 .source_width = p.source_width,
