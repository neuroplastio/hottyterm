@@ -1958,6 +1958,20 @@ pub fn Renderer(comptime GraphicsAPI: type) type {
 
                 // Then we draw any kitty images that need
                 // to be behind text AND cell backgrounds.
+                // hottyterm: a hotty backdrop among them bleeds to the
+                // window's edges (image.State.Bleed), which are here in
+                // pixels from the grid's top left, as the projection puts
+                // the grid's top left at the padding's.
+                self.images.bleed = .{
+                    .cell_width = @floatFromInt(self.grid_metrics.cell_width),
+                    .cell_height = @floatFromInt(self.grid_metrics.cell_height),
+                    .grid_width = @floatFromInt(@as(u32, self.cells.size.columns) * self.grid_metrics.cell_width),
+                    .grid_height = @floatFromInt(@as(u32, self.cells.size.rows) * self.grid_metrics.cell_height),
+                    .left = -@as(f32, @floatFromInt(self.size.padding.left)),
+                    .top = -@as(f32, @floatFromInt(self.size.padding.top)),
+                    .right = @as(f32, @floatFromInt(self.size.screen.width)) - @as(f32, @floatFromInt(self.size.padding.left)),
+                    .bottom = @as(f32, @floatFromInt(self.size.screen.height)) - @as(f32, @floatFromInt(self.size.padding.top)),
+                };
                 self.images.draw(
                     &self.api,
                     self.shaders.pipelines.image,
