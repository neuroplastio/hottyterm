+    fn clickCount(self: *Hotty, kind: PointerKind, pos: apprt.CursorPos, interval: u64, distance: f32) u32 {
+        switch (kind) {
+            .up => return if (self.last_press) |p| p.count else 1,
+            .down => {},
+            else => return 0,
+        }
+        const now = std.Io.Timestamp.now(global.io(), .awake);
+        const n: u32 = if (self.platform_count > 0) self.platform_count else n: {
+            const p = self.last_press orelse break :n 1;
+            const since = p.time.durationTo(now).toNanoseconds();
+            if (since < 0 or since > interval) break :n 1;
+            const dx = pos.x - p.x;
+            const dy = pos.y - p.y;
+            if (@sqrt(dx * dx + dy * dy) > distance) break :n 1;
+            break :n p.count + 1;
+        };
+        self.platform_count = 0;
+        self.last_press = .{ .time = now, .x = pos.x, .y = pos.y, .count = n };
+        return n;
+    }
