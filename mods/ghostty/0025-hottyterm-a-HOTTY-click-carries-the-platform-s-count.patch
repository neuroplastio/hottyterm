+/// The apprt's count of the press it is about to hand over in a run of
+/// clicks (GTK's n_press): the platform's, by the user's own settings,
+/// which a click on a surface carries (SPEC §9). An apprt that hands none
+/// over leaves the press to be counted as Ghostty counts one.
+pub fn surfaceClickCount(s: *Surface, n: c_int) void {
+    s.renderer_state.mutex.lockUncancelable(global.io());
+    defer s.renderer_state.mutex.unlock(global.io());
+    s.io.terminal_stream.handler.hotty.platform_count = @intCast(@max(n, 0));
+}
