+    /// A secondary press at viewport pixel (`px`, `py`) (SPEC §9): true if
+    /// a surface took it. Not while the program holds the pointer, nor over
+    /// the cells.
+    fn secondaryPress(self: *Hotty, t: *terminal.Terminal, px: f64, py: f64, mods: u32) bool {
+        self.secondary_down = false;
+        const h = self.hostReady() orelse return false;
+        const tg = (if (self.program_hold) null else self.hit(t, px, py)) orelse return false;
+        var name_buf: [73]u8 = undefined;
+        const name = std.mem.printSentinel(&name_buf, "{s}", .{tg.name}, 0) catch return false;
+        const fx = self.effects();
+        const took = hotty_host_secondary(h, name.ptr, tg.x, tg.y, mods, &fx);
+        if (self.render(t)) self.drew = true;
+        self.secondary_down = took;
+        return took;
+    }
