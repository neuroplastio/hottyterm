     /// A finger at viewport pixel (`px`, `py`) (SPEC §9.1, §9.6). A touch
     /// that begins over a surface that takes the pointer there is that
     /// surface's to decide, every phase of it, taps included, and
@@ -2981,6 +3001,7 @@ pub fn surfaceButton(s: *Surface, action: input.MouseButtonState, button: input.
         hs.program_hold = programHolds(hs.program_hold, first, false, any_down);
         return false;
     };
+    if (button == .right and secondaryButton(s, action, pos, mods)) return true;
     const was = hs.program_hold;
     const alt = altPress(action, first, mods);
     const took = button == .left and !alt and pointerAt(s, if (action == .press) .down else .up, pos, mods);
@@ -2992,6 +3013,37 @@ pub fn surfaceButton(s: *Surface, action: input.MouseButtonState, button: input.
     return took;
 }
 
+/// Surface.mouseButtonCallback, for the secondary button (SPEC §9): a press
+/// on an element that takes it is the surface's, and so is the release after
+/// it. Neither reaches the program or `right-click-action`, and Ghostty's
+/// own state of the button is as if it had not been pressed. A press no
+/// surface takes goes on as Ghostty would have it: Shift's menu, Alt's
+/// report, `right-click-action`.
+fn secondaryButton(s: *Surface, action: input.MouseButtonState, pos: apprt.CursorPos, mods: input.Mods) bool {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    const coord: rendererpkg.Coordinate = .{ .surface = .{ .x = pos.x, .y = pos.y } };
+    const tp = coord.convert(.terminal, s.size).terminal;
+    var drew = false;
+    const took = took: {
+        lockState(s, @src());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const took = switch (action) {
+            .press => hs.secondaryPress(&s.io.terminal, tp.x, tp.y, hostMods(mods)),
+            .release => rel: {
+                const was = hs.secondary_down;
+                hs.secondary_down = false;
+                break :rel was;
+            },
+        };
+        drew = hs.drew;
+        hs.drew = false;
+        break :took took;
+    };
+    if (took) s.mouse.click_state[@intFromEnum(input.MouseButton.right)] = .release;
+    deliver(s, took or drew);
+    return took;
+}
+
