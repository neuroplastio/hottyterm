 //! Be careful to ensure that any fonts you embed are licensed for
 //! redistribution and include their license as necessary.
 
-/// Default fonts that we prefer for Ghostty.
+/// The default font: Adwaita Mono, the monospace font hotty-blitz ships
+/// for surfaces, so the cells and the surfaces draw in one font.
+pub const default_regular = @embedFile("adwaita_mono_regular");
+pub const default_bold = @embedFile("adwaita_mono_bold");
+pub const default_italic = @embedFile("adwaita_mono_italic");
+pub const default_bold_italic = @embedFile("adwaita_mono_bold_italic");
+
+/// Upstream's default fonts, now used only by tests.
