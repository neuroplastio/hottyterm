+        // OpenMoji, the emoji fonts: the colour one in the format the
+        // platform's rasterizer draws (CoreText sbix, FreeType CBDT), and
+        // the black one for text presentation.
+        if (b.lazyDependency("openmoji", .{})) |openmoji| {
+            const colour = if (target.result.os.tag.isDarwin())
+                "OpenMoji-color-sbix/OpenMoji-color-sbix.ttf"
+            else
+                "OpenMoji-color-cbdt/OpenMoji-color-cbdt.ttf";
+            step.root_module.addAnonymousImport(
+                "openmoji_color",
+                .{ .root_source_file = openmoji.path(colour) },
+            );
+            step.root_module.addAnonymousImport(
+                "openmoji_black",
+                .{ .root_source_file = openmoji.path("OpenMoji-black-glyf/OpenMoji-black-glyf.ttf") },
+            );
+        }
+
