+
+test "hottyterm: emoji draw from OpenMoji, whatever the system has" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var set = try SharedGridSet.init(alloc);
+    defer set.deinit();
+
+    var cfg = try Config.default(alloc);
+    defer cfg.deinit();
+
+    var keycfg = try DerivedConfig.init(alloc, &cfg);
+    defer keycfg.deinit();
+
+    const key, const grid = try set.ref(&keycfg, .{ .points = 12 });
+    defer set.deref(key);
+
+    var buf: [256]u8 = undefined;
+    // 😀, ⚡ and 👍: emoji presentation, from the colour face.
+    for ([_]u32{ 0x1F600, 0x26A1, 0x1F44D }) |cp| {
+        const idx = (try grid.getIndex(alloc, cp, .regular, null)).?;
+        const face = try grid.resolver.collection.getFace(idx);
+        try testing.expectEqualStrings("OpenMoji", try face.name(&buf));
+        try testing.expect(face.hasColor());
+    }
+    // 😀 asked for as text, from the black face.
+    const idx = (try grid.getIndex(alloc, 0x1F600, .regular, .text)).?;
+    const face = try grid.resolver.collection.getFace(idx);
+    try testing.expectEqualStrings("OpenMoji", try face.name(&buf));
+    try testing.expect(!face.hasColor());
+}
