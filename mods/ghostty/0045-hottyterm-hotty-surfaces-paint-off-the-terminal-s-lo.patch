+    /// Asks the paint thread to repaint what is dirty, the renderer held
+    /// until it is in. Without a paint thread, paints here. The caller
+    /// holds the lock and has the host.
+    fn wantPaint(self: *Hotty, t: *terminal.Terminal) void {
+        const sh = self.streamHandler();
+        // Without a paint thread, the lock stays held, so nothing shows the
+        // cells beside the pixels before them.
+        if (self.paint_thread == null) {
+            if (self.render(t)) sh.queueRender() catch {};
+            return;
+        }
+        self.holdRenderer(false);
