+    /// The paint thread: repaints what is dirty when asked (`wantPaint`),
+    /// with the lock let go while hotty-blitz paints (`renderUnlocked`),
+    /// then shows it and tells the program, as `tick` does.
+    fn paintLoop(self: *Hotty) void {
+        const sh = self.streamHandler();
+        const io = global.io();
+        const mutex = sh.renderer_state.mutex;
+        mutex.lockUncancelable(io);
+        defer mutex.unlock(io);
+        while (true) {
+            while (!self.paint_quit and (!self.paint_wanted or self.painting or self.host_waiters > 0))
+                self.host_cond.waitUncancelable(io, mutex);
+            if (self.paint_quit) return;
+            self.paint_wanted = false;
+            // This paint covers every update ended so far.
+            self.hold_wanted = false;
+            const t = sh.terminal;
+            var drew = false;
+            if (self.host) |h| paint: {
+                // A batch begun since waits for its own end.
+                if (t.modes.get(.synchronized_output)) break :paint;
+                if (hotty_host_has_dirty(h)) {
+                    drew = self.renderUnlocked(t);
+                    break :paint;
+                }
+                // What a resize told the program (`caps`), with nothing to draw.
+                const fx = self.effects();
