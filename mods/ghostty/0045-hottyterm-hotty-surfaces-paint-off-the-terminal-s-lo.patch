+            // The surfaces are in: the renderer shows them, unless an
+            // update ended meanwhile, whose paint is next.
+            if (!self.hold_wanted) self.unhold();
+            if (drew) sh.queueRender() catch {};
+            // The IO thread sends the replies (`tick`): a full mailbox
+            // would block this thread, and the loop may have stopped.
+            if (self.replies.items.len > 0) {
+                if (self.wakeup) |*w| w.notify() catch {};
+            }
+            self.schedule(t);
+        }
+    }
