+    fn unhold(self: *Hotty) void {
+        self.hold_wanted = false;
+        const sh = self.streamHandler();
+        if (!sh.renderer_state.hotty_hold) return;
+        sh.renderer_state.hotty_hold = false;
+        sh.queueRender() catch {};
+    }
+
+    /// The longest the renderer is held (`holdRenderer`).
+    const hold_max_ms = 100;
+    /// After a hold gives up, how long until the next may start.
+    const hold_off_ms = 20;
