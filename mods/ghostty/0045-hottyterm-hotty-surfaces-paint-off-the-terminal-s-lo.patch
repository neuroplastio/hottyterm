+    /// Holds what the renderer shows until the paint thread's next paint is
+    /// in, as the terminal's lock held it while the stream painted: one
+    /// frame shows the cells and the surfaces drawn for them, not the cells
+    /// first and the surfaces a refresh later. `update`: past that paint
+    /// too, until one covers the update that ended (`hold_wanted`). After
+    /// `hold_max_ms` held, it shows what it has, and isn't held again for a
+    /// frame, so that it does.
+    fn holdRenderer(self: *Hotty, update: bool) void {
+        const state = self.streamHandler().renderer_state;
+        const now = std.Io.Timestamp.now(global.io(), .awake).nanoseconds;
+        if (now < self.hold_off_until) return;
+        if (!state.hotty_hold) {
+            self.hold_since = now;
+        } else if (now - self.hold_since >= hold_max_ms * std.time.ns_per_ms) {
+            self.unhold();
+            self.hold_off_until = now + hold_off_ms * std.time.ns_per_ms;
+            return;
+        }
+        if (update) self.hold_wanted = true;
+        state.hotty_hold = true;
+    }
