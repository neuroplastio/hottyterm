From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Tue, 3 Nov 2026 18:43:19 +0100
Subject: [PATCH 50/54] terminal/kitty: an image can be kept through eviction

An embedder that draws part of its own interface as kitty images (a
panel, an overlay) loses it when a client's images fill the storage:
eviction takes the oldest images first, and those are the interface's,
which no client will ever send again.

Image.evictable (default true) lets the embedder mark such an image.
Eviction passes over it, for addImage, animation frames and a lowered
limit alike, and evicts the other images first. The image still counts
toward the storage limit, so the limit still bounds memory: when only
kept images are left and a new image does not fit, the new image fails
as one over the limit does. A retransmission of the ID resets the flag,
since the new image is the client's.

Lines added outside tests: graphics_image.zig 6, graphics_storage.zig 1.
Test: eviction order with a kept image, and failure when only kept
images are left (graphics_storage).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/terminal/kitty/graphics_image.zig   |  6 +++
 src/terminal/kitty/graphics_storage.zig | 66 +++++++++++++++++++++++++
 2 files changed, 72 insertions(+)

diff --git a/src/terminal/kitty/graphics_image.zig b/src/terminal/kitty/graphics_image.zig
index 9789b431d..1c57251a4 100644
--- a/src/terminal/kitty/graphics_image.zig
+++ b/src/terminal/kitty/graphics_image.zig
@@ -795,6 +795,12 @@ pub const Image = struct {
     /// pointer and never own it).
     animation: ?*animation.Animation = null,
 
+    /// False keeps the image when the storage evicts to make room: it is
+    /// never evicted, but still counts toward the limit. For images an
+    /// embedder draws its own interface with, which no client would send
+    /// again. A retransmission resets it.
+    evictable: bool = true,
+
     /// The rectangles of the displayed frame that frame edits (a=f
     /// with r naming the displayed frame) changed in place, each with
     /// the generation its edit stamped, so a renderer holding an
diff --git a/src/terminal/kitty/graphics_storage.zig b/src/terminal/kitty/graphics_storage.zig
index d92b237a3..5fef315cc 100644
--- a/src/terminal/kitty/graphics_storage.zig
+++ b/src/terminal/kitty/graphics_storage.zig
@@ -1892,6 +1892,7 @@ pub const ImageStorage = struct {
                 while (it.next()) |kv| {
                     const img = kv.value_ptr;
                     if (exclude_id != null and img.id == exclude_id.?) continue;
+                    if (!img.evictable) continue;
 
                     const current = Candidate.init(img);
                     if (best == null or current.lessThan(best.?)) best = current;
@@ -3831,6 +3832,71 @@ test "storage: evicts images in priority order" {
     try testing.expect(!s.images.contains(3));
 }
 
+test "storage: eviction passes over images that are not evictable" {
+    const testing = std.testing;
+    const io = testing.io;
+    const alloc = testing.allocator;
+    var t = try terminal.Terminal.init(io, alloc, .{ .rows = 3, .cols = 3 });
+    defer t.deinit(alloc);
+
+    var s: ImageStorage = .{ .total_limit = 192 };
+    defer s.deinit(alloc, t.screens.active);
+
+    // The oldest image, transient and unused, would go first.
+    try s.addImage(io, alloc, t.screens.active, .{
+        .id = 1,
+        .data = .{ .complete = stars() },
+        .metadata = .{ .transient = true },
+    });
+    s.images.getPtr(1).?.evictable = false;
+    try s.addImage(io, alloc, t.screens.active, .{
+        .id = 2,
+        .data = .{ .complete = stars() },
+    });
+    try s.addPlacement(io, alloc, t.screens.active, 2, 1, .{
+        .location = .{ .pin = try trackPin(&t, .{ .x = 0, .y = 0 }) },
+    });
+    try s.addImage(io, alloc, t.screens.active, .{
+        .id = 3,
+        .data = .{ .complete = stars() },
+    });
+
+    // The newest unused image goes before the older placed one, and the
+    // kept image stays.
+    try s.addImage(io, alloc, t.screens.active, .{
+        .id = 4,
+        .data = .{ .complete = stars() },
+    });
+    try testing.expect(s.images.contains(1));
+    try testing.expect(s.images.contains(2));
+    try testing.expect(!s.images.contains(3));
+    try testing.expect(s.images.contains(4));
+
+    // Then, of what is left, the unused one; never the kept one.
+    try s.addImage(io, alloc, t.screens.active, .{
+        .id = 5,
+        .data = .{ .complete = stars() },
+    });
+    try testing.expect(s.images.contains(1));
+    try testing.expect(s.images.contains(2));
+    try testing.expect(!s.images.contains(4));
+
+    // Only kept images left: an image that doesn't fit fails, as one over
+    // the limit does, and the kept images stay. They still count.
+    var it = s.images.valueIterator();
+    while (it.next()) |img| img.evictable = false;
+    const rejected = stars();
+    defer alloc.free(rejected);
+    try testing.expectError(error.OutOfMemory, s.addImage(io, alloc, t.screens.active, .{
+        .id = 6,
+        .data = .{ .complete = rejected },
+    }));
+    try testing.expectEqual(@as(usize, 3), s.images.count());
+    try testing.expectEqual(@as(usize, 192), s.total_bytes);
+    try testing.expect(!s.evictImage(io, alloc, t.screens.active, 64));
+    try testing.expectEqual(@as(usize, 3), s.images.count());
+}
+
