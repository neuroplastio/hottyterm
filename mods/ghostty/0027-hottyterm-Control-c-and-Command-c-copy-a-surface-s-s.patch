+/// The text selected in a surface, to the clipboards `copy-on-select`
+/// names, at a release on it (SPEC §11). The renderer mutex is held.
+fn copyOnSelect(s: *Surface) void {
+    const clipboards: []const apprt.Clipboard = switch (s.config.copy_on_select) {
+        .none => return,
+        .primary => &.{.selection},
+        .clipboard => &.{.standard},
+        .both => &.{ .standard, .selection },
+    };
+    const h = s.io.terminal_stream.handler.hotty.host orelse return;
+    const text = hotty_host_selected_text(h) orelse return;
+    setClipboards(s, clipboards, std.mem.span(text));
+}
+
+/// Surface's copy_to_clipboard when the terminal has no selection: the
+/// text selected in a surface, which stays selected (SPEC §11). False if
+/// none is, and the key then reaches the program (`performable`). The
+/// renderer mutex is held.
+pub fn copySelection(s: *Surface) bool {
+    const h = s.io.terminal_stream.handler.hotty.host orelse return false;
+    const text = hotty_host_selected_text(h) orelse return false;
+    setClipboards(s, &.{.standard}, std.mem.span(text));
+    return true;
+}
+
+fn setClipboards(s: *Surface, clipboards: []const apprt.Clipboard, text: [:0]const u8) void {
+    const contents: []const apprt.ClipboardContent = &.{.{ .mime = "text/plain", .data = text }};
+    for (clipboards) |c| s.rt_surface.setClipboard(c, contents, false) catch |err| {
+        log.warn("error setting clipboard={} err={}", .{ c, err });
+    };
+}
+
+/// Whether something is selected, the terminal's or a surface's: a copy
+/// key is then the host's, kept from the surface holding the keyboard
+/// (SPEC §11).
+fn selects(s: *Surface) bool {
+    s.renderer_state.mutex.lockUncancelable(global.io());
+    defer s.renderer_state.mutex.unlock(global.io());
+    if (s.io.terminal.screens.active.selection != null) return true;
+    const h = s.io.terminal_stream.handler.hotty.host orelse return false;
+    return hotty_host_selected_text(h) != null;
+}
