@@ -1846,7 +1899,8 @@ fn namedKey(key: input.Key) ?[]const u8 {
 /// some): every key while a key sequence or a key table is under way, a key
 /// that starts a sequence, and a key bound to what a browser keeps too:
 /// opening windows and splits, closing them, quitting, full screen, the
-/// config, key tables. hottyterm has no tabs.
+/// config, key tables; and a copy key while something is selected (SPEC
+/// §11). hottyterm has no tabs.
 fn reserved(s: *Surface, event: input.KeyEvent) bool {
     if (s.keyboard.sequence_set != null or s.keyboard.table_stack.items.len > 0) return true;
     const entry = s.config.keybind.set.getEvent(event) orelse return false;
@@ -1868,6 +1922,7 @@ fn reserved(s: *Surface, event: input.KeyEvent) bool {
         .activate_key_table,
         .activate_key_table_once,
         => return true,
+        .copy_to_clipboard => if (selects(s)) return true,
         else => {},
     };
     return false;
