+test "Hotty.trace: a writer that failed to open stays off" {
+    const tr = trace;
+    defer tr.status.store(.unknown, .release);
+    // setUp succeeded, but the writer found no file first.
+    tr.status.store(.starting, .release);
+    tr.status.store(.off, .release);
+    try std.testing.expect(!tr.settle(true));
+    try std.testing.expectEqual(tr.Status.off, tr.status.load(.acquire));
+    // Without it, setUp's outcome stands.
+    tr.status.store(.starting, .release);
+    try std.testing.expect(tr.settle(true));
+    tr.status.store(.starting, .release);
+    try std.testing.expect(!tr.settle(false));
+}
