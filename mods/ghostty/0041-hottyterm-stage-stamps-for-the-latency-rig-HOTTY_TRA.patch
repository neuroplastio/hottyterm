+    /// hottyterm: with HOTTY_TRACE set, stamps GTK's frame clock (gov
+    /// R-22): `term.fc` as each phase of a frame begins (`a.p`), `term.frame`
+    /// after each paint, with the frame's counter, its frame time and its
+    /// predicted presentation; `term.presented` when the compositor reports
+    /// a frame shown, at that time. GDK's times are g_get_monotonic_time's,
+    /// the trace's clock, in µs.
+    fn traceFrames(widget: *gtk.Widget) void {
+        if (!hotty.trace.on()) return;
+        const clock = widget.getFrameClock() orelse return;
+        const S = gdk.FrameClock.signals;
+        _ = S.flush_events.connect(clock, ?*anyopaque, &phase("flush-events").f, null, .{});
+        _ = S.before_paint.connect(clock, ?*anyopaque, &phase("before-paint").f, null, .{});
+        _ = S.update.connect(clock, ?*anyopaque, &phase("update").f, null, .{});
+        _ = S.layout.connect(clock, ?*anyopaque, &phase("layout").f, null, .{});
+        _ = S.paint.connect(clock, ?*anyopaque, &phase("paint").f, null, .{});
+        _ = S.resume_events.connect(clock, ?*anyopaque, &phase("resume-events").f, null, .{});
+        _ = S.after_paint.connect(clock, ?*anyopaque, &afterPaint, null, .{});
+    }
+
+    fn phase(comptime name: []const u8) type {
+        return struct {
+            fn f(clock: *gdk.FrameClock, _: ?*anyopaque) callconv(.c) void {
+                hotty.trace.emit("term.fc", hotty.trace.now(), null, "\"p\":\"" ++ name ++ "\",\"frame\":{d}", .{clock.getFrameCounter()});
+            }
+        };
+    }
+
+    var presented_upto: i64 = 0;
+
+    fn afterPaint(clock: *gdk.FrameClock, _: ?*anyopaque) callconv(.c) void {
+        const n = clock.getFrameCounter();
+        if (clock.getCurrentTimings()) |t| hotty.trace.emit("term.frame", hotty.trace.now(), null, "\"frame\":{d},\"frame_t\":{d},\"predicted\":{d}", .{
+            n, t.getFrameTime() * 1000, t.getPredictedPresentationTime() * 1000,
+        });
+        var k: i64 = @max(presented_upto + 1, n - 8);
+        while (k < n) : (k += 1) {
+            const t = clock.getTimings(k) orelse continue;
+            if (t.getComplete() == 0) break;
+            presented_upto = k;
+            const at = t.getPresentationTime();
+            if (at > 0) hotty.trace.emit("term.presented", @intCast(at * 1000), null, "\"frame\":{d}", .{k});
+        }
+    }
+
     //---------------------------------------------------------------
     // Presenting
 
