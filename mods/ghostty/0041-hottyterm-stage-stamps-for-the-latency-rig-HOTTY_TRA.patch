+/// Stage stamps for gov R-22's latency rig, in the trace format hotty/1
+/// (hottyterm's docs/trace.md). Off unless `HOTTY_TRACE` names a directory,
+/// where the terminal writes `hottyterm-<pid>.jsonl`: then each stamp is one
+/// line, written with one write(2) to the file opened for appending, on the
+/// clock every process of the rig shares (CLOCK_MONOTONIC; macOS's
+/// CLOCK_UPTIME_RAW). Off, a stamp is one atomic load and a branch.
+/// hotty-blitz stamps its own stages into a file of its own.
+pub const trace = struct {
+    /// -2: not looked up yet; -1: off; else the file.
+    var fd: std.atomic.Value(c_int) = .init(-2);
+
+    const clock_id: std.c.clockid_t = if (builtin.os.tag.isDarwin()) .UPTIME_RAW else .MONOTONIC;
+    extern "c" fn pthread_threadid_np(thread: ?std.c.pthread_t, id: *u64) c_int;
+
+    fn file() ?c_int {
+        const v = fd.load(.acquire);
+        if (v >= 0) return v;
+        if (v == -1) return null;
+        const opened = open();
+        // Threads racing to the first stamp: one file wins.
+        if (fd.cmpxchgStrong(-2, opened, .acq_rel, .acquire)) |cur| {
+            if (opened >= 0) _ = std.c.close(opened);
+            return if (cur >= 0) cur else null;
+        }
+        if (opened < 0) return null;
+        var buf: [160]u8 = undefined;
+        const head = std.fmt.bufPrint(&buf, "{{\"trace\":\"hotty/1\",\"proc\":\"hottyterm\",\"pid\":{d},\"clock\":\"{s}\"}}\n", .{
+            std.c.getpid(),
+            if (builtin.os.tag.isDarwin()) "uptime-raw" else "monotonic",
+        }) catch return opened;
+        _ = std.c.write(opened, head.ptr, head.len);
+        return opened;
+    }
+
+    fn open() c_int {
+        const dir = std.posix.system.getenv("HOTTY_TRACE") orelse return -1;
+        const d = std.mem.span(dir);
+        if (d.len == 0) return -1;
+        var buf: [std.fs.max_path_bytes]u8 = undefined;
+        const path = std.mem.printSentinel(&buf, "{s}/hottyterm-{d}.jsonl", .{ d, std.c.getpid() }, 0) catch return -1;
+        const f = std.c.open(path.ptr, .{ .ACCMODE = .WRONLY, .CREAT = true, .APPEND = true, .CLOEXEC = true }, @as(c_uint, 0o644));
+        return if (f < 0) -1 else f;
+    }
+
+    /// Whether stamps are on.
+    pub fn on() bool {
+        return file() != null;
+    }
+
+    /// The time on the shared clock, in ns; 0 while stamps are off.
+    pub fn now() u64 {
+        if (!on()) return 0;
+        return clock();
+    }
+
+    fn clock() u64 {
+        var ts: std.c.timespec = undefined;
+        _ = std.c.clock_gettime(clock_id, &ts);
+        return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+    }
+
+    fn tid() u64 {
+        if (comptime builtin.os.tag == .linux) return @intCast(std.os.linux.gettid());
+        if (comptime builtin.os.tag.isDarwin()) {
+            var id: u64 = 0;
+            _ = pthread_threadid_np(null, &id);
+            return id;
+        }
+        return 0;
+    }
+
+    /// One line: an instant at `t`, or a span from `t` lasting `dur`.
+    /// `a` is the inside of the line's arguments object, formatted with
+    /// `args`, as in `"\"n\":{d}"`.
+    pub fn emit(name: []const u8, t: u64, dur: ?u64, comptime a: []const u8, args: anytype) void {
+        const f = file() orelse return;
+        var buf: [512]u8 = undefined;
+        var w: std.Io.Writer = .fixed(&buf);
+        w.print("{{\"t\":{d},\"n\":\"{s}\"", .{ t, name }) catch return;
+        if (dur) |d| w.print(",\"dur\":{d}", .{d}) catch return;
+        w.print(",\"tr\":{d}", .{tid()}) catch return;
+        if (a.len > 0) w.print(",\"a\":{{" ++ a ++ "}}", args) catch return;
+        w.writeAll("}\n") catch return;
+        const line = w.buffered();
+        _ = std.c.write(f, line.ptr, line.len);
+    }
+
+    /// An instant, now.
+    pub fn instant(name: []const u8) void {
+        if (on()) emit(name, clock(), null, "", .{});
+    }
+
+    /// An instant, now, of `n` bytes.
