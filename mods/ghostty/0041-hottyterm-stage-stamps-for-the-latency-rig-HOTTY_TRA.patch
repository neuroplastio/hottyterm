+test "Hotty.trace: once stopping, a write to a reader that never reads gives up" {
+    const tr = trace;
+    const fds = try compat_fd.pipe2(.{ .CLOEXEC = true, .NONBLOCK = true });
+    defer for (fds) |fd| compat_fd.close(fd);
+    // The reader never reads: fill the pipe.
+    const chunk: [4096]u8 = @splat('x');
+    while (std.c.write(fds[1], &chunk, chunk.len) > 0) {}
+    defer {
+        tr.quit.store(false, .release);
+        tr.give_up_at = 0;
+    }
+    tr.quit.store(true, .release);
+    const t0 = tr.clock();
+    try std.testing.expect(!tr.writeAll(fds[1], &chunk));
+    const waited_ms = (tr.clock() - t0) / std.time.ns_per_ms;
+    try std.testing.expect(waited_ms >= tr.exit_wait_ms - tr.interval_ms);
+    // Generous above: the gate runs beside builds.
+    try std.testing.expect(waited_ms <= 5 * tr.exit_wait_ms);
+}
