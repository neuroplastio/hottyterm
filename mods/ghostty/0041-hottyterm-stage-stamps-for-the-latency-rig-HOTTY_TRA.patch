+test "Hotty.trace: SIGTERM is sent again to the process, past a thread that blocks it" {
+    if (comptime builtin.os.tag != .linux and !builtin.os.tag.isDarwin()) return error.SkipZigTest;
+    const pid = std.c.fork();
+    try std.testing.expect(pid >= 0);
+    if (pid == 0) {
+        // The child: SIGTERM as it was (the default), and a thread that
+        // blocks it does the sending, as `hotty-trace` would if it took
+        // the first stamper's mask. The child must die of it.
