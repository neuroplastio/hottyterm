+/// Stage stamps for gov R-22's latency rig, in the trace format hotty/1
+/// (hottyterm's docs/trace.md). Off unless `HOTTY_TRACE` names a directory,
+/// where the terminal writes `hottyterm-<pid>.jsonl`, one line per stamp, on
+/// the clock every process of the rig shares (CLOCK_MONOTONIC; macOS's
+/// CLOCK_UPTIME_RAW). Off, a stamp is one atomic load and a branch, and there
+/// is no thread and no buffer. hotty-blitz stamps its own stages into a file
+/// of its own.
+///
+/// A stamp makes no write and takes no lock: its line goes into a ring of
+/// about 8 MB (`push`, lock-free), and the `hotty-trace` thread writes the
+/// ring out every `interval_ms`, at exit and on SIGTERM. A stamp is often
+/// taken with the terminal's lock held, and a write to a busy disk can wait
+/// for most of a second: written on the stamping thread, it stalled every
+/// thread queued behind that lock. With the ring full, a line is dropped and
+/// counted, and the writer reports the count as `trace.dropped`. Exit waits
+/// for the last write `exit_wait_ms` at most. SIGTERM does too when the file
+/// is a FIFO whose reader is slow or gone; a write to a regular file can't be
+/// cut short, so on a stalled disk SIGTERM waits for that write to return. A
+/// second SIGTERM doesn't wait.
+pub const trace = struct {
+    const Status = enum(u8) { unknown, starting, on, off };
+    var status: std.atomic.Value(Status) = .init(.unknown);
+
+    const clock_id: std.c.clockid_t = if (builtin.os.tag.isDarwin()) .UPTIME_RAW else .MONOTONIC;
+    extern "c" fn pthread_threadid_np(thread: ?std.c.pthread_t, id: *u64) c_int;
+    extern "c" fn atexit(f: *const fn () callconv(.c) void) c_int;
+
+    /// The longest line; a longer stamp is dropped and counted.
+    const line_max = 512;
+    /// About 8 MB of lines waiting for the writer.
+    const slots = 16 * 1024;
+    /// How often the writer writes the ring out.
+    const interval_ms = 50;
+    /// How long exit waits for the writer's last write, and SIGTERM for a
+    /// FIFO's reader.
+    const exit_wait_ms = 1000;
+    /// How long a stamp racing the first one waits for the writer to start.
+    const start_wait_ms = 100;
+
+    /// A bounded MPSC queue (Vyukov's): a slot is free for the stamp at
+    /// position `pos` when its `seq` is `pos`, and holds that stamp's line
+    /// once it is `pos + 1`. The writer frees it for the next lap.
+    const Slot = struct {
+        seq: std.atomic.Value(u64),
+        len: u32,
+        data: [line_max]u8,
+    };
+    var ring: []Slot = &.{};
+    /// The next position a stamp takes.
+    var head: std.atomic.Value(u64) = .init(0);
+    /// The next position the writer reads; the writer's own.
+    var tail: u64 = 0;
+    var dropped: std.atomic.Value(u64) = .init(0);
+    /// One byte wakes the writer early (exit, SIGTERM); one byte back says
+    /// it wrote its last.
+    var wake: [2]std.posix.fd_t = .{ -1, -1 };
+    var done: [2]std.posix.fd_t = .{ -1, -1 };
+    var quit: std.atomic.Value(bool) = .init(false);
+    var terminated: std.atomic.Value(bool) = .init(false);
+    /// SIGTERM is ours (`onTerm`) and `old_term` is what it was.
+    var term_hooked: bool = false;
+    var old_term: std.posix.Sigaction = undefined;
+    /// The writer's: when it gives up writing, once exit or SIGTERM came
+    /// (`clock`); 0 while neither has.
+    var give_up_at: u64 = 0;
+    /// The stamping thread's id, looked up once per thread.
+    threadlocal var tid_cache: u64 = 0;
+
+    fn enabled() bool {
+        return switch (status.load(.acquire)) {
+            .on => true,
+            .off => false,
+            .unknown, .starting => start(),
+        };
+    }
+
+    /// The first stamp: looks up `HOTTY_TRACE` and starts the writer. A
+    /// thread racing it waits `start_wait_ms` at most for the outcome; the
+    /// file is opened on the writer, not here.
+    fn start() bool {
+        if (status.cmpxchgStrong(.unknown, .starting, .acq_rel, .acquire)) |cur| {
+            var s = cur;
+            const t0 = clock();
+            while (s == .starting) : (s = status.load(.acquire)) {
+                if (clock() -| t0 > start_wait_ms * std.time.ns_per_ms) {
+                    // This stamp is lost: counted, as a full ring's are.
+                    _ = dropped.fetchAdd(1, .monotonic);
+                    return false;
+                }
+                std.atomic.spinLoopHint();
+            }
+            return s == .on;
+        }
+        return settle(setUp());
+    }
+
+    /// The outcome of `setUp`, unless the writer has already said `.off`
+    /// (its file would not open): that stands.
+    fn settle(ok: bool) bool {
+        _ = status.cmpxchgStrong(.starting, if (ok) .on else .off, .acq_rel, .acquire);
+        return status.load(.acquire) == .on;
+    }
+
+    fn setUp() bool {
+        const dir = std.posix.system.getenv("HOTTY_TRACE") orelse return false;
+        if (std.mem.span(dir).len == 0) return false;
+        ring = std.heap.page_allocator.alloc(Slot, slots) catch return false;
+        for (ring, 0..) |*s, i| s.seq = .init(i);
+        wake = compat_fd.pipe2(.{ .CLOEXEC = true, .NONBLOCK = true }) catch return unwind(false);
+        done = compat_fd.pipe2(.{ .CLOEXEC = true, .NONBLOCK = true }) catch return unwind(false);
+        hookTerm();
+        const th = std.Thread.spawn(.{}, writer, .{}) catch {
+            unhookTerm();
+            return unwind(false);
+        };
+        th.detach();
+        _ = atexit(atExit);
+        return true;
+    }
+
+    /// Gives back what a failed `setUp` took.
+    fn unwind(ok: bool) bool {
+        for ([_]*[2]std.posix.fd_t{ &wake, &done }) |p| {
+            for (p) |*fd| if (fd.* >= 0) {
+                compat_fd.close(fd.*);
+                fd.* = -1;
+            };
+        }
+        std.heap.page_allocator.free(ring);
+        ring = &.{};
+        return ok;
+    }
+
+    /// SIGTERM (the rig's stop) flushes first, then terminates as it did:
+    /// the writer puts back what was there and sends it again. Not over a
+    /// SIGTERM the process inherited as ignored: that stays ignored, and
+    /// exit still flushes.
+    fn hookTerm() void {
+        std.posix.sigaction(std.posix.SIG.TERM, null, &old_term);
+        if (old_term.handler.handler == std.posix.SIG.IGN) return;
+        const sa: std.posix.Sigaction = .{
+            .handler = .{ .handler = onTerm },
+            .mask = std.posix.sigemptyset(),
+            .flags = std.posix.SA.RESTART,
+        };
+        std.posix.sigaction(std.posix.SIG.TERM, &sa, &old_term);
+        term_hooked = true;
+    }
+
+    fn unhookTerm() void {
+        if (!term_hooked) return;
+        std.posix.sigaction(std.posix.SIG.TERM, &old_term, null);
+        term_hooked = false;
+    }
+
+    /// SIGTERM back to what it was, and sent again to the process, not to
+    /// this thread: any thread that doesn't block it takes it.
+    fn reraise() void {
+        unhookTerm();
+        _ = std.c.kill(std.c.getpid(), std.posix.SIG.TERM);
+    }
+
+    /// The file, opened without blocking: a FIFO with no reader yet is
+    /// `null` for now, and opened on a later tick. `error.Failed` for good.
+    fn open() error{Failed}!?c_int {
+        const dir = std.posix.system.getenv("HOTTY_TRACE") orelse return error.Failed;
+        const d = std.mem.span(dir);
+        var buf: [std.fs.max_path_bytes]u8 = undefined;
+        const path = std.mem.printSentinel(&buf, "{s}/hottyterm-{d}.jsonl", .{ d, std.c.getpid() }, 0) catch return error.Failed;
+        const f = std.c.open(path.ptr, .{ .ACCMODE = .WRONLY, .CREAT = true, .APPEND = true, .CLOEXEC = true, .NONBLOCK = true }, @as(c_uint, 0o644));
+        if (f >= 0) return f;
+        return switch (std.posix.errno(f)) {
+            .NXIO, .INTR, .AGAIN => null,
+            else => error.Failed,
+        };
+    }
+
+    /// Exit or SIGTERM came: from now on the writer gives up after
+    /// `exit_wait_ms`. False while neither has.
+    fn stopping() bool {
+        if (!quit.load(.acquire) and !terminated.load(.acquire)) return false;
+        if (give_up_at == 0) give_up_at = clock() + exit_wait_ms * std.time.ns_per_ms;
+        return true;
+    }
+
+    fn givenUp() bool {
+        return stopping() and clock() >= give_up_at;
+    }
+
+    /// Waits for `fd` to take writes (`fd` < 0: only the tick), the wake
+    /// pipe, or the tick, whichever is first.
+    fn waitTick(fd: c_int) void {
+        var p = [2]std.posix.pollfd{
+            .{ .fd = wake[0], .events = std.posix.POLL.IN, .revents = 0 },
+            .{ .fd = fd, .events = std.posix.POLL.OUT, .revents = 0 },
+        };
+        _ = std.posix.poll(p[0..if (fd >= 0) 2 else 1], interval_ms) catch 0;
+        var b: [64]u8 = undefined;
+        while (std.c.read(wake[0], &b, b.len) > 0) {}
+    }
+
+    /// The `hotty-trace` thread: opens the file, then writes the ring out
+    /// every `interval_ms` until exit or SIGTERM. A disk or a reader that
+    /// stalls stalls only this thread; the stamps fill the ring meanwhile.
+    fn writer() void {
+        if (comptime builtin.os.tag.isDarwin()) {
+            _ = std.c.pthread_setname_np("hotty-trace");
+        } else if (comptime builtin.os.tag == .linux) {
+            _ = std.c.pthread_setname_np(std.c.pthread_self(), "hotty-trace");
+        }
+        // The thread that stamped first may block SIGTERM; this one mustn't
+        // hold up the process's.
+        var set = std.posix.sigemptyset();
+        std.posix.sigaddset(&set, std.posix.SIG.TERM);
+        var old: std.posix.sigset_t = undefined;
+        _ = std.c.pthread_sigmask(std.posix.SIG.UNBLOCK, &set, &old);
+
+        var out: [64 * 1024]u8 = undefined;
+        const fd: c_int = while (true) {
+            if (open()) |f| {
+                if (f) |ok| break ok;
+            } else |_| {
+                log.warn("HOTTY_TRACE: cannot open the trace file, no stamps are written", .{});
+                break -1;
+            }
+            if (givenUp()) break -1;
+            waitTick(-1);
+        };
+        if (fd >= 0) {
+            var buf: [160]u8 = undefined;
+            if (std.fmt.bufPrint(&buf, "{{\"trace\":\"hotty/1\",\"proc\":\"hottyterm\",\"pid\":{d},\"clock\":\"{s}\"}}\n", .{
+                std.c.getpid(),
+                if (builtin.os.tag.isDarwin()) "uptime-raw" else "monotonic",
+            })) |head_line| {
+                _ = writeAll(fd, head_line);
+            } else |_| {}
+            while (true) {
+                // Looked at before the last drain, so nothing stamped
+                // before the stop is left behind.
+                const stop = stopping();
+                const taken = drain(fd, &out);
+                if (stop or givenUp()) break;
+                // A drain that took a whole ring may have left more behind:
+                // drain again now rather than a tick later.
+                if (taken < slots) waitTick(-1);
+            }
+        }
+        // No writer from here: stamps stop.
+        status.store(.off, .release);
+        _ = std.c.write(done[1], "d", 1);
+        if (terminated.load(.acquire)) reraise() else unhookTerm();
+    }
+
+    /// Writes out every line stamped before it began, in as few writes as
+    /// `out` allows, then the count of the lines dropped since the last
+    /// time. It stops where `head` was when it began: under a steady flood
+    /// a drain would otherwise never end. It also stops at a write that
+    /// gives up, so no line is cut short in the middle of the file. Returns
+    /// how many lines it took from the ring.
+    fn drain(fd: c_int, out: []u8) u64 {
+        const start_tail = tail;
+        const end = head.load(.acquire);
+        var n: usize = 0;
+        while (tail != end) {
+            const s = &ring[tail % slots];
+            if (s.seq.load(.acquire) != tail + 1) break;
+            const len = s.len;
+            if (n + len > out.len) {
+                if (!writeAll(fd, out[0..n])) return tail - start_tail;
+                n = 0;
+            }
+            @memcpy(out[n..][0..len], s.data[0..len]);
+            n += len;
+            s.seq.store(tail + slots, .release);
+            tail += 1;
+        }
+        const lost = dropped.swap(0, .acq_rel);
+        if (lost > 0) {
+            if (n + line_max > out.len) {
+                if (!writeAll(fd, out[0..n])) return tail - start_tail;
+                n = 0;
+            }
+            const line = std.fmt.bufPrint(out[n..], "{{\"t\":{d},\"n\":\"trace.dropped\",\"tr\":{d},\"c\":{{\"lines\":{d}}}}}\n", .{ clock(), tid(), lost }) catch "";
+            n += line.len;
+        }
+        _ = writeAll(fd, out[0..n]);
+        return tail - start_tail;
+    }
+
+    /// The whole of `data`, through short writes, signals and a reader that
+    /// is slow (the file is non-blocking; a regular file's write blocks
+    /// regardless). Once exit or SIGTERM came it gives up after
+    /// `exit_wait_ms`, and what an error leaves unwritten (a full disk, a
+    /// FIFO's reader gone) is lost. False when it didn't write it all.
+    fn writeAll(fd: c_int, data: []const u8) bool {
+        var rest = data;
+        while (rest.len > 0) {
+            const r = std.c.write(fd, rest.ptr, rest.len);
+            if (r > 0) {
+                rest = rest[@intCast(r)..];
+                continue;
+            }
+            switch (if (r < 0) std.posix.errno(r) else .AGAIN) {
+                .INTR => continue,
+                .AGAIN => {
+                    if (givenUp()) return false;
+                    waitTick(fd);
+                },
+                else => return false,
+            }
+        }
+        return true;
+    }
+
+    /// One line into the ring, or counted as dropped when it is full.
+    fn push(line: []const u8) void {
+        var pos = head.load(.monotonic);
+        const s = while (true) {
+            const slot = &ring[pos % slots];
+            const seq = slot.seq.load(.acquire);
+            if (seq == pos) {
+                pos = head.cmpxchgWeak(pos, pos + 1, .monotonic, .monotonic) orelse break slot;
+            } else if (seq < pos) {
+                // Last lap's line, not written out yet: the ring is full.
+                _ = dropped.fetchAdd(1, .monotonic);
+                return;
+            } else {
+                pos = head.load(.monotonic);
+            }
+        };
+        @memcpy(s.data[0..line.len], line);
+        s.len = @intCast(line.len);
+        s.seq.store(pos + 1, .release);
+    }
+
+    /// Exit waits for the writer's last write, for `exit_wait_ms` at most
+    /// (the writer gives up then too): a stalled disk doesn't hold the
+    /// process.
+    fn atExit() callconv(.c) void {
+        if (status.load(.acquire) != .on) return;
+        quit.store(true, .release);
+        _ = std.c.write(wake[1], "q", 1);
+        var p = [1]std.posix.pollfd{.{ .fd = done[0], .events = std.posix.POLL.IN, .revents = 0 }};
+        _ = std.posix.poll(&p, exit_wait_ms + interval_ms) catch 0;
+    }
+
+    /// SIGTERM: async-signal-safe, a flag and a byte. A second one doesn't
+    /// wait for the writer: SIGTERM goes back to what it was, and is sent
+    /// again.
+    fn onTerm(_: std.posix.SIG) callconv(.c) void {
+        if (terminated.swap(true, .acq_rel)) {
+            std.posix.sigaction(std.posix.SIG.TERM, &old_term, null);
+            _ = std.c.kill(std.c.getpid(), std.posix.SIG.TERM);
+            return;
+        }
+        _ = std.c.write(wake[1], "t", 1);
+    }
+
+    /// Whether stamps are on.
+    pub fn on() bool {
+        return enabled();
+    }
+
+    /// The time on the shared clock, in ns; 0 while stamps are off.
+    pub fn now() u64 {
+        if (!on()) return 0;
+        return clock();
+    }
+
+    fn clock() u64 {
+        var ts: std.c.timespec = undefined;
+        _ = std.c.clock_gettime(clock_id, &ts);
+        return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+    }
+
+    fn tid() u64 {
+        if (tid_cache == 0) tid_cache = tidNow();
+        return tid_cache;
+    }
+
+    fn tidNow() u64 {
+        if (comptime builtin.os.tag == .linux) return @intCast(std.os.linux.gettid());
+        if (comptime builtin.os.tag.isDarwin()) {
+            var id: u64 = 0;
+            _ = pthread_threadid_np(null, &id);
+            return id;
+        }
+        return 0;
+    }
+
+    /// One line: an instant at `t`, or a span from `t` lasting `dur`.
+    /// `a` is the inside of the line's arguments object, formatted with
+    /// `args`, as in `"\"n\":{d}"`.
+    pub fn emit(name: []const u8, t: u64, dur: ?u64, comptime a: []const u8, args: anytype) void {
+        if (!enabled()) return;
+        var buf: [line_max]u8 = undefined;
+        var w: std.Io.Writer = .fixed(&buf);
+        formatLine(&w, name, t, dur, a, args) catch {
+            // Longer than `line_max`: counted, as a full ring's are.
+            _ = dropped.fetchAdd(1, .monotonic);
+            return;
+        };
+        push(w.buffered());
+    }
+
+    fn formatLine(w: *std.Io.Writer, name: []const u8, t: u64, dur: ?u64, comptime a: []const u8, args: anytype) std.Io.Writer.Error!void {
+        try w.print("{{\"t\":{d},\"n\":\"{s}\"", .{ t, name });
+        if (dur) |d| try w.print(",\"dur\":{d}", .{d});
+        try w.print(",\"tr\":{d}", .{tid()});
+        if (a.len > 0) try w.print(",\"a\":{{" ++ a ++ "}}", args);
+        try w.writeAll("}\n");
+    }
+
+    /// An instant, now.
+    pub fn instant(name: []const u8) void {
+        if (on()) emit(name, clock(), null, "", .{});
+    }
+
+    /// An instant, now, of `n` bytes.
+    pub fn instantN(name: []const u8, n: usize) void {
+        if (on()) emit(name, clock(), null, "\"n\":{d}", .{n});
+    }
+
+    /// A span from `t0` (from `now`) to now.
+    pub fn span(name: []const u8, t0: u64) void {
+        if (on()) emit(name, t0, clock() -| t0, "", .{});
+    }
+
+    /// A span from `t0` to now, of `n` bytes.
+    pub fn spanN(name: []const u8, t0: u64, n: usize) void {
+        if (on()) emit(name, t0, clock() -| t0, "\"n\":{d}", .{n});
+    }
+
+    /// The wait for the terminal's lock since `t0`, as `term.lock`, when
+    /// it was long enough to be a wait (`a.fn`: where).
+    pub fn waited(t0: u64, comptime where: []const u8) void {
+        if (!on()) return;
+        const d = clock() -| t0;
+        if (d >= 20 * std.time.ns_per_us) emit("term.lock", t0, d, "\"fn\":\"{s}\"", .{where});
+    }
+};
+
+test "Hotty.trace: stamps queue without a write, a full ring drops and counts" {
+    const tr = trace;
+    // A ring of the real size, not started: no writer thread, no signal.
+    tr.ring = try std.testing.allocator.alloc(tr.Slot, tr.slots);
+    defer {
+        std.testing.allocator.free(tr.ring);
+        tr.ring = &.{};
+        tr.head.store(0, .monotonic);
+        tr.tail = 0;
+        tr.dropped.store(0, .monotonic);
+    }
+    for (tr.ring, 0..) |*s, i| s.seq = .init(i);
+
+    const x = "{\"t\":1,\"n\":\"x\"}\n";
+    for (0..tr.slots + 3) |_| tr.push(x);
+    try std.testing.expectEqual(@as(u64, 3), tr.dropped.load(.monotonic));
+
+    const fds = try compat_fd.pipe2(.{ .CLOEXEC = true });
+    defer compat_fd.close(fds[0]);
+    const Reader = struct {
+        fn run(fd: std.posix.fd_t, out: *std.ArrayListUnmanaged(u8)) void {
+            var b: [4096]u8 = undefined;
+            while (true) {
+                const n = std.c.read(fd, &b, b.len);
+                if (n <= 0) return;
+                out.appendSlice(std.heap.page_allocator, b[0..@intCast(n)]) catch return;
+            }
+        }
+    };
+    var got: std.ArrayListUnmanaged(u8) = .empty;
+    defer got.deinit(std.heap.page_allocator);
+    const th = try std.Thread.spawn(.{}, Reader.run, .{ fds[0], &got });
+    var out: [64 * 1024]u8 = undefined;
+    try std.testing.expectEqual(@as(u64, tr.slots), tr.drain(fds[1], &out));
+    // Written out, the ring takes lines again, a lap on.
+    tr.push("{\"t\":2,\"n\":\"y\"}\n");
+    try std.testing.expectEqual(@as(u64, 1), tr.drain(fds[1], &out));
+    compat_fd.close(fds[1]);
+    th.join();
+
+    var lines = std.mem.splitScalar(u8, std.mem.trimEnd(u8, got.items, "\n"), '\n');
+    var n_x: usize = 0;
+    var n_drop: usize = 0;
+    var last: []const u8 = "";
+    while (lines.next()) |l| {
+        if (std.mem.eql(u8, l, x[0 .. x.len - 1])) n_x += 1;
+        if (std.mem.indexOf(u8, l, "\"n\":\"trace.dropped\"") != null) {
+            n_drop += 1;
+            try std.testing.expect(std.mem.endsWith(u8, l, "\"c\":{\"lines\":3}}"));
+        }
+        last = l;
+    }
+    try std.testing.expectEqual(tr.slots, n_x);
+    try std.testing.expectEqual(@as(usize, 1), n_drop);
+    try std.testing.expectEqualStrings("{\"t\":2,\"n\":\"y\"}", last);
+    try std.testing.expectEqual(@as(u64, 0), tr.dropped.load(.monotonic));
+}
