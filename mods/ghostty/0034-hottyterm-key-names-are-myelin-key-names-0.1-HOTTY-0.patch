+/// The two names of a key pressed (SPEC §10.4, myelin key names 0.1): its
+/// physical key and the character it types, each with the modifiers held,
+/// `super` being the command key. A key that is only physical (`enter`,
+/// `arrow_left`, `f5`) has no character.
+const Press = struct {
+    physical_buf: [64]u8 = undefined,
+    character_buf: [64]u8 = undefined,
+    physical: []const u8 = "",
+    character: []const u8 = "",
+
+    /// Names `event`, if it types no text: a key that is only physical, or
+    /// a key with Ctrl or Super; any key, if `typing`. False for the
+    /// others, which a surface is offered only as bytes, and for a
+    /// composing key and a modifier key (`modifierKey` names those). The
+    /// character is left out where the event does not tell it: a non-letter
+    /// with Shift whose text is not a character, and a letter beyond ASCII
+    /// with Shift.
+    fn name(p: *Press, event: input.KeyEvent, typing: bool) bool {
+        if (event.composing or event.key.modifier() or event.key == .unidentified) return false;
+        const m = event.mods;
+        const physical_only = event.key.codepoint() == null or switch (event.key) {
+            .tab, .enter, .numpad_enter, .backspace, .escape, .space => true,
+            else => false,
+        };
+        if (!typing and !physical_only and !m.ctrl and !m.super) return false;
+        if (!typing and event.key == .space and !m.ctrl and !m.super) return false;
+        var w: std.Io.Writer = .fixed(&p.physical_buf);
+        writeMods(&w, m, m.shift) catch return false;
+        w.writeAll(@tagName(event.key)) catch return false;
+        p.physical = w.buffered();
+        p.character = "";
+        if (physical_only) return true;
+        var cw: std.Io.Writer = .fixed(&p.character_buf);
+        if (writeCharacter(&cw, event)) p.character = cw.buffered() else |_| {}
+        return true;
     }
-    if (!m.ctrl and !m.super) return null;
+
+    /// The one name its bytes would carry: the character, else the only
+    /// name the press has (SPEC §10.6).
+    fn only(p: *const Press) []const u8 {
+        return if (p.character.len > 0) p.character else p.physical;
+    }
+};
+
+/// A name's pointer for hotty-blitz, which takes none as NULL.
+fn namePtr(name: []const u8) ?[*]const u8 {
+    return if (name.len == 0) null else name.ptr;
+}
+
+/// The character `event` types, as myelin key names §2.4 writes it: a
+/// letter small, with `shift` before it, and another character as Shift
+/// types it, without. Fails where it cannot tell.
+fn writeCharacter(w: *std.Io.Writer, event: input.KeyEvent) !void {
+    const m = event.mods;
     var cp: u21 = event.unshifted_codepoint;
-    if (cp == 0) cp = event.key.codepoint() orelse return null;
-    if (cp < 0x20 or cp == 0x7f) return null;
-    // Shift shows in the character: Control+A.
+    if (cp == 0) cp = event.key.codepoint() orelse return error.NoCharacter;
+    if (cp < 0x20 or cp == 0x7f) return error.NoCharacter;
+    var shift = false;
     if (m.shift) {
-        if (cp < 'a' or cp > 'z') return null;
-        cp -= 'a' - 'A';
-    }
-    writeMods(&w, m.ctrl, m.alt, m.super, false) catch return null;
-    if (cp == ' ') w.writeAll("Space") catch return null else w.print("{u}", .{cp}) catch return null;
-    return w.buffered();
+        if (cp >= 'A' and cp <= 'Z') cp += 'a' - 'A';
+        if (cp >= 'a' and cp <= 'z') {
+            shift = true;
+        } else if (cp < 0x80) {
+            // Shift types another character: the event's text, if it has one.
+            cp = shiftedCharacter(event.utf8) orelse return error.NoCharacter;
+        } else return error.NoCharacter;
+    }
+    try writeMods(w, m, shift);
+    try w.print("{u}", .{cp});
+}
+
+/// The one printable character `text` is, if it is one.
+fn shiftedCharacter(text: []const u8) ?u21 {
+    if (text.len == 0) return null;
+    const n = std.unicode.utf8ByteSequenceLength(text[0]) catch return null;
+    if (n != text.len) return null;
+    const cp = std.unicode.utf8Decode(text) catch return null;
+    if (cp < 0x20 or (cp >= 0x7f and cp < 0xa0)) return null;
+    return cp;
 }
 
-fn writeMods(w: *std.Io.Writer, ctrl: bool, alt: bool, meta: bool, shift: bool) !void {
-    if (ctrl) try w.writeAll("Control+");
-    if (alt) try w.writeAll("Alt+");
-    if (meta) try w.writeAll("Meta+");
-    if (shift) try w.writeAll("Shift+");
+/// The modifiers held, as myelin key names §2.1 orders them: super, ctrl,
+/// alt, shift, each with its `+`. Shift only if `shift`: a character that
+/// Shift types already has it.
+fn writeMods(w: *std.Io.Writer, m: input.Mods, shift: bool) !void {
+    if (m.super) try w.writeAll("super+");
+    if (m.ctrl) try w.writeAll("ctrl+");
+    if (m.alt) try w.writeAll("alt+");
+    if (shift) try w.writeAll("shift+");
 }
 
-/// The W3C key value of a key that is not a character.
-fn namedKey(key: input.Key) ?[]const u8 {
-    return switch (key) {
-        .arrow_left, .numpad_left => "ArrowLeft",
-        .arrow_right, .numpad_right => "ArrowRight",
-        .arrow_up, .numpad_up => "ArrowUp",
-        .arrow_down, .numpad_down => "ArrowDown",
-        .home, .numpad_home => "Home",
-        .end, .numpad_end => "End",
-        .page_up, .numpad_page_up => "PageUp",
-        .page_down, .numpad_page_down => "PageDown",
-        .insert, .numpad_insert => "Insert",
-        .delete, .numpad_delete => "Delete",
-        .backspace, .numpad_backspace => "Backspace",
-        .enter, .numpad_enter => "Enter",
-        .tab => "Tab",
-        .escape => "Escape",
-        inline .f1, .f2, .f3, .f4, .f5, .f6, .f7, .f8, .f9, .f10, .f11, .f12, .f13, .f14, .f15, .f16, .f17, .f18, .f19, .f20, .f21, .f22, .f23, .f24 => |k| comptime k.w3c(),
-        else => null,
+/// A modifier key, for surfaceKeyPressed: one tapped alone, with no other
+/// key pressed in between, is a key named on its release (SPEC §10.4), as
+/// its sided physical key and as the modifier key: `ctrl+shift_left` and
+/// `ctrl+shift`, with the modifiers held before it. A press starts a tap, a
+/// press of another key (`surfaceKeyPressed`) or a release of another
+/// modifier ends it. True if the surface used the tap.
+fn modifierKey(s: *Surface, event: input.KeyEvent) bool {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    const key = event.key;
+    switch (event.action) {
+        .press => {
+            var before = event.mods;
+            switch (key) {
+                .shift_left, .shift_right => before.shift = false,
+                .control_left, .control_right => before.ctrl = false,
+                .alt_left, .alt_right => before.alt = false,
+                .meta_left, .meta_right => before.super = false,
+                else => {},
+            }
+            hs.tap_key = key;
+            hs.tap_mods = before;
+            return false;
+        },
+        .repeat => return false,
+        .release => {},
+    }
+    const tapped = hs.tap_key orelse return false;
+    hs.tap_key = null;
+    if (tapped != key) return false;
+    if (!holdsKeyboard(s)) return false;
+    var press: Press = .{};
+    var w: std.Io.Writer = .fixed(&press.physical_buf);
+    var cw: std.Io.Writer = .fixed(&press.character_buf);
+    writeMods(&w, hs.tap_mods, false) catch return false;
+    writeMods(&cw, hs.tap_mods, false) catch return false;
+    // A modifier key's own modifier is not among those before it.
+    w.writeAll(@tagName(key)) catch return false;
+    cw.writeAll(switch (key) {
+        .shift_left, .shift_right => "shift",
+        .control_left, .control_right => "ctrl",
+        .alt_left, .alt_right => "alt",
+        else => "super",
+    }) catch return false;
+    press.physical = w.buffered();
+    press.character = cw.buffered();
+    var drew = false;
+    const used = used: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const used = hs.keyPressed(&s.io.terminal, &press);
+        drew = hs.drew;
+        hs.drew = false;
+        break :used used;
     };
+    deliver(s, used or drew);
+    clipboard(s);
+    return used;
 }
 
