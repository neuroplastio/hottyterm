From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HOTTY Agent <hotty@neuroplast.io>
Date: Sat, 17 Oct 2026 18:32:57 +0200
Subject: [PATCH 35/39] hottyterm: a plain click opens only an OSC 8 hyperlink

With hotty-link-click = plain, no modifier held was the link gesture
for every link, so a URL or a path the link regex found underlined under
a plain pointer and opened on a plain click, while the program reports
the mouse too. Those matches are guesses: a prompt's directory matched
with the text after it ("~/code/neuroplastio 6s"), and in a multiplexer
that draws a pane row by row, the first row of a wrapped URL opened cut
short. An OSC 8 hyperlink is the program's word that its text is a link.

The plain gesture now holds only over a cell with an OSC 8 hyperlink;
a regex match keeps Ctrl (Cmd on macOS), as in Ghostty. Leaving a link
for text that is none also marks the screen for the hover redraw, so its
underline goes.
---
 src/Surface.zig       |  5 ++++-
 src/config/Config.zig |  7 ++++---
 src/termio/hotty.zig  | 29 ++++++++++++++++++++++-------
 3 files changed, 30 insertions(+), 11 deletions(-)

diff --git a/src/Surface.zig b/src/Surface.zig
index 7df27035..9fe53317 100644
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -1723,6 +1723,9 @@ fn mouseRefreshLinks(
     // No link, if we're previously over a link then we need to clear
     // the over-link apprt state.
     if (over_link) {
+        // hottyterm: and its underline, now that a plain pointer leaves
+        // links for text that is none.
+        self.renderer_state.terminal.screens.active.dirty.hyperlink_hover = true;
         _ = try self.rt_app.performAction(
             .{ .surface = self },
             .mouse_shape,
@@ -4545,7 +4548,7 @@ fn linkAtPin(
 ///
 /// The renderer state mutex must be held.
 fn mouseModsWithCapture(self: *Surface, mods: input.Mods) input.Mods {
-    if (hotty.plainLinkClick(self, mods)) return input.ctrlOrSuper(.{});
+    if (hotty.plainLinkOver(self, mods)) return input.ctrlOrSuper(.{});
     // In any of these scenarios, whatever mods are set (even shift)
     // are preserved.
     if (self.io.terminal.flags.mouse_event == .none) return mods;
diff --git a/src/config/Config.zig b/src/config/Config.zig
index 3654e885..74cf404a 100644
--- a/src/config/Config.zig
+++ b/src/config/Config.zig
@@ -3956,10 +3956,11 @@ term: []const u8 = "xterm-ghostty",
 @"hotty-net": []const u8 = "",
 
 // hottyterm: how a click opens a link.
-/// How a click opens a link: a URL, or an OSC 8 hyperlink, in the cells or
-/// in a HOTTY surface.
+/// How a click opens a link: an OSC 8 hyperlink in the cells, or a link in
+/// a HOTTY surface. A URL or a path found in the cells' text (`link`) opens
+/// as in Ghostty, with Ctrl (Cmd on macOS) held.
 ///
-///   * `plain` - a click with no modifiers held opens it, and the pointer
+///   * `plain` - a click with no modifiers held opens one, and the pointer
 ///     over one underlines it, as in a browser, even while the program
 ///     reports the mouse: the program sees no click on a link, but a drag
 ///     that starts on one reaches it. A click with Ctrl (Cmd on macOS)
diff --git a/src/termio/hotty.zig b/src/termio/hotty.zig
index c9026e8d..25a6c1fb 100644
--- a/src/termio/hotty.zig
+++ b/src/termio/hotty.zig
@@ -1838,17 +1838,32 @@ fn osc8Gesture(s: *Surface, mods: input.Mods) bool {
     return s.config.link_osc8 and (plain or m.equal(input.ctrlOrSuper(.{})));
 }
 
-/// Surface.mouseModsWithCapture, for the cells' links: with
-/// `hotty-link-click = plain`, no modifier held is the link gesture (Ctrl,
-/// Cmd on macOS), so a plain click opens a URL or an OSC 8 hyperlink and the
-/// pointer over one underlines it, as in a browser. That holds while the
-/// program reports the mouse too (`cellLinkButton`): a hyperlink is the
-/// terminal's to open, and a modifier to open one is Ghostty's habit, not
-/// the program's request. A drag still selects, or reaches the program.
+/// Whether Surface looks for a link under the pointer with no modifier
+/// held, `hotty-link-click = plain`, while the program reports the mouse
+/// too. Only an OSC 8 hyperlink is found that way (`plainLinkOver`).
 pub fn plainLinkClick(s: *Surface, mods: input.Mods) bool {
     return s.config.hotty_link_click == .plain and mods.binding().equal(.{});
 }
 
+/// Surface.mouseModsWithCapture, for the cells' links: with
+/// `hotty-link-click = plain`, no modifier held over an OSC 8 hyperlink is
+/// the link gesture (Ctrl, Cmd on macOS), so a plain click opens it and the
+/// pointer over it underlines it, as in a browser. That holds while the
+/// program reports the mouse too (`cellLinkButton`): a hyperlink is the
+/// program's word that its text is a link, and the terminal's to open. A
+/// URL or a path that Ghostty's `link` patterns find is a guess, often
+/// wrong (a prompt's directory with the text after it, the first row of a
+/// URL a multiplexer drew row by row), so it keeps Ghostty's Ctrl. A drag
+/// still selects, or reaches the program. `mouse.link_point` is where the
+/// pointer was last looked at for links. Needs the renderer state's lock.
+pub fn plainLinkOver(s: *Surface, mods: input.Mods) bool {
+    if (!s.config.link_osc8 or !plainLinkClick(s, mods)) return false;
+    const vp = s.mouse.link_point orelse return false;
+    const screen: *terminal.Screen = s.renderer_state.terminal.screens.active;
+    const pin = screen.pages.pin(.{ .viewport = vp }) orelse return false;
+    return pin.rowAndCell().cell.hyperlink;
+}
+
