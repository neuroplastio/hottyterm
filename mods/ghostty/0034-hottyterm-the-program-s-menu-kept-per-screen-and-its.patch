+/// A paste command (SPEC §10.6) from the key `key`, or from a menu when it
+/// is empty: the clipboard is read first, and `commandPaste` sends it.
+fn pasteCommand(s: *Surface, key: []const u8) void {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const n = @min(key.len, hs.paste_key.len);
+        @memcpy(hs.paste_key[0..n], key[0..n]);
+        hs.paste_key_len = n;
+        hs.paste_pending = true;
+        hs.paste_abandoned = false;
+        hs.paste_since = std.Io.Timestamp.now(global.io(), .awake).nanoseconds;
+    }
+    const started = s.performBindingAction(.paste_from_clipboard) catch false;
+    // Nothing to read: the paste goes without text.
+    if (!started) _ = commandPaste(s, "");
+}
+
+/// The binding `toggle_hotty_palette` (SPEC §10.7): opens the palette of
+/// the program's menu over the screen, or closes it. False when the
+/// terminal has no HOTTY host to ask.
+pub fn togglePalette(s: *Surface) bool {
+    {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const hs = &s.io.terminal_stream.handler.hotty;
+        const h = hs.ensureHost(&s.io.terminal) orelse return false;
+        _ = hotty_host_palette(h, !hotty_host_palette_open(h));
+        if (hotty_host_has_dirty(h)) _ = hs.render(&s.io.terminal);
+    }
+    deliver(s, true);
+    return true;
+}
+
+/// Whether the key is the one `toggle_hotty_palette` is bound to.
+fn togglesPalette(s: *Surface, event: input.KeyEvent) bool {
+    const entry = s.config.keybind.set.getEvent(event) orelse return false;
+    const leaf: input.Binding.Set.GenericLeaf = switch (entry.value_ptr.*) {
+        .leader => return false,
+        inline .leaf, .leaf_chained => |v| v.generic(),
+    };
+    for (leaf.actionsSlice()) |a| if (a == .toggle_hotty_palette) return true;
+    return false;
+}
+
+/// A key while the palette is open (SPEC §10.7) goes to it, and to nothing
+/// else: not the program, the surfaces or the terminal's other bindings.
+/// Its own binding is the exception, and closes it. A pick goes to the
+/// program as the Edit menu's command does, with no key. True if the
+/// palette took the key.
+fn paletteKey(s: *Surface, event: input.KeyEvent) bool {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    var pick: ?[:0]u8 = null;
+    defer if (pick) |p| s.alloc.free(p);
+    {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const h = hs.host orelse return false;
+        if (!hotty_host_palette_open(h)) return false;
+        // Releases are swallowed, the press's of a key a surface took too.
+        if (event.action == .release) {
+            hs.held_keys.remove(event.key);
+            return true;
+        }
+        if (event.action == .press and togglesPalette(s, event)) return false;
+        var buf: [64]u8 = undefined;
+        const chord = pressedName(event, &buf);
+        const name = chord orelse if (std.mem.eql(u8, event.utf8, " ")) "Space" else "";
+        const text = if (chord == null) event.utf8 else "";
+        const picked = hotty_host_palette_key(h, name.ptr, name.len, text.ptr, text.len);
+        if (picked) |p| pick = s.alloc.dupeZ(u8, std.mem.span(p)) catch null;
+        if (hotty_host_has_dirty(h)) _ = hs.render(&s.io.terminal);
+    }
+    if (pick) |name| {
+        if (std.mem.eql(u8, name, "copy") and cellsSelect(s)) {
+            _ = s.performBindingAction(.{ .copy_to_clipboard = .default }) catch {};
+        } else if (std.mem.eql(u8, name, "paste")) {
+            pasteCommand(s, "");
+        } else {
+            s.renderer_state.mutex.lockUncancelable(global.io());
+            defer s.renderer_state.mutex.unlock(global.io());
+            const fx = hs.effects();
+            hotty_host_command(name.ptr, null, 0, null, 0, &fx);
+        }
+    }
+    deliver(s, true);
+    return true;
+}
