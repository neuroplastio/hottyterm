+/// The refresh rate of the display the terminal's window is on, in
+/// millihertz (0 when the platform cannot tell): CSS animations and fading
+/// scrollbars ask for frames at it. Kept before the lazy host exists, so
+/// that it starts with it.
+pub fn surfaceRefreshRate(s: *Surface, millihertz: u32) void {
+    lockState(s, @src());
+    defer s.renderer_state.mutex.unlock(global.io());
+    const hs = &s.io.terminal_stream.handler.hotty;
+    if (hs.refresh_mhz == millihertz) return;
+    log.info("display refresh rate {d} mHz", .{millihertz});
+    hs.refresh_mhz = millihertz;
+    if (hs.hostReady()) |h| {
+        hotty_host_set_refresh_rate(h, millihertz);
+        log.info("host refresh rate {d} mHz", .{millihertz});
+        // A frame due at the old rate is armed again at the new one.
+        hs.flush(&s.io.terminal);
+    }
+}
+
+/// GTK: what the rate is watched through. The widget's realize and
+/// unrealize (reparented, it is realized again with its window's
+/// GdkSurface), that
+/// surface's enter-monitor and leave-monitor, and the monitor's
+/// notify::refresh-rate (its mode changed). Opaque, so that this file
+/// builds where GTK is not.
+pub const GtkRate = struct {
+    widget: ?*anyopaque = null,
+    surface: ?*anyopaque = null,
+    enter_id: c_ulong = 0,
+    leave_id: c_ulong = 0,
+    monitor: ?*anyopaque = null,
+    rate_id: c_ulong = 0,
+};
+
+/// Watches the refresh rate of the display `widget`'s window is on, for the
+/// core surface it shows; connected for exactly as long as the core
+/// surface lives (`gtkUnwatchRate`).
+pub fn gtkWatchRate(s: *Surface, widget: anytype) void {
+    const gtk = @import("gtk");
+    const w: *gtk.Widget = widget;
+    const r = &s.io.terminal_stream.handler.hotty.gtk_rate;
+    r.widget = w;
+    // The widget's dispose disconnects these; its core surface outlives it.
+    _ = gtk.Widget.signals.realize.connect(w, *Surface, gtkRateRealized, s, .{});
+    _ = gtk.Widget.signals.unrealize.connect(w, *Surface, gtkRateUnrealized, s, .{});
+    if (w.getRealized() != 0) gtkRateRealized(w, s);
+}
+
+pub fn gtkUnwatchRate(s: *Surface) void {
+    const gtk = @import("gtk");
+    const r = &s.io.terminal_stream.handler.hotty.gtk_rate;
+    const widget: *gtk.Widget = @ptrCast(@alignCast(r.widget orelse return));
+    // The widget's own realize and unrealize handlers went with its
+    // dispose, before this finalize; the surface's and monitor's are on
+    // other objects, and go here.
+    gtkRateUnrealized(widget, s);
+    r.* = .{};
+}
+
+fn gtkRateRealized(widget: *@import("gtk").Widget, s: *Surface) callconv(.c) void {
+    const gdk = @import("gdk");
+    const gobject = @import("gobject");
+    const r = &s.io.terminal_stream.handler.hotty.gtk_rate;
+    const native = widget.getNative() orelse return;
+    const surface = native.getSurface() orelse return;
+    if (r.surface != null) gtkRateUnrealized(widget, s);
+    _ = surface.as(gobject.Object).ref();
+    r.surface = surface;
+    r.enter_id = gdk.Surface.signals.enter_monitor.connect(surface, *Surface, gtkRateEntered, s, .{});
+    r.leave_id = gdk.Surface.signals.leave_monitor.connect(surface, *Surface, gtkRateLeft, s, .{});
+    gtkRateMonitor(s, surface.getDisplay().getMonitorAtSurface(surface));
+}
+
+fn gtkRateUnrealized(_: *@import("gtk").Widget, s: *Surface) callconv(.c) void {
+    const gdk = @import("gdk");
+    const gobject = @import("gobject");
+    const r = &s.io.terminal_stream.handler.hotty.gtk_rate;
+    gtkRateMonitor(s, null);
+    const surface: *gdk.Surface = @ptrCast(@alignCast(r.surface orelse return));
+    gobject.signalHandlerDisconnect(surface.as(gobject.Object), r.enter_id);
+    gobject.signalHandlerDisconnect(surface.as(gobject.Object), r.leave_id);
+    surface.as(gobject.Object).unref();
+    r.surface = null;
+    r.enter_id = 0;
+    r.leave_id = 0;
+}
+
+/// The window entered a monitor: the last one entered is the one it is on,
+/// as a window dragged onto another display enters it before it leaves the
+/// one it came from.
+fn gtkRateEntered(_: *@import("gdk").Surface, monitor: *@import("gdk").Monitor, s: *Surface) callconv(.c) void {
+    gtkRateMonitor(s, monitor);
+}
+
+/// The window left a monitor: if it was the one it was on, it is on what
+/// the display says it is on now.
+fn gtkRateLeft(surface: *@import("gdk").Surface, monitor: *@import("gdk").Monitor, s: *Surface) callconv(.c) void {
+    const r = &s.io.terminal_stream.handler.hotty.gtk_rate;
+    if (r.monitor != @as(?*anyopaque, monitor)) return;
+    const now = surface.getDisplay().getMonitorAtSurface(surface);
+    gtkRateMonitor(s, if (now == monitor) null else now);
+}
+
+/// The window is on `monitor` (null: none it can tell): watch its mode,
+/// and pass its rate.
+fn gtkRateMonitor(s: *Surface, monitor: ?*@import("gdk").Monitor) void {
+    const gdk = @import("gdk");
+    const gobject = @import("gobject");
+    const r = &s.io.terminal_stream.handler.hotty.gtk_rate;
+    if (r.monitor != @as(?*anyopaque, monitor)) {
+        if (r.monitor) |p| {
+            const old: *gdk.Monitor = @ptrCast(@alignCast(p));
+            gobject.signalHandlerDisconnect(old.as(gobject.Object), r.rate_id);
+            old.as(gobject.Object).unref();
+            r.monitor = null;
+            r.rate_id = 0;
+        }
+        if (monitor) |m| {
+            _ = m.as(gobject.Object).ref();
+            r.monitor = m;
+            r.rate_id = gobject.Object.signals.notify.connect(m, *Surface, gtkRateChanged, s, .{ .detail = "refresh-rate" });
+        }
+    }
+    // On no monitor it can tell, the window keeps the rate it had.
+    if (monitor) |m| surfaceRefreshRate(s, @intCast(@max(m.getRefreshRate(), 0)));
+}
+
+fn gtkRateChanged(monitor: *@import("gdk").Monitor, _: *@import("gobject").ParamSpec, s: *Surface) callconv(.c) void {
+    surfaceRefreshRate(s, @intCast(@max(monitor.getRefreshRate(), 0)));
+}
+
 /// Surface.init and Surface.setFontSize: the size the terminal's font is
 /// loaded at, and the size in the settings, for the CSS px (`cssPx`). The
 /// resize that follows a change re-renders the surfaces with it.
