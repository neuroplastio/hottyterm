+        @objc private func hottyRefreshRateChanged() {
+            // With no screen, the last rate stays, as on GTK.
+            guard let surface, let screen = window?.screen else { return }
+            // The exact rate (59.94 Hz, not 60) where the screen gives it.
+            let interval = screen.minimumRefreshInterval
+            let mhz = interval > 0 ? 1000 / interval : Double(screen.maximumFramesPerSecond) * 1000
+            // No display runs past 1000 Hz; hotty-blitz clamps it further.
+            let rate = mhz.isFinite ? UInt32(min(max(mhz, 0), 1_000_000).rounded()) : 0
+            hottyterm_surface_set_refresh_rate(surface, rate)
+        }
