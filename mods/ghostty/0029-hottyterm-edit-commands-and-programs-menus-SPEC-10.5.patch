+    /// The which-key menu (SPEC §10.5, §10.6): hidden, its image goes;
+    /// shown anew, it is drawn again, and its frame places it.
+    fn applyMenu(self: *Hotty, t: *terminal.Terminal, h: *Host, ctx: *RenderCtx) void {
+        var i: usize = 0;
+        while (i < self.removes.items.len) {
+            const name = self.removes.items[i];
+            if (!std.mem.eql(u8, name, menu_name)) {
