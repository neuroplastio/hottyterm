-    if (!s.readonly and pressedName(event, &buf) != null and !reserved(s, event) and (holdsKeyboard(s) or surfaceSelects(s))) f.consumed = false;
+    const name = pressedName(event, &buf) orelse return f;
+    if (!s.readonly and !reserved(s, event) and (holdsKeyboard(s) or surfaceSelects(s) or takesCommand(s, name))) f.consumed = false;
     return f;
