+/// Whether a key is one of an edit command the program took (SPEC
+/// §10.6).
+fn takesCommand(s: *Surface, name: []const u8) bool {
+    s.renderer_state.mutex.lockUncancelable(global.io());
+    defer s.renderer_state.mutex.unlock(global.io());
+    const hs = &s.io.terminal_stream.handler.hotty;
+    const h = hs.host orelse return false;
+    const c = hotty_host_edit_command(h, name.ptr, name.len) orelse return false;
+    return hs.takes(&s.io.terminal, std.mem.span(c));
+}
+
 /// The key `event` is, named as SPEC §10.4 writes it, from the key itself,
 /// with the command key (Super) as Meta, if it types no text: a key that is
 /// not a character, or a character with Control or Meta. Null for the
