+/// A key of an edit command the program took (SPEC §10.6) reaches it as
+/// the event `command`, with its key, in place of its bytes, and so does
+/// each of its repeats; its release goes nowhere. A copy while the cells
+/// have a selection copies it instead, as the terminal's own copy does,
+/// and a paste reads the clipboard first (`commandPaste`). True if the key
+/// was one.
+fn editCommand(s: *Surface, event: input.KeyEvent, name: []const u8) bool {
+    const hs = &s.io.terminal_stream.handler.hotty;
+    const command = command: {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const h = hs.host orelse return false;
+        const c = hotty_host_edit_command(h, name.ptr, name.len) orelse return false;
+        if (!hs.takes(&s.io.terminal, std.mem.span(c))) return false;
+        hs.held_keys.insert(event.key);
+        break :command c;
+    };
+    if (std.mem.eql(u8, std.mem.span(command), "copy") and cellsSelect(s)) {
+        _ = s.performBindingAction(.{ .copy_to_clipboard = .default }) catch {};
+        return true;
+    }
+    if (std.mem.eql(u8, std.mem.span(command), "paste")) {
+        {
+            s.renderer_state.mutex.lockUncancelable(global.io());
+            defer s.renderer_state.mutex.unlock(global.io());
+            const n = @min(name.len, hs.paste_key.len);
+            @memcpy(hs.paste_key[0..n], name[0..n]);
+            hs.paste_key_len = n;
+            hs.paste_pending = true;
+        }
+        const started = s.performBindingAction(.paste_from_clipboard) catch false;
+        // Nothing to read: the paste goes without text.
+        if (!started) _ = commandPaste(s, "");
+        return true;
+    }
+    {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const fx = hs.effects();
+        hotty_host_command(command, name.ptr, name.len, null, 0, &fx);
+    }
+    deliver(s, false);
+    return true;
+}
+
+/// Surface.completeClipboardPaste: the clipboard a paste command waited
+/// for (SPEC §10.6) goes to the program with the command, as its text, and
+/// none when it holds none. False when no paste command waits.
+pub fn commandPaste(s: *Surface, data: []const u8) bool {
+    {
+        s.renderer_state.mutex.lockUncancelable(global.io());
+        defer s.renderer_state.mutex.unlock(global.io());
+        const hs = &s.io.terminal_stream.handler.hotty;
+        if (!hs.paste_pending) return false;
+        hs.paste_pending = false;
+        const fx = hs.effects();
+        const text: ?[*]const u8 = if (data.len > 0) data.ptr else null;
+        hotty_host_command("paste", &hs.paste_key, hs.paste_key_len, text, data.len, &fx);
+    }
+    deliver(s, false);
+    return true;
+}
+
+/// A key pressed while the cells have the keyboard and a menu shows: the
+/// program's hides on Escape and on a key it does not list (SPEC §10.6).
+/// The key goes on.
+fn cellsKey(s: *Surface, event: input.KeyEvent) void {
+    if (event.action == .release) return;
+    var buf: [64]u8 = undefined;
+    const name = pressedName(event, &buf) orelse
+        if (std.mem.eql(u8, event.utf8, " ")) "Space" else event.utf8;
+    if (name.len == 0) return;
+    s.renderer_state.mutex.lockUncancelable(global.io());
+    defer s.renderer_state.mutex.unlock(global.io());
+    const hs = &s.io.terminal_stream.handler.hotty;
+    if (!hs.menu_shown or hs.hasKeyboard()) return;
+    const h = hs.host orelse return;
+    hotty_host_cells_key(h, name.ptr, name.len);
+    if (hotty_host_has_dirty(h) and hs.render(&s.io.terminal)) hs.drew = true;
 }
 
