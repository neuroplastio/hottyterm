+
+test "Hotty.stackZ backdrops" {
+    const t = std.testing;
+    const below_bg = std.math.minInt(i32) / 2;
+    // A backdrop is under kitty's line for images below the backgrounds,
+    // at every z and creation; a placement without one is above the text.
+    for ([_]i32{ -1000, 0, 1000 }) |z| {
+        for ([_]u32{ 0, 1, 0x7FFFF, 0xFFFFF }) |c| {
+            try t.expect(Hotty.stackZ(z, c, true) < below_bg);
+            try t.expect(Hotty.stackZ(z, c, false) >= 0);
+        }
+    }
+    // Backdrops stack among themselves by z, then creation.
+    try t.expect(Hotty.stackZ(-1, 5, true) < Hotty.stackZ(0, 0, true));
+    try t.expect(Hotty.stackZ(0, 4, true) < Hotty.stackZ(0, 5, true));
+}
