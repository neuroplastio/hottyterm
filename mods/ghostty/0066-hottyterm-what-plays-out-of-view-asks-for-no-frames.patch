+    /// Tells the host which surfaces can be seen (`hotty_host_set_seen`):
+    /// placed on the screen that shows, on rows of the view, in a window
+    /// that is not hidden. What plays on the others asks for no frames, so
+    /// an animation scrolled away or minimised costs nothing. The caller
+    /// holds the lock and has the host.
+    fn see(self: *Hotty, t: *terminal.Terminal, h: *Host) void {
+        var it = self.placed.iterator();
+        while (it.next()) |e| {
+            const p = e.value_ptr;
+            if (p.hidden) continue;
+            const seen = inView(t, p.*);
+            if (seen == p.seen) continue;
+            p.seen = seen;
+            var buf: [73]u8 = undefined;
+            const z = std.mem.printSentinel(&buf, "{s}", .{e.key_ptr.*}, 0) catch continue;
+            hotty_host_set_seen(h, z.ptr, seen);
+        }
+    }
+
+    /// Whether placed surface `p` shows: its rows meet the view's.
+    fn inView(t: *terminal.Terminal, p: Placed) bool {
+        if (!t.flags.visible) return false;
+        if (p.screen != t.screens.active_key) return false;
+        const screen = t.screens.get(p.screen) orelse return true;
+        const placement = screen.kitty_images.placements.get(.{
+            .image_id = p.image_id,
+            .placement_id = .{ .tag = .external, .id = 1 },
+        }) orelse return true;
+        const pin = switch (placement.location) {
+            .pin => |pin| pin.*,
+            else => return true,
+        };
+        const pages = &screen.pages;
+        const here = pages.pointFromPin(.screen, pin) orelse return true;
+        const top = pages.pointFromPin(.screen, pages.getTopLeft(.viewport)) orelse return true;
+        const y: usize = here.screen.y;
+        const y0: usize = top.screen.y;
+        return y < y0 + pages.rows and y + p.win.h > y0;
+    }
+
+    /// On the renderer's thread, with the lock held, for each frame: when
+    /// the view has moved since the last (a scroll, output that pushed
+    /// lines up), the loop looks again at what is seen (`see`).
+    pub fn viewMoved(self: *Hotty, t: *terminal.Terminal) void {
+        const tl = t.screens.active.pages.getTopLeft(.viewport);
+        const view: View = .{ .node = @intFromPtr(tl.node), .y = tl.y, .screen = t.screens.active_key };
+        if (std.meta.eql(view, self.last_view)) return;
+        self.last_view = view;
+        if (self.placed.count() == 0) return;
+        if (self.wakeup) |*w| w.notify() catch {};
+    }
+
+    /// The window was hidden or shown (the terminal's `visible` flag, set
+    /// with the lock held): the loop looks again at what is seen.
+    pub fn visibilityChanged(self: *Hotty) void {
+        if (self.wakeup) |*w| w.notify() catch {};
+    }
+
+    const View = struct { node: usize = 0, y: usize = 0, screen: terminal.ScreenSet.Key = .primary };
+
     /// What a surface fetched arrived: draw it, and tell the program what
     /// drawing it changed (`fit`), as the timer does.
     fn onWake(
@@ -1836,6 +1904,7 @@ pub const Hotty = struct {
         const h = self.hostReady() orelse return;
         const loop = self.loop orelse return;
         const timer = self.timer orelse return;
+        self.see(t, h);
         var ms = hotty_host_next_frame(h);
         if (ms < 0) return; // nothing plays: a timer set before finds nothing and stops
         if (self.loop_thread != std.Thread.getCurrentId()) {
@@ -2671,8 +2740,11 @@ pub const Hotty = struct {
     }
 
     fn place(self: *Hotty, t: *terminal.Terminal, name: []const u8, p: Place, w: u32, h: u32, data: []const u8) !void {
-        // One image per placement: a surface placed again moves.
+        // One image per placement: a surface placed again moves. What the
+        // host heard of it stays, for `see` to change.
+        var seen = true;
         if (self.placed.fetchRemove(name)) |kv| {
+            seen = kv.value.seen;
             self.deleteImage(t, kv.value);
             self.alloc.free(kv.key);
         }
@@ -2705,6 +2777,7 @@ pub const Hotty = struct {
             .created = p.created,
             .backdrop = p.backdrop,
             .screen = t.screens.active_key,
+            .seen = seen,
         };
         try self.placed.put(self.alloc, owned, entry);
         keepImage(t, entry);
