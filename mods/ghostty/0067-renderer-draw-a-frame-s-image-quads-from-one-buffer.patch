 6 files changed, 162 insertions(+), 94 deletions(-)

diff --git a/pkg/opengl/draw.zig b/pkg/opengl/draw.zig
index 40e718fb4..df0298b36 100644
--- a/pkg/opengl/draw.zig
+++ b/pkg/opengl/draw.zig
@@ -33,6 +33,23 @@ pub fn drawArraysInstanced(
     try errors.getError();
 }
 
+pub fn drawArraysInstancedBaseInstance(
+    mode: Primitive,
+    first: c.GLint,
+    count: c.GLsizei,
+    primcount: c.GLsizei,
+    base_instance: c.GLuint,
+) !void {
+    glad.context.DrawArraysInstancedBaseInstance.?(
+        @intCast(@backingInt(mode)),
+        first,
+        count,
+        primcount,
+        base_instance,
+    );
+    try errors.getError();
+}
+
 pub fn drawElements(mode: c.GLenum, count: c.GLsizei, typ: c.GLenum, offset: usize) !void {
     const offsetPtr = if (offset == 0) null else @as(*const anyopaque, @ptrFromInt(offset));
     glad.context.DrawElements.?(mode, count, typ, offsetPtr);
