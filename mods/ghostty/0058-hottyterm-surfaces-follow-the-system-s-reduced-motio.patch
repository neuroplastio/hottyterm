+/// The platform's watched preference (SPEC §8, HOST §4). Keep it before
+/// the lazy host exists too; changing it repaints even an idle surface.
+pub fn surfaceReducedMotion(s: *Surface, reduce: bool) void {
+    lockState(s, @src());
+    defer s.renderer_state.mutex.unlock(global.io());
+    const hs = &s.io.terminal_stream.handler.hotty;
+    if (hs.reduced_motion == reduce) return;
+    hs.reduced_motion = reduce;
+    if (hs.hostReady()) |h| {
+        hotty_host_set_reduced_motion(h, reduce);
+        hs.flush(&s.io.terminal);
+    }
+}
+
+/// GTK owns its settings; the connection lasts exactly as long as the core
+/// surface, and is disconnected before its terminal and host are freed.
+pub fn gtkWatchMotion(s: *Surface) void {
+    const gtk = @import("gtk");
+    const gobject = @import("gobject");
+    const settings = gtk.Settings.getDefault() orelse return;
+    s.io.terminal_stream.handler.hotty.gtk_motion_notify = gobject.Object.signals.notify.connect(
+        settings,
+        *Surface,
+        gtkMotionChanged,
+        s,
+        .{ .detail = "gtk-enable-animations" },
+    );
+    gtkMotionChanged(settings, undefined, s);
+}
+
+pub fn gtkUnwatchMotion(s: *Surface) void {
+    const gtk = @import("gtk");
+    const gobject = @import("gobject");
+    const hs = &s.io.terminal_stream.handler.hotty;
+    if (hs.gtk_motion_notify == 0) return;
+    if (gtk.Settings.getDefault()) |settings|
+        gobject.signalHandlerDisconnect(settings.as(gobject.Object), hs.gtk_motion_notify);
+    hs.gtk_motion_notify = 0;
+}
+
+fn gtkMotionChanged(settings: *@import("gtk").Settings, _: *@import("gobject").ParamSpec, s: *Surface) callconv(.c) void {
+    const gobject = @import("gobject");
+    var value = gobject.ext.Value.new(bool);
+    defer value.unset();
+    settings.as(gobject.Object).getProperty("gtk-enable-animations", &value);
+    surfaceReducedMotion(s, value.getBoolean() == 0);
+}
